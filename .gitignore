node_modules/
dist/
coverage/
*.db
*.db-shm
*.db-wal
*.sqlite
.env
.DS_Store
.review-cache/
.superpowers/
.worktrees/
.claude/worktrees/

# dotnet test output; xUnit's CTRF reports are named <user>_<host>_<time>.ctrf and carry the OS user
TestResults/
*.ctrf

# Serena runtime data (LSP index caches, logs, session state)
.serena/cache/
.serena/logs/
.serena/memory/
.serena/memories/
.serena/*.log

# Claude Code machine-specific settings (absolute paths, allow rules)
.claude/settings.local.json

# Claude Code lays the function-hooks API types into a mod it loads
mods/*/.claude-plugin/types/
mods/*/tsconfig.json

# sindri sandbox smoke test probe dirs (removed by the test; left only by a killed run)
sindri/.sandbox-probe-*/

# .NET build output (Directory.Build.props UseArtifactsOutput)
artifacts/
# dotnet test --report-* and --results-directory output (local runs and CI)
TestResults/

# impeccable critique snapshots (local)
.impeccable/

# Skill evals (scripts/skill-evals.sh): results stay on the box, never committed
evals/results/
evals/**/.aw-state/
