<Project Sdk="Microsoft.NET.Sdk">
  <!-- #3335 terminal control spike (Agents live pane). Throwaway: branch spike/3335-terminal, never merged. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AwAotEntryPoint>true</AwAotEntryPoint>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <AssemblyName>spike-t3335</AssemblyName>
    <RootNamespace>Aw.Spike.T3335</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Devolutions.Terminal.Control" />
  </ItemGroup>
</Project>
