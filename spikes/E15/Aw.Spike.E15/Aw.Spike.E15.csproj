<Project Sdk="Microsoft.NET.Sdk">
  <!-- E15 editor control spike (issue 3248). Throwaway: branch spike/e15, never merged. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AwAotEntryPoint>true</AwAotEntryPoint>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <AssemblyName>spike-e15</AssemblyName>
    <RootNamespace>Aw.Spike.E15</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Markdig" />
  </ItemGroup>
</Project>
