{
  "team": "sindri",
  "repo": "/absolute/path/to/agentic-workflow",
  "prompts": "/absolute/path/to/handoff/prompts",
  "metaLane": "meta",
  "lanes": ["api", "engine", "context", "ui"],
  "log": "/absolute/path/to/digests/sindri-merge-orchestrator.md",
  "gate": {
    "always": ["repo"],
    "docsOnly": ["**/*.md", "docs/**", "planning/**"],
    "scopes": {
      "repo": {
        "paths": ["**"],
        "steps": [
          { "name": "sync-rules", "run": ["bash", "-c", "LC_ALL=C scripts/sync-rules.sh --check"], "heavy": false },
          { "name": "check-deps", "run": ["node", "scripts/check-deps.mjs"], "heavy": false },
          { "name": "check-rules", "run": ["node", "scripts/check-rules.mjs"], "heavy": false },
          { "name": "env-example", "run": ["scripts/check-env-example.sh"], "heavy": false }
        ]
      },
      "dotnet": {
        "paths": ["src/**", "tests/**", "*.props", "*.targets", "*.slnx", "global.json", "nuget.config", ".editorconfig", "BannedSymbols*.txt", "CodeMetricsConfig.txt"],
        "steps": [
          { "name": "build", "run": ["dotnet", "build", "AgenticWorkflow.slnx", "-warnaserror", "-v", "q"], "heavy": true },
          { "name": "unit", "run": ["dotnet", "test", "--solution", "AgenticWorkflow.slnx", "--no-build", "--filter-trait", "Lane=unit", "--ignore-exit-code", "8"], "heavy": true },
          { "name": "integration", "run": ["dotnet", "test", "--solution", "AgenticWorkflow.slnx", "--no-build", "--filter-trait", "Lane=integration", "--ignore-exit-code", "8"], "heavy": true },
          { "name": "format", "run": ["dotnet", "format", "AgenticWorkflow.slnx", "--verify-no-changes", "-v", "q"], "heavy": true },
          { "name": "verify-packages", "run": ["scripts/dotnet-verify-packages.sh"], "heavy": false, "after": ["build"] }
        ]
      },
      "aot-smoke": {
        "paths": ["src/Sindri/**"],
        "steps": [ { "name": "aot-smoke", "run": ["bash", "src/Sindri/aot-smoke/run.sh"], "heavy": true } ]
      },
      "bash-lib": {
        "paths": ["config/**"],
        "steps": [ { "name": "bash-lib", "run": ["bash", "-c", "r=0; for t in config/lib/tests/*.test.sh config/hooks/tests/*.test.sh; do bash \"$t\" >/dev/null 2>&1 || { echo \"FAILED $t\"; r=1; }; done; exit $r"], "heavy": true } ]
      },
      "bash-scripts": {
        "paths": ["scripts/**", "providers/**", "setup.sh"],
        "steps": [ { "name": "bash-scripts", "run": ["bash", "scripts/ci/bash-tests.sh"], "heavy": true } ]
      }
    }
  },
  "resources": { "diskFloorGb": 30, "memFloorGb": 8 },
  "context": { "recycleAt": 300000 },
  "builders": { "maxPerLane": 4, "worktreeGb": 4 },
  "heavy": { "cap": 3, "reserve": [ { "minDepth": 3, "slots": 1 }, { "minDepth": 5, "slots": 2 }, { "minDepth": 7, "slots": "all" } ] },
  "mergeOrder": [
    { "before": 190, "after": 192 },
    { "before": 192, "after": 209 },
    { "before": 193, "after": 197 }
  ],
  "knownFlakes": [
    "aw-state-dir-isolation",
    "StackProbeTests",
    "SpikeEvalTests",
    "HttpControlPlaneProbeContractTests",
    "ApiProblemTests",
    "CliStatusJsonTests",
    "RecipeRegistryCliTests",
    "RecipeApproveCliTests"
  ]
}
