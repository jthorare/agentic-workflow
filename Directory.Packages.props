<Project>
  <!-- Central Package Management (agent-readiness spec §4b.6, §4d). Each version we choose lives here, is pinned
       exactly ([x.y.z]; a bare version means "x.y.z or newer"), and is at least 14 days old when pinned (the repo's
       existing pin policy). Packages the SDK adds implicitly (Microsoft.NET.ILLink.Tasks, from IsAotCompatible)
       carry an open range and are pinned only by packages.lock.json. Analyzers run code in every build, so they get
       the same review as runtime dependencies. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Analyzers in every project. Severities and the one owner per overlapping rule: .editorconfig. -->
  <ItemGroup Label="Analyzers">
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="[10.0.401]" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="[3.0.290]" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="[5.0.0]" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="[5.6.0]" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="[5.6.0]" />
  </ItemGroup>

  <ItemGroup Label="Packages">
    <!-- Tests. xunit.v3 4.0.1 published 2026-09-12. -->
    <PackageVersion Include="xunit.v3" Version="[4.0.1]" />
    <!-- Aw.Kernel.Testing's one external dependency; the same exact version xunit.v3 4.0.1 pins. Published 2026-09-12. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="[4.0.1]" />
    <!-- FakeTimeProvider for test projects (spec §4b.4, §4b.5). 10.10.0 published 2026-09-09. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="[10.10.0]" />
    <!-- Dependency injection for the package scaffolds (spec §4b.4, docs/csharp/scaffolds/new-package.md "package pins"):
         Abstractions in Core, Features and Infrastructure (their Add…() methods), the container in each Host and in
         the DI validation tests. 10.0.12 published 2026-09-08. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.12]" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="[10.0.12]" />
    <!-- An http Host's test project (spec §4b.5): brings the ASP.NET framework the scaffolded loopback and id route-binding
         tests run the real host on, and WebApplicationFactory for hand-written endpoint tests. 10.0.12 published 2026-09-08. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="[10.0.12]" />
    <!-- Data (Aw.Kernel.Data, decision R8). Microsoft.Data.Sqlite 10.0.12 published 2026-09-08; it bundles e_sqlite3,
         which ships as a libe_sqlite3 file beside each AOT tool (docs/csharp/kernel-data.md). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="[10.0.12]" />
    <!-- Typed ids (decision R9, docs/csharp/typed-ids.md). Vogen 8.0.7 published 2026-07-21. -->
    <PackageVersion Include="Vogen" Version="[8.0.7]" />
    <!-- YAML (the Sindri profile, owner 2026-10-11; later S2 recipes): only the parser and representation model are used,
         which are reflection-free, so NativeAOT stays clean. The tree is turned into JSON and read through AwJson.
         YamlDotNet 18.1.0 published 2026-06-26, MIT. -->
    <PackageVersion Include="YamlDotNet" Version="[18.1.0]" />
    <!-- Aw.Analyzers (spec §4b.6) and its tests: the compiler API the in-repo rules are written against. 5.0.0
         (published 2025-11-18) is the Roslyn of the .NET 10.0.100 SDK: an analyzer must not reference a newer
         compiler than the one that loads it, and every pinned SDK from 10.0.100 on carries 5.0 or later. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[5.9.0]" />
    <!-- Telemetry (Aw.Kernel.Telemetry's one external dependency, spec §4b.1): spans, metrics and the processor and
         exporter seams. OpenTelemetry 1.19.1 published 2026-09-21. It brings Microsoft.Extensions.Logging,
         .Configuration (with the EnvironmentVariables provider), .Options and .DependencyInjection transitively (pinned
         by the lock files; nothing may use IConfiguration). No exporter package: exporting is off by default and an
         exporter is an adapter the host opts into (docs/csharp/telemetry.md). -->
    <PackageVersion Include="OpenTelemetry" Version="[1.19.1]" />
    <!-- Architecture tests (spec §4b.5: ArchUnitNET, maintained; NetArchTest's last release was 2023). The core
         package only: the xUnit adapter pulls System.Net.Http 4.3.4. 0.13.4 published 2026-08-20. -->
    <PackageVersion Include="TngTech.ArchUnitNET" Version="[0.13.4]" />
    <!-- Logging from an Infrastructure adapter (Aw.Evidence.Infrastructure's UnavailableJudge): ILogger and
         [LoggerMessage] only; the host's Aw.Kernel.Telemetry brings the implementation. Pinned at 10.0.12 (published
         2026-09-08), the DI pins' version: Microsoft.AspNetCore.Mvc.Testing 10.0.12 (the Sindri http tests) needs at
         least that through Microsoft.Extensions.Hosting, and transitive pinning makes a lower pin a downgrade (NU1109). -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.0.12]" />
    <!-- Browser automation for Evidence (ui-evidence; spec §4b.6 AOT scope: framework-dependent, because Playwright for
         .NET has no NativeAOT or trimming support). Only Aw.Evidence.Infrastructure references it. 1.63.0 published
         2026-09-23; its browsers are installed by `ui-evidence install-browser`, never at build time. -->
    <PackageVersion Include="Microsoft.Playwright" Version="[1.63.0]" />
  </ItemGroup>
</Project>
