<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Forge.Host (scaffolded by /new-package): the composition root and the CLI commands
       (one per slice). NativeAOT entry point 'aw-forge-fake' (spec §4b.6); the only project that uses Infrastructure, in
       Composition. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AwAotEntryPoint>true</AwAotEntryPoint>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <AssemblyName>aw-forge-fake</AssemblyName>
    <RootNamespace>Aw.Forge.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Forge.Core/Aw.Forge.Core.csproj" />
    <ProjectReference Include="../Aw.Forge.Infrastructure/Aw.Forge.Infrastructure.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../Aw.Kernel.Telemetry/Aw.Kernel.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Forge.Tests" />
  </ItemGroup>
</Project>
