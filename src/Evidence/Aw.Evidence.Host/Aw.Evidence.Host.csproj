<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Evidence.Host (scaffolded by /new-package): the composition root and the CLI commands
       (one per slice). Framework-dependent entry point 'ui-evidence' (spec §4b.6 AOT scope): Playwright for .NET has no
       NativeAOT or trimming support, so this host is not an AwAotEntryPoint and never sets PublishAot. The only
       project that uses Infrastructure, in Composition. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ui-evidence</AssemblyName>
    <RootNamespace>Aw.Evidence.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Evidence.Core/Aw.Evidence.Core.csproj" />
    <ProjectReference Include="../Aw.Evidence.Features/Aw.Evidence.Features.csproj" />
    <ProjectReference Include="../Aw.Evidence.Infrastructure/Aw.Evidence.Infrastructure.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../Aw.Kernel.Telemetry/Aw.Kernel.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(AwBuildTime)' != ''">
    <!-- The install (scripts/install-cs.sh) publishes with -p:AwBuildTime=<UTC ISO 8601> -p:SourceRevisionId=<commit>; `ui-evidence version` reads both back. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AwBuildTime</_Parameter1>
      <_Parameter2>$(AwBuildTime)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Evidence.Tests" />
  </ItemGroup>
</Project>
