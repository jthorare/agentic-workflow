<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Evidence.Infrastructure (scaffolded by /new-package): the adapters behind Core's ports (SQL repositories,
       processes, HTTP, files) and this package's settings, read from the environment Composition passes (spec §4b.1,
       .agents/rules/csharp.md Seams). Its row and DTO types stay internal (ARCH-INFRA-001). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Evidence.Infrastructure</RootNamespace>
    <!-- DirectoryLocks calls the C library's mkdir through [LibraryImport], whose generated marshalling is unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Not AOT-compatible: Microsoft.Playwright (PlaywrightBrowser) has no NativeAOT or trimming support, so Evidence
         ships framework-dependent (spec §4b.6 AOT scope). -->
    <AwAotCompatible>false</AwAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Evidence.Core/Aw.Evidence.Core.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../Aw.Kernel.Data/Aw.Kernel.Data.csproj" />
    <ProjectReference Include="../../Redaction/Aw.Redaction/Aw.Redaction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page scripts PlaywrightBrowser evaluates (PageScripts reads them by manifest name). -->
    <EmbeddedResource Include="Browser/Scripts/*.js" LogicalName="Aw.Evidence.Infrastructure.Browser.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Evidence.Tests" />
    <InternalsVisibleTo Include="Aw.Evidence.Testing" />
  </ItemGroup>
</Project>
