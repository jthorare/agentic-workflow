<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Aw.Sindri.Host (scaffolded by /new-package): the composition root and the minimal API endpoints
       (one per slice). Framework-dependent entry point 'sindri' (.agents/rules/csharp.md "AOT scope"; owner,
       2026-10-11, README X54): it hosts the Temporal worker through Aw.Sindri.Workflows, and the Temporal .NET SDK has
       no trimming or NativeAOT support (temporalio/sdk-dotnet#286), so this host is not an AwAotEntryPoint and never
       sets PublishAot. The only project that uses Infrastructure, in Composition. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Kept from the NativeAOT days on purpose: the host's code uses the invariant culture and ordinal comparisons
         throughout, and invariant globalization keeps the published host free of an ICU dependency on Linux. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The trim, AOT and single-file analyzers stay on (they add no package): nothing here publishes trimmed, but the
         host's own code stays free of reflection-only patterns, so going back to NativeAOT once the SDK supports it is
         a project-file change. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <AssemblyName>sindri</AssemblyName>
    <RootNamespace>Aw.Sindri.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Sindri.Core/Aw.Sindri.Core.csproj" />
    <ProjectReference Include="../Aw.Sindri.Features/Aw.Sindri.Features.csproj" />
    <ProjectReference Include="../Aw.Sindri.Infrastructure/Aw.Sindri.Infrastructure.csproj" />
    <ProjectReference Include="../../Context/Aw.Context.Core/Aw.Context.Core.csproj" />
    <ProjectReference Include="../../CodeIndex/Aw.CodeIndex.Core/Aw.CodeIndex.Core.csproj" />
    <!-- compose edge (deps.yaml): only AddContextFeatures and AddContextInfrastructure, in Composition (ARCH-COMPOSE-001) -->
    <ProjectReference Include="../../Context/Aw.Context.Features/Aw.Context.Features.csproj" />
    <ProjectReference Include="../../Context/Aw.Context.Infrastructure/Aw.Context.Infrastructure.csproj" />
    <!-- the labeler's model port (Host/Models): Sindri adapts Judge's provider catalog; compose edge in deps.yaml -->
    <ProjectReference Include="../../Judge/Aw.Judge.Core/Aw.Judge.Core.csproj" />
    <ProjectReference Include="../../Judge/Aw.Judge.Infrastructure/Aw.Judge.Infrastructure.csproj" />
    <!-- Sindri's pull-request port over the forge (Host/Forge): Core is used for the ports; the compose edge in deps.yaml covers the file and GitHub adapters -->
    <ProjectReference Include="../../Forge/Aw.Forge.Core/Aw.Forge.Core.csproj" />
    <ProjectReference Include="../../Forge/Aw.Forge.Infrastructure/Aw.Forge.Infrastructure.csproj" />
    <ProjectReference Include="../Aw.Sindri.Workflows/Aw.Sindri.Workflows.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../Aw.Kernel.Telemetry/Aw.Kernel.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- /sindri/mcp (Host/Mcp): context spec §8.5, API spec §8 -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <!-- The shipped recipes (setup-once spec §5.3): every file of the directory AwRecipesDir names is embedded as
       aw-recipes/sindri/<path relative to it>, '/' separated, README.md excluded. scripts/sindri-app.sh stages `git archive
       HEAD recipes/sindri` into its build copy and passes that directory; an ordinary build leaves AwRecipesDir empty and
       embeds nothing (an empty set is legal). The reader is the engine's IEmbeddedRecipes. -->
  <ItemGroup Condition="'$(AwRecipesDir)' != '' And Exists('$(AwRecipesDir)')">
    <EmbeddedResource Include="$(AwRecipesDir)/**/*" Exclude="$(AwRecipesDir)/README.md"
                      LogicalName="aw-recipes/sindri/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Sindri.Tests" />
    <InternalsVisibleTo Include="Aw.Sindri.Engine.Tests" />
  </ItemGroup>
</Project>
