<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Sindri.Ui (readiness spec §4a "UI", .agents/rules/csharp.md "The UI package"): the Avalonia views, their view
       models, the typed client of Sindri's HTTP API and the ports for platform services. It references no Sindri
       project: its edges to Sindri are the HTTP API (the routes are the http edge in deps.yaml; docs/csharp/
       sindri.md), the endpoint record control.json it finds the API by, and auth/human.token, the per-start human
       token it sends. Each platform head (Aw.Sindri.Ui.Desktop) adds Main, composition and one adapter per port. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Sindri.Ui</RootNamespace>
    <!-- Compiled bindings only: every view and template has an x:DataType, and nothing uses ReflectionBinding, so the
         app stays trim- and AOT-safe. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- ILogger and [LoggerMessage]: the app reports a failed start-up through the logger the head passes in
         SindriPlatform.Log (the desktop head's is Aw.Kernel.Telemetry's). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- JetBrains Mono (OFL 1.1, Theme/Fonts/OFL.txt), embedded for Theme/Tokens.axaml's Font.Mono. -->
    <AvaloniaResource Include="Theme/Fonts/*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Sindri.Ui.Tests" />
    <InternalsVisibleTo Include="Aw.Sindri.Ui.Rendering.Tests" />
    <InternalsVisibleTo Include="Aw.Sindri.Ui.Frames.Tests" />
    <InternalsVisibleTo Include="Aw.Sindri.Ui.Controls.Tests" />
    <InternalsVisibleTo Include="Aw.Sindri.Ui.Testing" />
  </ItemGroup>
</Project>
