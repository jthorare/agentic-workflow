<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The app's icons (UI spec §11.3, R1): the state glyphs and the shell's marks as vector geometries on a 16 × 16 grid,
       drawn by Views/StateIcon with a 1.5 px round stroke (the brand ◆ filled), so they render at the same size and
       weight on every OS instead of falling back to another font. Each icon sits beside its word: a state is never shown
       by colour or shape alone. Colours come from the Brush.* tokens through the icon's styles. -->

  <!-- The icon box: the Body line (16 px at text scale 1); TextScale.Apply scales it with the type ramp. -->
  <x:Double x:Key="Size.Icon">16</x:Double>
  <!-- The "." keycap's dot (R6): 4.5 px at text scale 1, scaled with the type ramp. -->
  <x:Double x:Key="Size.KeyDot">4.5</x:Double>

  <!-- ✓ ok -->
  <StreamGeometry x:Key="Icon.Ok">M3,8.5 L6.5,12 L13,4.5</StreamGeometry>
  <!-- ✕ failure (and the sheet's Close) -->
  <StreamGeometry x:Key="Icon.Down">M4,4 L12,12 M12,4 L4,12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Close">M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5</StreamGeometry>
  <!-- ⌛ stale: an hourglass -->
  <StreamGeometry x:Key="Icon.Stale">M4,2 L12,2 M4,14 L12,14 M5,2 L5,4.5 L8,8 L11,4.5 L11,2 M5,14 L5,11.5 L8,8 L11,11.5 L11,14</StreamGeometry>
  <!-- ◇ a profile to look at -->
  <StreamGeometry x:Key="Icon.Profile">M8,2 L14,8 L8,14 L2,8 Z</StreamGeometry>
  <!-- △ a warning: a triangle with its stroke and dot -->
  <StreamGeometry x:Key="Icon.Warning">M8,2 L14.5,13.5 L1.5,13.5 Z M8,6.5 L8,9.5 M8,11.5 L8,11.6</StreamGeometry>
  <!-- ◆ the brand mark (filled) -->
  <StreamGeometry x:Key="Icon.Brand">M8,1.5 L14.5,8 L8,14.5 L1.5,8 Z</StreamGeometry>
  <!-- ⟳ refresh: a clockwise arc with its arrowhead -->
  <StreamGeometry x:Key="Icon.Refresh">M13,8 A5,5 0 1 1 11.5,4.5 M11.5,1.5 L11.5,4.5 L8.5,4.5</StreamGeometry>
  <!-- In flight (§4.1 "sending"): a three-quarter arc that turns, still under reduced motion -->
  <StreamGeometry x:Key="Icon.Spinner">M8,2 A6,6 0 1 1 2,8</StreamGeometry>
  <!-- ⌘ the command key -->
  <StreamGeometry x:Key="Icon.Command">M6,6 L10,6 L10,10 L6,10 Z M6,6 L6,4 A2,2 0 1 0 4,6 L6,6 M10,6 L12,6 A2,2 0 1 0 10,4 L10,6 M10,10 L10,12 A2,2 0 1 0 12,10 L10,10 M6,10 L4,10 A2,2 0 1 0 6,12 L6,10</StreamGeometry>
  <!-- The context map's marks (F3 spec 1 §2): one per kind of node, on the same 16 grid, and the zoom pill's and the summary card's. -->
  <StreamGeometry x:Key="Icon.Kind.Feature">M8,2 L14,5.5 L8,9 L2,5.5 Z M2,8.5 L8,12 L14,8.5 M2,11 L8,14.5 L14,11</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Screen">M2.5,3 L13.5,3 L13.5,11 L2.5,11 Z M6,14 L10,14 M8,11 L8,14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Route">M2,8 A6,6 0 1 0 14,8 A6,6 0 1 0 2,8 M2,8 L14,8 M8,2 C5.5,5 5.5,11 8,14 M8,2 C10.5,5 10.5,11 8,14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Dialog">M2.5,3 L13.5,3 L13.5,11 L6,11 L3,14 L3,11 L2.5,11 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Email">M2,4 L14,4 L14,12 L2,12 Z M2,4.5 L8,9 L14,4.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Action">M9,2 L3.5,9 L8,9 L7,14 L12.5,7 L8,7 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Data">M3,4 A5,1.8 0 1 0 13,4 A5,1.8 0 1 0 3,4 M3,4 L3,12 A5,1.8 0 0 0 13,12 L13,4 M3,8 A5,1.8 0 0 0 13,8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.File">M4,2 L9.5,2 L12.5,5 L12.5,14 L4,14 Z M9.5,2 L9.5,5 L12.5,5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Test">M6,2 L10,2 M6.5,2 L6.5,7 L3,13.5 L13,13.5 L9.5,7 L9.5,2 M5,10.5 L11,10.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Ticket">M2,5 L14,5 L14,7 A1.2,1.2 0 0 0 14,9 L14,11 L2,11 L2,9 A1.2,1.2 0 0 0 2,7 Z M9,5 L9,11</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Decision">M8,2.5 L8,13.5 M4,5 L12,5 M4,5 L2.5,9 A1.7,1.2 0 0 0 5.5,9 Z M12,5 L10.5,9 A1.7,1.2 0 0 0 13.5,9 Z M5,13.5 L11,13.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Dot">M8,6.5 A1.5,1.5 0 1 0 8,9.5 A1.5,1.5 0 1 0 8,6.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Warn">M8,2.5 L14,13 L2,13 Z M8,6.5 L8,9.5 M8,11.3 L8,11.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Chevron">M4,6 L8,10 L12,6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Plus">M8,3.5 L8,12.5 M3.5,8 L12.5,8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Minus">M3.5,8 L12.5,8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Kind.Fit">M2.5,6 L2.5,2.5 L6,2.5 M10,2.5 L13.5,2.5 L13.5,6 M13.5,10 L13.5,13.5 L10,13.5 M6,13.5 L2.5,13.5 L2.5,10</StreamGeometry>

  <!-- The run status glyphs (F3 workflows spec §2): clock, person, pause, circle with a cross, circle with a bar, dashed circle -->
  <StreamGeometry x:Key="Icon.RunClock">M8,2 A6,6 0 1 1 7.99,2 M8,4.5 L8,8 L10.5,9.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.RunPerson">M8,3 A2.5,2.5 0 1 1 7.99,3 M3,13.5 C3,10.5 5,9.5 8,9.5 C11,9.5 13,10.5 13,13.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.RunPause">M8,2 A6,6 0 1 1 7.99,2 M6.5,5.5 L6.5,10.5 M9.5,5.5 L9.5,10.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.RunCircleX">M8,2 A6,6 0 1 1 7.99,2 M5.8,5.8 L10.2,10.2 M10.2,5.8 L5.8,10.2</StreamGeometry>
  <StreamGeometry x:Key="Icon.RunCircleMinus">M8,2 A6,6 0 1 1 7.99,2 M5.5,8 L10.5,8</StreamGeometry>
  <StreamGeometry x:Key="Icon.RunCircleDashed">M8,2 A6,6 0 0 1 11.2,2.9 M12.9,4.8 A6,6 0 0 1 14,8 M13.1,10.2 A6,6 0 0 1 11.2,13.1 M9.2,13.8 A6,6 0 0 1 5.5,13.5 M3.5,12 A6,6 0 0 1 2,8 M2.9,5.8 A6,6 0 0 1 5.2,2.9</StreamGeometry>
</ResourceDictionary>
