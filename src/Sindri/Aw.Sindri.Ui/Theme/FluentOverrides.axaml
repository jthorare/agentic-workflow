<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The Fluent theme mapped to the tokens (UI spec §14.4), so stock controls (TextBox, ComboBox, menus, scroll bars)
       match without restyling each one. Fluent reads a palette's colours once at start-up, and these resources are looked
       up before the theme's own, so the values are written here; the theme tests hold every one equal to its token in
       Tokens.axaml. No shadows anywhere: nothing here sets BoxShadow. -->
  <Styles.Resources>
    <!-- Buttons: secondary is Surface1 with a Hairline border; the accent (primary) hover darkens (§11.1: white on
         PrimaryHover is 2.87:1, on PrimaryHoverFill 5.5:1). -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#0f1011" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#23252a" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#f7f8f8" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#141516" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#34343a" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#f7f8f8" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#18191a" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#f7f8f8" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#62666d" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#5e6ad2" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#535fc6" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#4c57be" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#ffffff" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#ffffff" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#ffffff" />
    <!-- Combo boxes: Fluent fills a focused one from the palette accent (solid purple); it keeps the Surface1 face and Ink text, and the
         focus ring is the cue. -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#0f1011" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#141516" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#18191a" />
    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#0f1011" />
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#34343a" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#f7f8f8" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#f7f8f8" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="#d0d6e0" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#f7f8f8" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#f7f8f8" />
    <!-- Buttons and inputs: Radius.MD. -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <!-- Tooltips on Surface3. -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="#18191a" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#23252a" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#f7f8f8" />
  </Styles.Resources>

  <FluentTheme>
    <FluentTheme.Palettes>
      <ColorPaletteResources x:Key="Dark"
                             Accent="#5e6ad2"
                             RegionColor="#010102"
                             AltHigh="#010102" AltMedium="#0f1011" AltLow="#141516"
                             BaseHigh="#f7f8f8" BaseMediumHigh="#d0d6e0" BaseMedium="#8a8f98" BaseLow="#23252a"
                             ChromeHigh="#3e3e44" ChromeMedium="#18191a" ChromeLow="#141516" ChromeMediumLow="#0f1011"
                             ChromeAltLow="#d0d6e0" ChromeGray="#8a8f98"
                             ChromeDisabledHigh="#23252a" ChromeDisabledLow="#62666d"
                             ListLow="#141516" ListMedium="#18191a"
                             ErrorText="#eb5757" />
    </FluentTheme.Palettes>
  </FluentTheme>

  <!-- The focus ring (§11.1, X22): 2 px PrimaryHover at full opacity, 2 px outside the control (6.6:1 on Surface1;
       DESIGN.md's 50 % primary-focus ring is 1.8:1, below the 3:1 non-text minimum). The adorner layer clips an adorner
       to its control's bounds by default, which hides a ring drawn wholly outside them, so the ring turns that clip off;
       the layouts leave at least 4 px around each focusable control for it (FocusRingTests). -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{DynamicResource Brush.PrimaryHover}" BorderThickness="2" Margin="-4"
                CornerRadius="{DynamicResource ControlCornerRadius}" AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <!-- A focusable region that fills the window's width (the top bar, the page, the sheet: F6's stops) has no room
       outside it, so its ring is drawn 2 px inside its edge instead. -->
  <Style Selector=":is(Control).focus-region">
    <!-- A Border has no automation peer unless it is a control element with a type: the region is a named Group (review run 4, a11y-0). -->
    <Setter Property="AutomationProperties.AccessibilityView" Value="Control" />
    <Setter Property="AutomationProperties.ControlTypeOverride" Value="Group" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{DynamicResource Brush.PrimaryHover}" BorderThickness="2" Margin="2" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- The sheet's title is a line of text that takes focus as the sheet opens: a box ring round it reads as a focused text field
       (#1100), so its focus is an underline, 2 px PrimaryHover, 4 px below the text. -->
  <Style Selector="Border.sheet-title">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{DynamicResource Brush.PrimaryHover}" BorderThickness="0,0,0,2" Margin="0,0,0,-4" AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- Reduced motion (§11.4) for stock controls: their own transitions run on fixed durations the Motion.* tokens don't
       reach (Fluent's ToggleSwitch knob slides for 200 ms), so under the window's reduce-motion class (SettingsTheme.Follow)
       they're off. A stock control with its own transitions gets its line here. -->
  <Style Selector=":is(TopLevel).reduce-motion ToggleSwitch">
    <Setter Property="KnobTransitions">
      <Transitions />
    </Setter>
  </Style>

  <!-- Thin scroll bars that overlay the content and expand on hover (Fluent's own behaviour, kept on). -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
</Styles>
