<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pvm="using:Aw.Sindri.Ui.ViewModels.Projects"
             x:Class="Aw.Sindri.Ui.Views.Projects.ReviewSettingsSection"
             x:DataType="pvm:ReviewSettingsViewModel">
  <!-- The project sheet's Review settings (review page spec §7, Ph9): the settings entry, where each key comes from, an editor per key with Reset to default, the project's repos and Save and approve.
       Every named line is a Border the screen reader reads as one text (a TextBlock's peer ignores a Name); every field has its own name, rows say which row they are. -->
  <StackPanel x:Name="ReviewSettings" Spacing="{StaticResource Space.MD}" IsVisible="{Binding IsShown}">
    <TextBlock Classes="eyebrow" Text="{Binding Words.Heading}" AutomationProperties.AccessibilityView="Raw" />
    <Border x:Name="ReviewSettingsEntryLine" AutomationProperties.Name="{Binding EntryLine}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Text="{Binding EntryLine}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
    <Border x:Name="ReviewSettingsShared" IsVisible="{Binding SharedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding SharedText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Text="{Binding SharedText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
    <Border x:Name="ReviewSettingsReadOnly" IsVisible="{Binding IsReadOnly}" AutomationProperties.Name="{Binding Words.ReadOnly}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body muted" Text="{Binding Words.ReadOnly}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>

    <StackPanel Spacing="2">
      <TextBlock Classes="caption subtle" Text="{Binding Words.NameField}" AutomationProperties.AccessibilityView="Raw" />
      <TextBox x:Name="ReviewSettingsName" Text="{Binding Name, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Words.NameField}" />
      <Border x:Name="ReviewSettingsNameError" IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding NameError}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding NameError}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
    </StackPanel>
    <StackPanel Spacing="2">
      <TextBlock Classes="caption subtle" Text="{Binding Words.ExtendsField}" AutomationProperties.AccessibilityView="Raw" />
      <TextBox x:Name="ReviewSettingsExtends" Text="{Binding Extends, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Words.ExtendsField}" />
      <Border x:Name="ReviewSettingsExtendsError" IsVisible="{Binding ExtendsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding ExtendsError}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding ExtendsError}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
    </StackPanel>
    <StackPanel Spacing="2">
      <TextBlock Classes="caption subtle" Text="{Binding Words.ReposField}" AutomationProperties.AccessibilityView="Raw" />
      <TextBox x:Name="ReviewSettingsRepos" Text="{Binding ReposText, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" AutomationProperties.Name="{Binding Words.ReposField}" />
      <Border x:Name="ReviewSettingsReposError" IsVisible="{Binding ReposError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding ReposError}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding ReposError}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
    </StackPanel>

    <StackPanel x:Name="ReviewSettingsPanelsKey" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border x:Name="ReviewSettingsPanelsHead" AutomationProperties.Name="{Binding PanelsKey.HeaderText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" VerticalAlignment="Center">
          <TextBlock Classes="body-strong" Text="{Binding PanelsKey.HeaderText}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Button x:Name="ReviewSettingsPanelsReset" Tag="{Binding PanelsKey}" Content="{Binding PanelsKey.ResetText}" IsVisible="{Binding PanelsKey.ShowEditor}" IsEnabled="{Binding CanEdit}" Click="OnReset" AutomationProperties.Name="{Binding PanelsKey.ResetText}" />
      </StackPanel>
      <Border x:Name="ReviewSettingsPanelsResetNote" IsVisible="{Binding PanelsKey.IsReset}" AutomationProperties.Name="{Binding PanelsKey.ResetNote}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body muted" Text="{Binding PanelsKey.ResetNote}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Border x:Name="ReviewSettingsPanelsError" IsVisible="{Binding PanelsKey.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding PanelsKey.Error}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding PanelsKey.Error}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <ItemsControl x:Name="ReviewSettingsPanelList" IsEnabled="{Binding CanEdit}" ItemsSource="{Binding PanelRows}" IsVisible="{Binding PanelsKey.ShowEditor}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pvm:SettingsPanelRow">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CheckBox Name="PanelVisible" Content="{Binding Label}" IsChecked="{Binding Visible, Mode=TwoWay}" AutomationProperties.Name="{Binding ShowName}" />
              <Button Name="PanelUp" Content="{Binding UpText}" Click="OnPanelUp" AutomationProperties.Name="{Binding UpName}" />
              <Button Name="PanelDown" Content="{Binding DownText}" Click="OnPanelDown" AutomationProperties.Name="{Binding DownName}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel x:Name="ReviewSettingsGroupsKey" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border x:Name="ReviewSettingsGroupsHead" AutomationProperties.Name="{Binding GroupsKey.HeaderText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" VerticalAlignment="Center">
          <TextBlock Classes="body-strong" Text="{Binding GroupsKey.HeaderText}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Button x:Name="ReviewSettingsGroupsReset" Tag="{Binding GroupsKey}" Content="{Binding GroupsKey.ResetText}" IsVisible="{Binding GroupsKey.ShowEditor}" IsEnabled="{Binding CanEdit}" Click="OnReset" AutomationProperties.Name="{Binding GroupsKey.ResetText}" />
      </StackPanel>
      <Border x:Name="ReviewSettingsGroupsResetNote" IsVisible="{Binding GroupsKey.IsReset}" AutomationProperties.Name="{Binding GroupsKey.ResetNote}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body muted" Text="{Binding GroupsKey.ResetNote}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Border x:Name="ReviewSettingsGroupsError" IsVisible="{Binding GroupsKey.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding GroupsKey.Error}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding GroupsKey.Error}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <StackPanel Spacing="6" IsVisible="{Binding GroupsKey.ShowEditor}">
        <Border x:Name="ReviewSettingsGroupsByFolder" IsVisible="{Binding ShowGroupsByFolder}" AutomationProperties.Name="{Binding Words.GroupsByFolder}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body muted" Text="{Binding Words.GroupsByFolder}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
        <ItemsControl x:Name="ReviewSettingsGroupList" IsEnabled="{Binding CanEdit}" ItemsSource="{Binding GroupRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pvm:SettingsGroupRow">
              <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBox Name="GroupName" Text="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="{Binding NameName}" />
                <TextBox Name="GroupGlobs" Text="{Binding GlobsText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" AutomationProperties.Name="{Binding GlobsName}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="GroupRemove" Content="{Binding RemoveText}" Click="OnRemoveGroup" AutomationProperties.Name="{Binding RemoveName}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="ReviewSettingsAddGroup" Content="{Binding Words.AddGroup}" IsEnabled="{Binding CanEdit}" Click="OnAddGroup" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Words.AddGroup}" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Name="ReviewSettingsCollapseKey" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border x:Name="ReviewSettingsCollapseHead" AutomationProperties.Name="{Binding CollapseKey.HeaderText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" VerticalAlignment="Center">
          <TextBlock Classes="body-strong" Text="{Binding CollapseKey.HeaderText}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Button x:Name="ReviewSettingsCollapseReset" Tag="{Binding CollapseKey}" Content="{Binding CollapseKey.ResetText}" IsVisible="{Binding CollapseKey.ShowEditor}" IsEnabled="{Binding CanEdit}" Click="OnReset" AutomationProperties.Name="{Binding CollapseKey.ResetText}" />
      </StackPanel>
      <Border x:Name="ReviewSettingsCollapseResetNote" IsVisible="{Binding CollapseKey.IsReset}" AutomationProperties.Name="{Binding CollapseKey.ResetNote}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body muted" Text="{Binding CollapseKey.ResetNote}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Border x:Name="ReviewSettingsCollapseError" IsVisible="{Binding CollapseKey.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding CollapseKey.Error}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding CollapseKey.Error}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <TextBox x:Name="ReviewSettingsCollapseText" Text="{Binding CollapseText, Mode=TwoWay}" IsVisible="{Binding CollapseKey.ShowEditor}" IsEnabled="{Binding CanEdit}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="{Binding Words.CollapseField}" />
    </StackPanel>

    <StackPanel x:Name="ReviewSettingsRiskyKey" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border x:Name="ReviewSettingsRiskyHead" AutomationProperties.Name="{Binding RiskyKey.HeaderText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" VerticalAlignment="Center">
          <TextBlock Classes="body-strong" Text="{Binding RiskyKey.HeaderText}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Button x:Name="ReviewSettingsRiskyReset" Tag="{Binding RiskyKey}" Content="{Binding RiskyKey.ResetText}" IsVisible="{Binding RiskyKey.ShowEditor}" IsEnabled="{Binding CanEdit}" Click="OnReset" AutomationProperties.Name="{Binding RiskyKey.ResetText}" />
      </StackPanel>
      <Border x:Name="ReviewSettingsRiskyResetNote" IsVisible="{Binding RiskyKey.IsReset}" AutomationProperties.Name="{Binding RiskyKey.ResetNote}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body muted" Text="{Binding RiskyKey.ResetNote}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Border x:Name="ReviewSettingsRiskyError" IsVisible="{Binding RiskyKey.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding RiskyKey.Error}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding RiskyKey.Error}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <StackPanel Spacing="6" IsVisible="{Binding RiskyKey.ShowEditor}">
        <ItemsControl x:Name="ReviewSettingsRiskList" IsEnabled="{Binding CanEdit}" ItemsSource="{Binding RiskRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pvm:SettingsRiskRow">
              <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBox Name="RiskGlobs" Text="{Binding GlobsText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" AutomationProperties.Name="{Binding GlobsName}" />
                <TextBox Name="RiskWhy" Text="{Binding Why, Mode=TwoWay}" AutomationProperties.Name="{Binding WhyName}" />
                <Button Name="RiskRemove" Content="{Binding RemoveText}" Click="OnRemoveRisk" HorizontalAlignment="Left" AutomationProperties.Name="{Binding RemoveName}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="ReviewSettingsAddRisk" Content="{Binding Words.AddRisk}" IsEnabled="{Binding CanEdit}" Click="OnAddRisk" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Words.AddRisk}" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Name="ReviewSettingsChecksKey" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border x:Name="ReviewSettingsChecksHead" AutomationProperties.Name="{Binding ChecksKey.HeaderText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" VerticalAlignment="Center">
          <TextBlock Classes="body-strong" Text="{Binding ChecksKey.HeaderText}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Button x:Name="ReviewSettingsChecksReset" Tag="{Binding ChecksKey}" Content="{Binding ChecksKey.ResetText}" IsVisible="{Binding ChecksKey.ShowEditor}" IsEnabled="{Binding CanEdit}" Click="OnReset" AutomationProperties.Name="{Binding ChecksKey.ResetText}" />
      </StackPanel>
      <Border x:Name="ReviewSettingsChecksResetNote" IsVisible="{Binding ChecksKey.IsReset}" AutomationProperties.Name="{Binding ChecksKey.ResetNote}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body muted" Text="{Binding ChecksKey.ResetNote}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Border x:Name="ReviewSettingsChecksError" IsVisible="{Binding ChecksKey.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding ChecksKey.Error}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding ChecksKey.Error}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <StackPanel Spacing="6" IsVisible="{Binding ChecksKey.ShowEditor}">
        <ItemsControl x:Name="ReviewSettingsCheckList" IsEnabled="{Binding CanEdit}" ItemsSource="{Binding CheckRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pvm:SettingsCheckRow">
              <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBox Name="CheckId" Text="{Binding Id, Mode=TwoWay}" AutomationProperties.Name="{Binding IdName}" />
                <TextBox Name="CheckTitle" Text="{Binding Title, Mode=TwoWay}" AutomationProperties.Name="{Binding TitleName}" />
                <TextBox Name="CheckWhen" Text="{Binding WhenText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" AutomationProperties.Name="{Binding WhenName}" />
                <TextBox Name="CheckNeed" Text="{Binding NeedText, Mode=TwoWay}" IsReadOnly="{Binding NeedReadOnly}" AutomationProperties.Name="{Binding NeedName}" />
                <Button Name="CheckRemove" Content="{Binding RemoveText}" Click="OnRemoveCheck" HorizontalAlignment="Left" AutomationProperties.Name="{Binding RemoveName}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="ReviewSettingsAddCheck" Content="{Binding Words.AddCheck}" IsEnabled="{Binding CanEdit}" Click="OnAddCheck" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Words.AddCheck}" />
      </StackPanel>
    </StackPanel>

    <Border x:Name="ReviewSettingsSharedAtSave" IsVisible="{Binding SharedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding SharedText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
      <TextBlock Classes="body" Text="{Binding SharedText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanChange}">
      <Button x:Name="ReviewSettingsSave" Content="{Binding SaveText}" IsEnabled="{Binding !IsSaving}" Click="OnSave" AutomationProperties.Name="{Binding SaveText}" />
      <Button x:Name="ReviewSettingsDiscard" Content="{Binding Words.Discard}" IsEnabled="{Binding !IsSaving}" Click="OnDiscard" AutomationProperties.Name="{Binding Words.Discard}" />
    </StackPanel>
    <StackPanel Spacing="6" IsVisible="{Binding IsStale}">
      <Border x:Name="ReviewSettingsStale" AutomationProperties.Name="{Binding Words.Stale}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding Words.Stale}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Button x:Name="ReviewSettingsReload" Content="{Binding Words.Reload}" IsEnabled="{Binding !IsSaving}" Click="OnDiscard" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Words.Reload}" />
    </StackPanel>
    <Border x:Name="ReviewSettingsNote" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding Note}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body muted" Text="{Binding Note}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
    <Border x:Name="ReviewSettingsSaveError" IsVisible="{Binding SaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding SaveError}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding SaveError}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
  </StackPanel>
</UserControl>
