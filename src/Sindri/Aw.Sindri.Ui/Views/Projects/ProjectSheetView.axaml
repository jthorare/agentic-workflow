<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pvm="using:Aw.Sindri.Ui.ViewModels.Projects"
             xmlns:wf="using:Aw.Sindri.Ui.Api.Workflow"
             x:Class="Aw.Sindri.Ui.Views.Projects.ProjectSheetView"
             x:DataType="pvm:ProjectSheetViewModel">
  <!-- A project card's sheet (projects page spec §3.2) inside the shell's sheet: every field of the card, its links, then the actions its origin allows. Remove asks inline
       and puts focus on Keep; a save shows "Saving…" and its error under the button; a stale version says so with Reload. Every named line is a Border the screen reader
       reads as one text (a TextBlock's peer ignores a Name). Notes are read-only here. -->
  <StackPanel x:Name="ProjectSheet" Spacing="{StaticResource Space.MD}">
    <TextBlock x:Name="ProjectLoading" Classes="body muted" Text="{Binding LoadingText}" IsVisible="{Binding IsLoading}" AutomationProperties.Name="{Binding LoadingText}" />
    <TextBlock x:Name="ProjectProblem" Classes="body" Text="{Binding ProblemText}" IsVisible="{Binding IsProblem}" TextWrapping="Wrap" AutomationProperties.Name="{Binding ProblemText}" />
    <Border x:Name="ProjectNote" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            AutomationProperties.Name="{Binding Note}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
      <TextBlock Classes="body muted" Text="{Binding Note}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
    </Border>

    <StackPanel x:Name="ProjectBody" Spacing="{StaticResource Space.MD}" IsVisible="{Binding IsShown}">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border x:Name="ProjectHeading" AutomationProperties.Name="{Binding Heading}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="body-strong" Text="{Binding Heading}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.HairlineStrong}" CornerRadius="{StaticResource Radius.XS}" Padding="6,1" VerticalAlignment="Center"
                  IsVisible="{Binding OriginChip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="caption subtle" Text="{Binding OriginChip}" />
          </Border>
        </StackPanel>
        <Border x:Name="ProjectState" AutomationProperties.Name="{Binding StateText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.AccessibilityView="Raw">
            <TextBlock Classes="body" Text="{Binding StateText}" />
            <TextBlock Classes="body" Foreground="{DynamicResource Brush.Ink}" Text="{Binding HealthWord, StringFormat='· {0}'}" IsVisible="{Binding HealthWord, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
        <Border x:Name="ProjectLead" IsVisible="{Binding LeadText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding LeadText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="body" Text="{Binding LeadText}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Border x:Name="ProjectTarget" IsVisible="{Binding TargetText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding TargetText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="body" Text="{Binding TargetText}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Border x:Name="ProjectIssues" IsVisible="{Binding IssuesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding IssuesText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="body" Text="{Binding IssuesText}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Border x:Name="ProjectPrs" IsVisible="{Binding PrsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding PrsText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="body" Text="{Binding PrsText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Border x:Name="ProjectFinished" IsVisible="{Binding FinishedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding FinishedText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="body" Text="{Binding FinishedText}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Border x:Name="ProjectActivity" IsVisible="{Binding ActivityText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding ActivityText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="caption subtle" Text="{Binding ActivityText}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
      </StackPanel>

      <Border x:Name="ProjectDescription" IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding Description}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Text="{Binding Description}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>

      <StackPanel Spacing="4" IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="eyebrow" Text="{Binding NotesHeading}" AutomationProperties.AccessibilityView="Raw" />
        <Border x:Name="ProjectNotes" AutomationProperties.Name="{Binding Notes}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="body" Text="{Binding Notes}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
      </StackPanel>

      <StackPanel x:Name="ProjectLinksRow" Spacing="4">
        <TextBlock Classes="eyebrow" Text="{Binding LinksHeading}" AutomationProperties.AccessibilityView="Raw" />
        <ItemsControl x:Name="ProjectLinksList" ItemsSource="{Binding Links}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pvm:ProjectLinkItem">
              <Panel>
                <HyperlinkButton Name="ProjectLink" Padding="0" Click="OnOpenLink" IsVisible="{Binding CanOpen}" AutomationProperties.Name="{Binding Text}">
                  <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" />
                </HyperlinkButton>
                <Border Name="ProjectLinkText" IsVisible="{Binding !CanOpen}" AutomationProperties.Name="{Binding Text}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                  <TextBlock Classes="body muted" Text="{Binding Text}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                </Border>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel x:Name="ProjectReposRow" Spacing="4" IsVisible="{Binding Repos.Count}">
        <TextBlock Classes="eyebrow" Text="{Binding ReposHeading}" AutomationProperties.AccessibilityView="Raw" />
        <ItemsControl x:Name="ProjectReposList" ItemsSource="{Binding Repos}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pvm:ProjectLinkItem">
              <Panel>
                <HyperlinkButton Name="ProjectRepoLink" Padding="0" Click="OnOpenLink" IsVisible="{Binding CanOpen}" AutomationProperties.Name="{Binding Text}">
                  <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" />
                </HyperlinkButton>
                <Border Name="ProjectRepoText" IsVisible="{Binding !CanOpen}" AutomationProperties.Name="{Binding Text}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                  <TextBlock Classes="body muted" Text="{Binding Text}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                </Border>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <WrapPanel x:Name="ProjectActions" Orientation="Horizontal">
        <Button x:Name="ProjectEdit" Content="{Binding EditText}" IsVisible="{Binding CanEdit}" IsEnabled="{Binding !IsEditing}" Click="OnEdit" Margin="0,0,8,8" AutomationProperties.Name="{Binding EditText}" />
        <Button x:Name="ProjectRemove" Content="{Binding RemoveText}" IsVisible="{Binding CanRemove}" Click="OnAskRemove" Margin="0,0,8,8" AutomationProperties.Name="{Binding RemoveText}" />
        <Button x:Name="ProjectHide" Content="{Binding HideText}" IsVisible="{Binding CanHide}" Click="OnHide" Margin="0,0,8,8" AutomationProperties.Name="{Binding HideText}" />
        <Button x:Name="ProjectUnhide" Content="{Binding UnhideText}" IsVisible="{Binding CanUnhide}" Click="OnUnhide" Margin="0,0,8,8" AutomationProperties.Name="{Binding UnhideText}" />
      </WrapPanel>

      <Border x:Name="ProjectRemoveAsk" Classes="card" IsVisible="{Binding IsConfirmingRemove}">
        <StackPanel Spacing="8">
          <Border x:Name="ProjectRemoveQuestion" AutomationProperties.Name="{Binding RemoveQuestion}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="body" Text="{Binding RemoveQuestion}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ProjectRemoveConfirm" Content="{Binding RemoveText}" IsEnabled="{Binding !IsSaving}" Click="OnRemove" AutomationProperties.Name="{Binding RemoveText}" />
            <Button x:Name="ProjectKeep" Content="{Binding KeepText}" Click="OnKeep" AutomationProperties.Name="{Binding KeepText}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel x:Name="ProjectStateForm" Spacing="6" IsVisible="{Binding CanSetState}">
        <TextBlock Classes="eyebrow" Text="{Binding StateLabel}" AutomationProperties.AccessibilityView="Raw" />
        <ComboBox x:Name="ProjectStatePick" ItemsSource="{Binding StateChoices}" SelectedItem="{Binding SelectedState, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding StateLabel}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="pvm:ProjectStateChoice"><TextBlock Text="{Binding Word}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <WrapPanel Orientation="Horizontal">
          <Button x:Name="ProjectSetState" Content="{Binding SetStateText}" IsEnabled="{Binding !IsSaving}" Click="OnSetState" Margin="0,0,8,0" AutomationProperties.Name="{Binding SetStateText}" />
          <Button x:Name="ProjectClearState" Content="{Binding UseLinearStateText}" IsVisible="{Binding CanClearState}" IsEnabled="{Binding !IsSaving}" Click="OnClearState" AutomationProperties.Name="{Binding UseLinearStateText}" />
        </WrapPanel>
      </StackPanel>

      <StackPanel x:Name="ProjectEditForm" Spacing="6" IsVisible="{Binding IsEditing}">
        <StackPanel Spacing="2" IsVisible="{Binding CanEditName}">
          <TextBlock Classes="caption subtle" Text="{Binding NameLabel}" AutomationProperties.AccessibilityView="Raw" />
          <TextBox x:Name="ProjectEditName" Text="{Binding EditName, Mode=TwoWay}" AutomationProperties.Name="{Binding NameLabel}" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Classes="caption subtle" Text="{Binding TargetLabel}" AutomationProperties.AccessibilityView="Raw" />
          <TextBox x:Name="ProjectEditTarget" Text="{Binding EditTarget, Mode=TwoWay}" AutomationProperties.Name="{Binding TargetLabel}" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Classes="caption subtle" Text="{Binding LinksLabel}" AutomationProperties.AccessibilityView="Raw" />
          <TextBox x:Name="ProjectEditLinks" Text="{Binding EditLinks, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="{Binding LinksLabel}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ProjectSave" Content="{Binding SaveText}" IsEnabled="{Binding !IsSaving}" Click="OnSave" AutomationProperties.Name="{Binding SaveText}" />
          <Button x:Name="ProjectCancelEdit" Content="{Binding CancelEditText}" IsEnabled="{Binding !IsSaving}" Click="OnCancelEdit" AutomationProperties.Name="{Binding CancelEditText}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding SaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Border x:Name="ProjectSaveError" AutomationProperties.Name="{Binding SaveError}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding SaveError}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Button x:Name="ProjectReload" Content="{Binding ReloadText}" IsVisible="{Binding IsConflict}" Click="OnReload" HorizontalAlignment="Left" AutomationProperties.Name="{Binding ReloadText}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
