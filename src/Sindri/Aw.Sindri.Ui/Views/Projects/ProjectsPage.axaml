<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pvm="using:Aw.Sindri.Ui.ViewModels.Projects"
             xmlns:pv="using:Aw.Sindri.Ui.Views.Projects"
             x:Class="Aw.Sindri.Ui.Views.Projects.ProjectsPage"
             x:DataType="pvm:ProjectsPageViewModel">
  <!-- The Projects page (Projects page spec §3, mockup B): the title with the freshness line and Add project, the served sentence as an empty block or a
       banner, a group per state with its cards in a grid of Columns, and the Finished and Hidden folds. Add opens the Add project sheet. Every named line is a
       Border wrapper (a TextBlock's peer ignores AutomationProperties.Name). -->
  <UserControl.Styles>
    <Style Selector="ItemsControl.cards">
      <Setter Property="ItemTemplate">
        <DataTemplate x:DataType="pvm:ProjectCardViewModel">
          <pv:ProjectCard Margin="0,0,12,12" VerticalAlignment="Stretch" />
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="TextBlock.failing"><Setter Property="Foreground" Value="{DynamicResource Brush.Attention}" /></Style>
  </UserControl.Styles>
  <StackPanel x:Name="ProjectsRoot" Spacing="{StaticResource Size.PanelGap}">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock x:Name="ProjectsTitle" Classes="page-title" Focusable="True" Text="{Binding Title}" AutomationProperties.Name="{Binding Title}" />
        <TextBlock x:Name="ProjectsFreshness" Classes="caption subtle" Classes.failing="{Binding FreshnessFailing}" Text="{Binding Freshness}" TextWrapping="Wrap" />
      </StackPanel>
      <Button x:Name="ProjectsAdd" Grid.Column="1" Content="{Binding AddText}" Click="OnAdd" VerticalAlignment="Top" AutomationProperties.Name="{Binding AddText}" />
    </Grid>

    <TextBlock x:Name="ProjectsError" Classes="caption subtle" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <UniformGrid x:Name="ProjectsLoading" Columns="{Binding Columns}" IsVisible="{Binding IsLoading}" AutomationProperties.AccessibilityView="Raw">
      <Border Classes="card" Height="132" Margin="0,0,12,12" Opacity="0.6" />
      <Border Classes="card" Height="132" Margin="0,0,12,12" Opacity="0.6" />
      <Border Classes="card" Height="132" Margin="0,0,12,12" Opacity="0.6" />
    </UniformGrid>

    <StackPanel x:Name="ProjectsLinearNote" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowsLinearNote}">
      <TextBlock x:Name="ProjectsLinearNoteText" Classes="caption subtle" Text="{Binding LinearNote}" VerticalAlignment="Center" AutomationProperties.Name="{Binding LinearNote}" />
      <Button x:Name="ProjectsConnectNote" Content="{Binding ConnectText}" Click="OnConnect" VerticalAlignment="Center" AutomationProperties.Name="{Binding ConnectText}" />
    </StackPanel>
    <Border x:Name="ProjectsBanner" Classes="card" Background="{DynamicResource Brush.ErrorSoft}" BorderBrush="{DynamicResource Brush.Error}" BorderThickness="1" IsVisible="{Binding IsBanner}">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Error}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        <Border x:Name="ProjectsBannerName" VerticalAlignment="Center" AutomationProperties.Name="{Binding Sentence}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="body" Foreground="{DynamicResource Brush.Ink}" Text="{Binding Sentence}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Button x:Name="ProjectsConnectBanner" Content="{Binding ConnectText}" Click="OnConnect" IsVisible="{Binding ShowsConnect}" VerticalAlignment="Center" AutomationProperties.Name="{Binding ConnectText}" />
      </StackPanel>
    </Border>

    <!-- The empty card is a solid card like the other pages' empty states; Add project stays the one button at the top right, and Connect Linear is the second way in when Linear is not set up. -->
    <Border x:Name="ProjectsEmptyCard" Classes="card" BorderThickness="1" IsVisible="{Binding IsEmptyBlock}">
      <StackPanel Margin="{StaticResource Space.MD.Thickness}" Spacing="{StaticResource Space.MD}" HorizontalAlignment="Center">
        <Border x:Name="ProjectsEmptyName" AutomationProperties.Name="{Binding Sentence}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="body muted" Text="{Binding Sentence}" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Button x:Name="ProjectsConnectEmpty" Classes="accent" Content="{Binding ConnectText}" Click="OnConnect" IsVisible="{Binding ShowsConnect}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding ConnectText}" />
      </StackPanel>
    </Border>

    <ItemsControl x:Name="ProjectsGroups" pv:CardGrid.IsGrid="True" ItemsSource="{Binding Groups}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="pvm:ProjectGroupViewModel">
          <StackPanel Spacing="{StaticResource Space.XS}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
              <TextBlock x:Name="ProjectsGroupHeading" Classes="eyebrow subtle" Text="{Binding HeadingCaps}" />
              <TextBlock Classes="eyebrow" Foreground="{DynamicResource Brush.InkSubtle}" Text="{Binding Count}" />
            </StackPanel>
            <ItemsControl Classes="cards" ItemsSource="{Binding Cards}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Expander x:Name="ProjectsFinished" DataContext="{Binding Finished}" x:DataType="pvm:ProjectFoldViewModel" IsVisible="{Binding IsVisible}"
              IsExpanded="{Binding IsOpen, Mode=TwoWay}" TemplateApplied="OnFoldTemplate" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Heading}">
      <Expander.Header>
        <Grid ColumnDefinitions="Auto,*" x:DataType="pvm:ProjectFoldViewModel">
          <TextBlock Classes="body muted" Text="{Binding Heading}" />
          <TextBlock Grid.Column="1" Classes="caption" Foreground="{DynamicResource Brush.InkSubtle}" HorizontalAlignment="Right" Text="{Binding Why}" />
        </Grid>
      </Expander.Header>
      <ItemsControl Classes="cards" pv:CardGrid.IsGrid="True" ItemsSource="{Binding Cards}" Margin="0,8,0,0">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </Expander>

    <Expander x:Name="ProjectsHidden" DataContext="{Binding Hidden}" x:DataType="pvm:ProjectFoldViewModel" IsVisible="{Binding IsVisible}"
              IsExpanded="{Binding IsOpen, Mode=TwoWay}" TemplateApplied="OnFoldTemplate" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Heading}">
      <Expander.Header>
        <Grid ColumnDefinitions="Auto,*" x:DataType="pvm:ProjectFoldViewModel">
          <TextBlock Classes="body muted" Text="{Binding Heading}" />
          <TextBlock Grid.Column="1" Classes="caption" Foreground="{DynamicResource Brush.InkSubtle}" HorizontalAlignment="Right" Text="{Binding Why}" />
        </Grid>
      </Expander.Header>
      <ItemsControl Classes="cards" pv:CardGrid.IsGrid="True" ItemsSource="{Binding Cards}" Margin="0,8,0,0">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </Expander>
  </StackPanel>
</UserControl>
