<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels"
             xmlns:start="using:Aw.Sindri.Ui.ViewModels.Start"
             x:Class="Aw.Sindri.Ui.Views.Start.StartDialog"
             x:DataType="start:StartFormViewModel">
  <!-- Start workflow (screens spec §4.2, U5'): a modal form over a scrim. Recipe, item and one field for each input of the recipe; sent once by
       the Start button or Ctrl+Enter. A refusal is read in the error line, which takes focus. Esc or Cancel closes it with nothing sent. Every
       field is named by the words it shows; the error lines sit in a row that keeps its height while empty, so nothing moves when one shows; the lines that change are one static wrapper each, named by a view-model string, with the
       text inside left raw (a TextBlock's peer ignores a Name). -->
  <UserControl.Styles>
    <Style Selector="Border.scrim">
      <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.LG}" />
      <Setter Property="Padding" Value="{StaticResource Space.LG.Thickness}" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <Border Classes="scrim" PointerPressed="OnScrim" />
    <Border x:Name="StartCard" Classes="dialog" Width="560" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0"
            KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.ControlTypeOverride="Window" AutomationProperties.AccessibilityView="Control"
            AutomationProperties.Name="{Binding Text.Title}">
      <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="0,0,12,0">
          <TextBlock Classes="detail-title" Text="{Binding Text.Title}" />
          <Border x:Name="StartReadiness" IsVisible="{Binding IsNotReady}" AutomationProperties.Name="{Binding Readiness}"
                  AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="caption subtle" Text="{Binding Readiness}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <Border x:Name="StartNote" IsVisible="{Binding HasNote}" AutomationProperties.Name="{Binding Note}"
                  AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="caption" Text="{Binding Note}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <Border MinHeight="20">
            <Border x:Name="StartBusy" IsVisible="{Binding IsBusy}" AutomationProperties.Name="{Binding BusyText}"
                    AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
              <TextBlock Classes="caption subtle" Text="{Binding BusyText}" AutomationProperties.AccessibilityView="Raw" />
            </Border>
          </Border>
          <TextBlock Classes="caption subtle" Text="{Binding Text.Recipe}" AutomationProperties.AccessibilityView="Raw" />
          <ComboBox x:Name="StartRecipe" ItemsSource="{Binding Recipes}" SelectedItem="{Binding Recipe}" SelectionChanged="OnRecipeChosen"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Text.Recipe}" AutomationProperties.HelpText="{Binding RecipeError}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="start:RecipeChoice">
                <TextBlock Text="{Binding Display}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="caption subtle" Text="{Binding Text.Item}" AutomationProperties.AccessibilityView="Raw" />
          <TextBox x:Name="StartItem" Text="{Binding ItemId}" AutomationProperties.Name="{Binding Text.Item}"
                   AutomationProperties.HelpText="{Binding ItemError}" />
          <TextBlock Classes="caption subtle" Text="{Binding Text.PickCaption}" AutomationProperties.AccessibilityView="Raw" />
          <ComboBox x:Name="StartItemPick" ItemsSource="{Binding Items}" SelectedItem="{Binding PickedItem}" PlaceholderText="{Binding Text.PickItem}"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Text.PickCaption}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="start:ItemChoice">
                <TextBlock Text="{Binding Display}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ItemsControl x:Name="StartFields" ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="start:StartFieldViewModel">
                <StackPanel Spacing="6" Margin="0,0,0,10">
                  <TextBlock Classes="caption subtle" Text="{Binding Caption}" AutomationProperties.AccessibilityView="Raw" />
                  <TextBox Classes="start-input" Text="{Binding Value}" IsVisible="{Binding IsLine}" AutomationProperties.Name="{Binding Caption}"
                           AutomationProperties.HelpText="{Binding HelpText}" />
                  <TextBox Classes="start-input" Text="{Binding Value}" IsVisible="{Binding IsPayload}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                           AutomationProperties.Name="{Binding Caption}" AutomationProperties.HelpText="{Binding HelpText}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsFile}">
                    <Button Classes="command-control start-pick" AutomationProperties.Name="{Binding FileButtonName}" AutomationProperties.HelpText="{Binding HelpText}">
                      <TextBlock Classes="button" Text="{Binding ChooseFileText}" />
                    </Button>
                    <TextBlock Classes="caption" Text="{Binding FileLine}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="caption subtle" Text="{Binding Hint}" IsVisible="{Binding HasHint}" />
                  <Border MinHeight="20">
                    <Border Classes="start-field-error" IsVisible="{Binding HasError}" AutomationProperties.Name="{Binding Error}"
                            AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                      <TextBlock Classes="caption error" Text="{Binding Error}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border MinHeight="20">
            <Border x:Name="StartError" Focusable="True" IsVisible="{Binding ShowsSummary}" AutomationProperties.Name="{Binding Error}"
                    AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
              <TextBlock Classes="caption error" Text="{Binding Error}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
            </Border>
          </Border>
          <!-- The one polite live region, on CreateItemDialog's pattern (docs "LiveSetting on macOS"): always in the tree, live only while it speaks, resting text while dark. -->
          <TextBlock x:Name="StartLive" Classes="caption live-region" Classes.live="{Binding IsAnnouncing}" Text="{Binding Announcement}" Width="0" Opacity="0"
                     IsHitTestVisible="False" HorizontalAlignment="Left" />
          <Border x:Name="StartOutcome" Focusable="True" IsVisible="{Binding HasOutcome}" AutomationProperties.Name="{Binding Outcome}"
                  AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="caption" Text="{Binding Outcome}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <Button x:Name="StartNewAttempt" Classes="command-control" Click="OnNewAttempt" IsVisible="{Binding OffersNewAttempt}" IsEnabled="{Binding CanStartNewAttempt}"
                  AutomationProperties.Name="{Binding Text.NewAttempt}">
            <TextBlock Classes="button" Text="{Binding Text.NewAttempt}" />
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="StartButton" Classes="command-control" Click="OnStart" IsEnabled="{Binding CanStart}" AutomationProperties.Name="{Binding ButtonText}"
                    AutomationProperties.HelpText="{Binding StartHelp}">
              <TextBlock Classes="button" Text="{Binding ButtonText}" AutomationProperties.AccessibilityView="Raw" />
            </Button>
            <Button x:Name="StartCancel" Classes="command-control" Click="OnCancel" AutomationProperties.Name="{Binding Text.Cancel}">
              <TextBlock Classes="button" Text="{Binding Text.Cancel}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Panel>
</UserControl>
