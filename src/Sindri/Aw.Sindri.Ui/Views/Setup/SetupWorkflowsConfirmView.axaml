<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="using:Aw.Sindri.Ui.ViewModels.Approvals"
             x:Class="Aw.Sindri.Ui.Views.Setup.SetupWorkflowsConfirmView"
             x:DataType="ap:ApproveAllViewModel">
  <!-- The workflows row's plan and its Approve button (setup spec §2.2, §8.3) on the approve-all dialog's own view model: what each workflow may do, the ones that need their own
       look, then one Approve click. -->
  <StackPanel x:Name="SetupWorkflowsPanel" Spacing="8" IsVisible="{Binding IsOpen}">
    <Border x:Name="SetupWorkflowsReading" IsVisible="{Binding IsReading}" AutomationProperties.Name="{Binding ReadingText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
      <TextBlock Classes="caption subtle" Text="{Binding ReadingText}" AutomationProperties.AccessibilityView="Raw" />
    </Border>
    <Border x:Name="SetupWorkflowsEmpty" IsVisible="{Binding IsEmpty}" AutomationProperties.Name="{Binding EmptyText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
      <TextBlock Classes="caption" Text="{Binding EmptyText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
    </Border>

    <StackPanel x:Name="SetupWorkflowsPlan" Spacing="6" IsVisible="{Binding ShowsPlan}">
      <TextBlock Classes="body-strong" Text="{Binding Heading}" />
      <ItemsControl x:Name="SetupWorkflowsRows" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ap:PlanRowViewModel">
            <Border Margin="0,0,0,8" Focusable="True" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
              <StackPanel Spacing="2" AutomationProperties.AccessibilityView="Raw">
                <TextBlock Classes="body-strong" Text="{Binding Name}" />
                <TextBlock Classes="caption" Text="{Binding Reason}" />
                <ItemsControl ItemsSource="{Binding Capabilities}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="caption subtle" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border x:Name="SetupWorkflowsEvery" AutomationProperties.Name="{Binding EveryText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="caption subtle" Text="{Binding EveryText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
    </StackPanel>

    <StackPanel x:Name="SetupWorkflowsOwn" Spacing="4" IsVisible="{Binding HasOwnApproval}">
      <TextBlock Classes="body-strong" Text="{Binding OwnHeading}" />
      <TextBlock Classes="caption subtle" Text="{Binding OwnHint}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding OwnApproval}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ap:ApproveAllLine">
            <Border Margin="0,0,0,6" Focusable="True" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
              <StackPanel Spacing="2" AutomationProperties.AccessibilityView="Raw">
                <TextBlock Classes="body-strong" Text="{Binding Name}" />
                <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" />
                <TextBlock Classes="caption subtle" Text="{Binding Extra}" IsVisible="{Binding HasExtra}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Border x:Name="SetupWorkflowsError" IsVisible="{Binding HasError}" AutomationProperties.Name="{Binding Error}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
      <StackPanel Spacing="2" AutomationProperties.AccessibilityView="Raw">
        <TextBlock Classes="caption error" Text="{Binding Error}" TextWrapping="Wrap" />
        <TextBlock Classes="caption subtle mono" Text="{Binding ErrorCode}" />
      </StackPanel>
    </Border>
    <Border x:Name="SetupWorkflowsNotice" IsVisible="{Binding HasNotice}" AutomationProperties.Name="{Binding Notice}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
      <TextBlock Classes="caption" Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
    </Border>
    <Button x:Name="SetupWorkflowsApprove" Classes="command-control" IsVisible="{Binding CanApprove}" Click="OnApprove" HorizontalAlignment="Left" AutomationProperties.Name="{Binding ApproveLabel}">
      <TextBlock Classes="button" Text="{Binding ApproveLabel}" AutomationProperties.AccessibilityView="Raw" />
    </Button>

    <Border x:Name="SetupWorkflowsRunning" IsVisible="{Binding IsApplying}" AutomationProperties.Name="{Binding Progress}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
      <TextBlock Classes="body" Text="{Binding Progress}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
    </Border>
    <Border x:Name="SetupWorkflowsOutcome" IsVisible="{Binding IsDone}" Focusable="True" AutomationProperties.Name="{Binding Outcome}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
      <TextBlock Classes="body-strong" Text="{Binding Outcome}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
    </Border>
    <TextBlock x:Name="SetupWorkflowsLive" Classes="caption live-region" Classes.live="{Binding Live.IsAnnouncing}" Text="{Binding Live.Announcement}" Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
