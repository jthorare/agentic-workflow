<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jb="using:Aw.Sindri.Ui.ViewModels.Jobs"
             xmlns:controls="using:Aw.Sindri.Ui.Views.Controls"
             x:Class="Aw.Sindri.Ui.Views.Jobs.JobRow"
             x:DataType="jb:JobRowViewModel">
  <!-- One job on the Jobs page (API P6): the state as a word with its glyph, the kind and what it works on (a button: it opens the job's sheet), when it started or
       ended and who started it, how it ended, and Cancel while it runs. The row's name is its title, state, when, who and summary; every named line is a Border
       wrapper (a TextBlock's peer ignores AutomationProperties.Name). The row draws its own focus border (item-row), not the adorner. -->
  <Border x:Name="JobRowFrame" Classes="item-row job-row" Focusable="True"
          AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
    <Grid x:Name="JobRowGrid" ColumnDefinitions="1.6*,110,150,1.2*,130,56,120" RowDefinitions="Auto,Auto" VerticalAlignment="Center" MinHeight="36">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Center">
        <Button x:Name="JobRowOpen" Classes="row-title" Click="OnOpen" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Name}">
          <TextBlock Classes="body-strong" Text="{Binding TitleText}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
        </Button>
        <TextBlock Classes="caption mono subtle" Text="{Binding KeyText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </StackPanel>
      <Border x:Name="JobRowChip" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding ChipText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body-strong mono" Text="{Binding ChipText}" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Border x:Name="JobRowWhen" Grid.Column="2" IsVisible="{Binding IsWide}" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding WhenText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="caption subtle" Text="{Binding WhenText}" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <TextBlock Grid.Column="3" Classes="caption subtle" Text="{Binding ByText}" IsVisible="{Binding IsWide}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <Border x:Name="JobRowSummary" Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding HasWideSummary}" AutomationProperties.Name="{Binding SummaryText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.AccessibilityView="Raw">
          <TextBlock Classes="caption" Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Classes="caption mono subtle" Text="{Binding CodeText}" IsVisible="{Binding HasCode}" AutomationProperties.AccessibilityView="Raw" />
        </StackPanel>
      </Border>
      <TextBlock Grid.Column="5" Classes="caption subtle" Text="{Binding RoundsText}" VerticalAlignment="Center" />
      <Panel Grid.Column="6" VerticalAlignment="Center" IsVisible="{Binding HasCancel}">
        <controls:CommandControl x:Name="JobRowCancel" DataContext="{Binding Cancel}" />
      </Panel>
      <!-- The second row (context model routing, 8.2): what the job's model calls came to, or why it waits, across every column, wrapping at any width; Resume at its end while the job is parked on a model limit.
           Hidden when the job made no call and isn't parked. -->
      <Grid x:Name="JobRowModelRow" Grid.Row="1" Grid.ColumnSpan="7" ColumnDefinitions="*,Auto" IsVisible="{Binding HasModelRow}" Margin="0,2,0,6">
        <Border x:Name="JobRowModels" IsVisible="{Binding HasModelText}" VerticalAlignment="Center" AutomationProperties.Name="{Binding ModelText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="caption subtle" Text="{Binding ModelText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Panel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasResume}">
          <controls:CommandControl x:Name="JobRowResume" DataContext="{Binding Resume}" />
        </Panel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
