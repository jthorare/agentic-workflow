<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cb="using:Aw.Sindri.Ui.ViewModels.Connections"
             x:Class="Aw.Sindri.Ui.Views.Connections.ServiceTileView"
             x:DataType="cb:ServiceTileViewModel">
  <!-- One service tile (#2537): the service, a status chip, and ONE primary button (Connect, Add token, Try again or Reconnect; a connected tile has none). Connected, it shows the account
       and the last use, with a menu for Reconnect and Disconnect. A service that needs a client id or a token asks for it on the tile, with one help line, a link to the provider's page and
       the reason the button waits. A failed or cancelled sign-in shows here. Hover and pressed come from the shared clickable class. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.tile-chip.ok"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></Style>
    <Style Selector="TextBlock.tile-chip.attention"><Setter Property="Foreground" Value="{DynamicResource Brush.Attention}" /></Style>
  </UserControl.Styles>
  <Border x:Name="ServiceTileFrame" Classes="card clickable" Width="260" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
    <StackPanel Spacing="{StaticResource Space.XS}">
      <!-- A fixed-height title row, both the title and the menu button centred in it, so every tile's title sits at the same y whether it has the menu button or not. -->
      <Grid ColumnDefinitions="*,Auto" Height="32"><!-- TODO(#2546): Row.Height.Default -->
        <TextBlock Classes="body-strong" Text="{Binding Title}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        <Button x:Name="ServiceTileMenu" Grid.Column="1" Classes="command-control" VerticalAlignment="Center" Content="⋯" IsVisible="{Binding !IsOffered}" AutomationProperties.Name="{Binding Text.More}">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem x:Name="ServiceTileReconnect" Header="{Binding Text.Reconnect}" IsVisible="{Binding CanReconnect}" Click="OnSignIn" />
              <MenuItem x:Name="ServiceTileRename" Header="{Binding Text.Rename}" IsVisible="{Binding CanRename}" Click="OnRename" />
              <MenuItem x:Name="ServiceTileDisconnect" Header="{Binding Text.Disconnect}" Click="OnDisconnect" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
      <Border x:Name="ServiceTileChip" AutomationProperties.Name="{Binding StatusChip}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" HorizontalAlignment="Left">
        <TextBlock Classes="caption tile-chip" Classes.ok="{Binding IsConnected}" Classes.attention="{Binding NeedsAttention}" Text="{Binding StatusChip}" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <TextBlock x:Name="ServiceTileSubtitle" Classes="caption subtle" Text="{Binding Subtitle}" IsVisible="{Binding ShowSubtitle}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      <!-- #2708: a service with several connections lists each under the one tile, each with its own Rename (the field below renames the row that was asked). -->
      <ItemsControl ItemsSource="{Binding Connections}" IsVisible="{Binding HasMany}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="cb:ConnectionRowViewModel">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="caption" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="{Binding Text.Rename}" AutomationProperties.Name="{Binding RenameName}" AutomationProperties.AutomationId="{Binding RenameId}" Click="OnRenameRow" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel x:Name="ServiceTileRenameBox" Spacing="{StaticResource Space.XS}" IsVisible="{Binding IsRenaming}">
        <TextBox x:Name="ServiceTileRenameField" Text="{Binding RenameText, Mode=TwoWay}" PlaceholderText="{Binding Text.RenameLabel}" KeyDown="OnRenameKey" AutomationProperties.Name="{Binding Text.RenameLabel}" />
        <TextBlock x:Name="ServiceTileRenameError" Classes="caption" Foreground="{DynamicResource Brush.Error}" Text="{Binding RenameReason}" IsVisible="{Binding HasRenameReason}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
          <Button x:Name="ServiceTileRenameSave" Classes="command-control primary" Content="{Binding Text.RenameSave}" IsEnabled="{Binding CanSaveRename}" Click="OnRenameSave" />
          <Button x:Name="ServiceTileRenameCancel" Content="{Binding Text.Cancel}" Click="OnRenameCancel" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="ServiceTileLastUsed" Classes="caption subtle" Text="{Binding LastUsedText}" IsVisible="{Binding IsConnected}" AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="ServiceTileAttention" Classes="caption" Foreground="{DynamicResource Brush.Attention}" Text="{Binding ReasonText}" IsVisible="{Binding HasReason}" TextWrapping="Wrap" ToolTip.Tip="{Binding ReasonTip}" />

      <StackPanel x:Name="ServiceTileInput" Spacing="{StaticResource Space.XS}" IsVisible="{Binding IsAsking}">
        <TextBox x:Name="ServiceTileClientId" Text="{Binding ClientId, Mode=TwoWay}" PlaceholderText="{Binding Text.TileClientLabel}" IsVisible="{Binding NeedsClientId}" AutomationProperties.Name="{Binding Text.TileClientLabel}" />
        <TextBox x:Name="ServiceTileClientSecret" PasswordChar="●" Text="{Binding ClientSecret.Text, Mode=TwoWay}" PlaceholderText="{Binding Text.TileSecretLabel}" IsVisible="{Binding NeedsSecret}" AutomationProperties.Name="{Binding Text.TileSecretLabel}" />
        <TextBox x:Name="ServiceTileToken" PasswordChar="●" Text="{Binding Token.Text, Mode=TwoWay}" PlaceholderText="{Binding Text.TileTokenLabel}" IsVisible="{Binding TakesToken}" AutomationProperties.Name="{Binding Text.TileTokenLabel}" />
        <TextBlock x:Name="ServiceTileHelp" Classes="caption subtle" Text="{Binding HelpText}" TextWrapping="Wrap" />
        <Button x:Name="ServiceTileHelpLink" Content="{Binding HelpLinkText}" IsVisible="{Binding HasHelpLink}" Click="OnHelp" HorizontalAlignment="Left" />
        <TextBlock x:Name="ServiceTileReason" Classes="caption subtle" Text="{Binding BlockedReason}" IsVisible="{Binding HasBlockedReason}" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock x:Name="ServiceTileStatus" Classes="caption" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
      <TextBlock x:Name="ServiceTileError" Classes="caption" Foreground="{DynamicResource Brush.Error}" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
        <Button x:Name="ServiceTilePrimary" Classes="command-control primary" Content="{Binding PrimaryText}" IsVisible="{Binding HasPrimary}" IsEnabled="{Binding CanPress}" Click="OnPrimary" ToolTip.Tip="{Binding BlockedReason}" />
        <Button x:Name="ServiceTileCancel" Content="{Binding Text.Cancel}" IsVisible="{Binding IsAsking}" Click="OnCancel" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
