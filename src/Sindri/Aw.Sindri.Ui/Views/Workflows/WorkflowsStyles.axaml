<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- One state cell's width on the Workflows page: wide enough for a state name and "r3/3 desk", the same under the head and in every row. -->
    <x:Double x:Key="Size.StageCell">96</x:Double>
  </Styles.Resources>
  <!-- The Workflows strip's rows while the views are stale: marked by a muted background, kept, the text never faded (screens spec §4.1, WCAG 1.4.3). Tokens only. -->
  <Style Selector="Border.strip-row.stale">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
  <!-- The Workflows page (screens spec §4.2): a stale row is marked like the strip's; the column heads sit on a hairline; the group header and the
       finished line are quiet full-width buttons; the state the instance is in reads stronger than the rest. Tokens only. -->
  <Style Selector="Border.workflow-row.stale">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
  <Style Selector="Border.column-heads">
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <!-- The list's group row (F3 workflows spec §2 "List"): 32 high on Surface2, a hairline under it. Its toggle and recipe link sit inside. -->
  <Style Selector="Border.group-row">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,1,0,1" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0,0,16,0" />
  </Style>
  <Style Selector="Border.group-row Button.group-toggle">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,6" />
  </Style>
  <!-- A list row: hover on Surface2; selected is the shared item-row look. -->
  <Style Selector="Border.workflow-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
  <Style Selector="Button.group-toggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <!-- The board (F3 workflows spec §2): lanes on Surface1 (Merge and Done on the canvas), a Surface2 head on a hairline; a run card on Surface2
       that lifts its border under the pointer, and when selected sits on Surface3 with a PrimaryHover border (not colour alone: the focus ring is
       2 px). The empty box is dashed in HairlineStrong. Tokens only. -->
  <Style Selector="Border.lane">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.lane.last">
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
  </Style>
  <Style Selector="Border.lane-head">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,10,12,8" />
  </Style>
  <Style Selector="StackPanel.lane-empty">
    <Setter Property="Margin" Value="12,20" />
  </Style>
  <Style Selector="Border.run-card">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Border.run-card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
  </Style>
  <Style Selector="Border.run-card.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryHover}" />
  </Style>
  <Style Selector="Border.run-card:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryHover}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="9" />
  </Style>
  <Style Selector="Border.run-card.stale">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
  </Style>
  <!-- The view switch and the filter segments: a Surface2 track, 28 px items, the chosen one on Surface3 with a hairline. -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
  </Style>
  <!-- The run drawer (F3 workflows spec §2): Surface1 with a left hairline, 40 px chrome, a header and a callout by status (attention, error, violet for
       "you took over", Surface2 otherwise), a sticky-looking STAGES caption and 40 px stage rows. Tokens only. -->
  <Style Selector="Border.inspector">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Border.inspector-chrome">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.inspector-head">
    <Setter Property="Padding" Value="16" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.inspector-foot">
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Button.inspector-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.inspector-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
  <Style Selector="Button.reference">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.XS}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Border.callout">
    <Setter Property="Margin" Value="16,16,16,0" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.callout.attn">
    <Setter Property="Background" Value="{DynamicResource Brush.AttentionSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Attention}" />
  </Style>
  <Style Selector="Border.callout.fail">
    <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
  </Style>
  <Style Selector="Border.callout.violet">
    <Setter Property="Background" Value="{DynamicResource Brush.VioletSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Violet}" />
  </Style>
  <Style Selector="Border.inspector-stages-head">
    <Setter Property="Margin" Value="0,16,0,0" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.stage-row">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.stage-row.current">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
  <Style Selector="Border.stage-index">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
  </Style>
  <Style Selector="TextBlock.current">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- The type filter is a plain choice list: the combo box's hidden edit field takes no focus, no pointer and no place in the control view. -->
  <Style Selector="ComboBox#RecipeFilter /template/ TextBox#PART_EditableTextBox">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
  </Style>
</Styles>
