<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="using:Aw.Sindri.Ui.ViewModels.Workflows"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             x:Class="Aw.Sindri.Ui.Views.Workflows.RunInspectorView"
             x:DataType="wf:RunInspectorViewModel">
  <!-- The run drawer (F3 workflows spec §2): page-local, on its own column. Chrome (close, previous, next, position, copy reference), the header with
       the run's one status and its actions, a callout by status, the stage list, and the reference note. Nothing is approved here: every action only
       asks the shell to open the run. -->
  <Border x:Name="WorkflowsInspector" Classes="inspector" AutomationProperties.Name="{Binding DetailsName}" AutomationProperties.AccessibilityView="Control"
          AutomationProperties.ControlTypeOverride="Group">
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="inspector-chrome">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
          <Button x:Name="InspectorClose" Classes="inspector-button" Click="OnClose" AutomationProperties.Name="{Binding CloseText}">
            <icons:StateIcon Icon="Close" AutomationProperties.AccessibilityView="Raw" />
          </Button>
          <Button x:Name="InspectorPrevious" Grid.Column="1" Classes="inspector-button" Click="OnPrevious" IsEnabled="{Binding CanPrevious}" AutomationProperties.Name="{Binding PreviousText}">
            <TextBlock Classes="caption" Text="{Binding PreviousText}" AutomationProperties.AccessibilityView="Raw" />
          </Button>
          <Button x:Name="InspectorNext" Grid.Column="2" Classes="inspector-button" Click="OnNext" IsEnabled="{Binding CanNext}" AutomationProperties.Name="{Binding NextText}">
            <TextBlock Classes="caption" Text="{Binding NextText}" AutomationProperties.AccessibilityView="Raw" />
          </Button>
          <TextBlock x:Name="InspectorPosition" Grid.Column="3" Classes="caption mono subtle" Text="{Binding PositionText}" VerticalAlignment="Center" Margin="8,0" AutomationProperties.Name="{Binding PositionText}" />
          <Button x:Name="InspectorCopyReference" Grid.Column="4" Classes="inspector-button" Click="OnCopyReference" AutomationProperties.Name="{Binding CopyReferenceText}">
            <TextBlock Classes="caption" Text="{Binding CopyReferenceText}" AutomationProperties.AccessibilityView="Raw" />
          </Button>
        </Grid>
      </Border>
      <Border DockPanel.Dock="Bottom" Classes="inspector-foot">
        <TextBlock x:Name="InspectorFootnote" Classes="caption subtle" Text="{Binding ReferenceNote}" TextWrapping="Wrap" AutomationProperties.Name="{Binding ReferenceNote}" />
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Classes="inspector-head">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:StatusBadge x:Name="InspectorStatus" Status="{Binding Status}" />
                <Border Classes="pill"><TextBlock Classes="caption muted" Text="{Binding WorkflowName}" AutomationProperties.AccessibilityView="Raw" /></Border>
              </StackPanel>
              <TextBlock x:Name="InspectorTitle" Classes="detail-title" Text="{Binding Title}" TextWrapping="Wrap" />
              <TextBlock x:Name="InspectorMeta" Classes="caption muted" Text="{Binding Meta}" TextWrapping="Wrap" />
              <Button x:Name="InspectorReference" Classes="reference" Click="OnCopyReference" HorizontalAlignment="Left" AutomationProperties.Name="{Binding CopyReferenceText}">
                <TextBlock Classes="caption mono" Text="{Binding Reference}" AutomationProperties.AccessibilityView="Raw" />
              </Button>
              <WrapPanel Margin="0,6,0,0">
                <Button x:Name="InspectorOpenRun" Classes="command-control primary" Click="OnOpenRun" Margin="0,0,8,8" AutomationProperties.Name="{Binding OpenText}">
                  <TextBlock Classes="button" Text="{Binding OpenText}" AutomationProperties.AccessibilityView="Raw" />
                </Button>
                <Button x:Name="InspectorTakeOver" Classes="command-control" Click="OnTakeOver" IsVisible="{Binding CanTakeOver}" Margin="0,0,8,8" AutomationProperties.Name="{Binding TakeOverText}">
                  <TextBlock Classes="button" Text="{Binding TakeOverText}" AutomationProperties.AccessibilityView="Raw" />
                </Button>
                <Button x:Name="InspectorCancel" Classes="command-control" Click="OnCancel" IsVisible="{Binding CanCancel}" Margin="0,0,8,8" AutomationProperties.Name="{Binding CancelText}">
                  <TextBlock Classes="button" Text="{Binding CancelText}" AutomationProperties.AccessibilityView="Raw" />
                </Button>
              </WrapPanel>
              <TextBlock x:Name="InspectorTakeOverLine" Classes="caption muted" Text="{Binding TakeOverLine}" TextWrapping="Wrap" IsVisible="{Binding HasTakeOverLine}"
                         AutomationProperties.Name="{Binding TakeOverLine}" />
              <TextBlock x:Name="InspectorTakeOverCommand" Classes="caption mono" Text="{Binding TakeOverCommand}" TextWrapping="Wrap" IsVisible="{Binding HasTakeOverCommand}"
                         AutomationProperties.Name="{Binding TakeOverCommand}" />
            </StackPanel>
          </Border>

          <Border x:Name="InspectorCallout" Classes="callout" IsVisible="{Binding HasCallout}"
                  Classes.attn="{Binding Callout.Class, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=attn}"
                  Classes.fail="{Binding Callout.Class, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=fail}"
                  Classes.violet="{Binding Callout.Class, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=violet}"
                  AutomationProperties.Name="{Binding Callout.Title}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:StateIcon Icon="{Binding Callout.Icon}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Classes="body-strong" Text="{Binding Callout.Title}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
              </StackPanel>
              <TextBlock Classes="caption muted" Text="{Binding Callout.Body}" TextWrapping="Wrap" IsVisible="{Binding Callout.Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <WrapPanel>
                <Button x:Name="InspectorReview" Classes="command-control primary" Click="OnReview" IsVisible="{Binding HasReview}" Margin="0,4,8,0" AutomationProperties.Name="{Binding ReviewDecideText}">
                  <TextBlock Classes="button" Text="{Binding ReviewDecideText}" AutomationProperties.AccessibilityView="Raw" />
                </Button>
                <Button x:Name="InspectorTerminal" Classes="command-control" Click="OnTerminal" IsVisible="{Binding HasTerminal}" Margin="0,4,8,0" AutomationProperties.Name="{Binding TerminalText}">
                  <TextBlock Classes="button" Text="{Binding TerminalText}" AutomationProperties.AccessibilityView="Raw" />
                </Button>
                <Button x:Name="InspectorHandBack" Classes="command-control" Click="OnHandBack" IsVisible="{Binding CanHandBack}" Margin="0,4,8,0" AutomationProperties.Name="{Binding HandBackText}">
                  <TextBlock Classes="button" Text="{Binding HandBackText}" AutomationProperties.AccessibilityView="Raw" />
                </Button>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Classes="inspector-stages-head">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="eyebrow" Text="{Binding StagesEyebrow}" AutomationProperties.AccessibilityView="Raw" />
              <TextBlock x:Name="InspectorStagesDone" Grid.Column="1" Classes="caption subtle" Text="{Binding StagesDoneText}" AutomationProperties.Name="{Binding StagesDoneText}" />
            </Grid>
          </Border>
          <ItemsControl x:Name="InspectorStages" ItemsSource="{Binding Stages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="wf:InspectorStageViewModel">
                <Border Classes="stage-row" Classes.current="{Binding IsCurrent}" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control"
                        AutomationProperties.ControlTypeOverride="ListItem">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="stage-index" VerticalAlignment="Top"><TextBlock Classes="caption muted" Text="{Binding IndexText}" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" /></Border>
                    <StackPanel Grid.Column="1" Margin="10,0">
                      <TextBlock Classes="body-strong" Text="{Binding Name}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                      <TextBlock Classes="caption muted" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                      <TextBlock Classes="caption subtle" Text="{Binding Time}" IsVisible="{Binding HasTime}" HorizontalAlignment="Right" AutomationProperties.AccessibilityView="Raw" />
                      <ctl:StatusBadge Status="{Binding Status}" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
