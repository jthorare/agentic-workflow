<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="using:Aw.Sindri.Ui.ViewModels.Workflows"
             xmlns:wfv="using:Aw.Sindri.Ui.Views.Workflows"
             x:Class="Aw.Sindri.Ui.Views.Workflows.RecipeGroup"
             x:DataType="wf:RecipeGroupViewModel">
  <!-- One workflow's group (screens spec §4.2): a header with the workflow's name and its run count, which collapses the rows ("show all" brings them
       back), then the rows. -->
  <StackPanel>
    <Border Classes="group-row">
    <Grid ColumnDefinitions="*,Auto">
      <Button x:Name="WorkflowGroupToggle" Classes="group-toggle" Click="OnToggle" AutomationProperties.Name="{Binding ToggleName}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="body-strong" Text="{Binding Name}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Classes="caption subtle" Text="{Binding CountText}" AutomationProperties.AccessibilityView="Raw" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="caption subtle" Text="{Binding ShowAllText}" AutomationProperties.AccessibilityView="Raw" />
        </Grid>
      </Button>
      <!-- A button cannot sit inside the toggle, so the recipe link is its own control beside it. -->
      <Button x:Name="WorkflowGroupRecipe" Grid.Column="1" Content="{Binding RecipeLinkText}" Click="OnRecipe" VerticalAlignment="Center" Margin="8,0,0,0"
              AutomationProperties.Name="{Binding RecipeLinkName}" />
    </Grid>
    </Border>
    <ItemsControl x:Name="WorkflowGroupRows" ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="wf:InstanceRowViewModel">
          <wfv:InstanceRow />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
