<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels"
             xmlns:wf="using:Aw.Sindri.Ui.ViewModels.Workflows"
             xmlns:wv="using:Aw.Sindri.Ui.Views.Workflows"
             xmlns:controls="using:Aw.Sindri.Ui.Views.Controls"
             x:Class="Aw.Sindri.Ui.Views.Workflows.WorkflowsPage"
             x:DataType="wf:WorkflowsPageViewModel">
  <!-- The Workflows page, read-only (#2258 PR 17 part 1), three levels in one place: the workflow list, one workflow's runs, one run's detail. Back goes up a level.
       Every status is a glyph and a word. Every named line is a Border wrapper (a TextBlock's peer ignores AutomationProperties.Name). -->
  <UserControl.Styles>
    <Style Selector="TextBlock.invalid"><Setter Property="Foreground" Value="{DynamicResource Brush.Error}" /></Style>
    <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" /></Style>
  </UserControl.Styles>
  <StackPanel x:Name="WorkflowsRoot" Spacing="{StaticResource Size.PanelGap}">
    <Grid ColumnDefinitions="*,Auto">
      <!-- Auto / Auto / * / Auto: the crumb and slash never shrink, the title takes what is left and ends in an ellipsis (its full text is the tooltip); the counts or state sit in the last column. -->
      <Grid x:Name="WorkflowsHeadRegion" ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
        <!-- The crumb and the slash are top-aligned and WorkflowsPage.AlignCrumb sets their top margin from the measured baselines: Avalonia has no baseline
             alignment, and 13 px text centred beside the 24 px title sits 4 px above its baseline (6 px at text scale 1.3), too far for the equal line box trick below. -->
        <Button x:Name="WorkflowsBack" Classes="link" Content="{Binding CrumbText}" Click="OnBack" IsVisible="{Binding !IsList}" VerticalAlignment="Top" Margin="0,0,12,0" AutomationProperties.Name="{Binding CrumbText}" />
        <TextBlock x:Name="WorkflowsCrumbSep" Grid.Column="1" Classes="caption subtle" Text="›" IsVisible="{Binding !IsList}" VerticalAlignment="Top" Margin="0,0,12,0" AutomationProperties.AccessibilityView="Raw" />
        <!-- The state sits right after the title, not at the far edge; the title column is a star, so the title trims to what the state leaves. -->
        <Grid Grid.Column="2" ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
          <TextBlock x:Name="WorkflowsTitle" HorizontalAlignment="Left" Classes="page-title" Text="{Binding PageTitle}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PageTitle}" VerticalAlignment="Top" AutomationProperties.Name="{Binding PageTitle}" />
          <TextBlock x:Name="WorkflowsState" Grid.Column="1" Margin="12,0,0,0" Classes="caption subtle" Text="{Binding DetailStateText}" IsVisible="{Binding ShowsDetailState}" VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="WorkflowsHead" Grid.Column="3" Margin="12,0,0,0" Classes="caption subtle" Text="{Binding Head}" IsVisible="{Binding ShowsListHead}" VerticalAlignment="Center" />
      </Grid>
      <Button x:Name="WorkflowsNewHeader" Grid.Column="1" Content="{Binding NewWorkflowText}" Click="OnNewWorkflow" Margin="12,0,0,0" IsVisible="{Binding ShowsHeaderNew}" IsEnabled="{Binding CanOpenCreate}"
              ToolTip.Tip="{Binding NewWorkflowTip}" VerticalAlignment="Top" AutomationProperties.Name="{Binding NewWorkflowText}" />
    </Grid>

    <!-- Level 1: the workflows. -->
    <StackPanel x:Name="WorkflowsListLevel" Spacing="{StaticResource Size.PanelGap}" IsVisible="{Binding IsList}">
      <Border x:Name="WorkflowsPurposeName" AutomationProperties.Name="{Binding Purpose}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body muted" Text="{Binding Purpose}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Border x:Name="WorkflowsPanel" Classes="panel" AutomationProperties.Name="{Binding Title}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
        <StackPanel>
          <Border x:Name="WorkflowsReadingName" Margin="16,8" IsVisible="{Binding IsReading}" AutomationProperties.Name="{Binding ReadingText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="caption quiet" Text="{Binding ReadingText}" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <Border x:Name="WorkflowsUnreadableName" Margin="16,8" IsVisible="{Binding IsUnreadable}" AutomationProperties.Name="{Binding UnreadableText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="caption quiet" Text="{Binding UnreadableText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <StackPanel x:Name="WorkflowsFailed" Margin="16,8" Spacing="8" IsVisible="{Binding IsFailed}">
            <Border x:Name="WorkflowsFailedName" AutomationProperties.Name="{Binding FailedText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
              <TextBlock Classes="caption quiet" Text="{Binding FailedText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <Button x:Name="WorkflowsRetry" Content="{Binding RetryText}" Click="OnRetry" HorizontalAlignment="Left" AutomationProperties.Name="{Binding RetryText}" />
          </StackPanel>
          <StackPanel x:Name="WorkflowsCreateForm" Margin="16,12" MaxWidth="420" HorizontalAlignment="Left" Spacing="{StaticResource Space.XS}" IsVisible="{Binding ShowsCreateForm}">
            <TextBlock Classes="caption subtle" Text="{Binding NewNameLabel}" AutomationProperties.AccessibilityView="Raw" />
            <TextBox x:Name="WorkflowsNewName" Text="{Binding NewName, Mode=TwoWay}" KeyDown="OnCreateKey" AutomationProperties.Name="{Binding NewNameLabel}" />
            <TextBlock Classes="caption subtle" Text="{Binding ShortIdLabel}" AutomationProperties.AccessibilityView="Raw" />
            <TextBox x:Name="WorkflowsNewShortId" Classes="mono" Classes.invalid="{Binding ShortIdInvalid}" Text="{Binding NewSlug, Mode=TwoWay}" KeyDown="OnCreateKey" AutomationProperties.Name="{Binding ShortIdLabel}" />
            <TextBlock Classes="caption subtle" Text="{Binding TemplateLabel}" AutomationProperties.AccessibilityView="Raw" />
            <ComboBox x:Name="WorkflowsNewTemplate" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding TemplateLabel}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TemplateChoice">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="caption subtle" Text="{Binding SelectedDescription}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
            <Border x:Name="WorkflowsNewReason" AutomationProperties.Name="{Binding CreateReasonText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" IsVisible="{Binding ShowsCreateReason}">
              <TextBlock Classes="caption subtle" Classes.invalid="{Binding CreateReasonIsError}" Text="{Binding CreateReasonText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <Border x:Name="WorkflowsCreateError" AutomationProperties.Name="{Binding CreateError}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" IsVisible="{Binding HasCreateError}"
                    ToolTip.Tip="{Binding CreateErrorCode}">
              <TextBlock Classes="caption invalid" Text="{Binding CreateError}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
              <Button x:Name="WorkflowsCreate" Classes="accent" Content="{Binding CreateText}" Click="OnCreate" IsEnabled="{Binding CanCreate}" AutomationProperties.Name="{Binding CreateText}" />
              <Button x:Name="WorkflowsCreateCancel" Content="{Binding CancelCreateText}" Click="OnCancelCreate" AutomationProperties.Name="{Binding CancelCreateText}" />
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="WorkflowsStalled" Margin="16,12" Spacing="{StaticResource Space.XS}" IsVisible="{Binding ViewsStalled}">
            <Border x:Name="WorkflowsStalledName" AutomationProperties.Name="{Binding StalledText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
              <TextBlock Classes="body muted" Text="{Binding StalledText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <Panel IsVisible="{Binding HasRebuild}" HorizontalAlignment="Left">
              <controls:CommandControl x:Name="WorkflowsRebuild" DataContext="{Binding Rebuild}" />
            </Panel>
          </StackPanel>
          <StackPanel x:Name="WorkflowsEmpty" Margin="{StaticResource Space.LG.Thickness}" Spacing="{StaticResource Space.XS}" HorizontalAlignment="Center" IsVisible="{Binding ShowsEmpty}">
            <Border x:Name="WorkflowsEmptyName" HorizontalAlignment="Center" AutomationProperties.Name="{Binding EmptyText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
              <TextBlock Classes="body muted" Text="{Binding EmptyText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <Button x:Name="WorkflowsNew" Classes="accent" HorizontalAlignment="Center" Content="{Binding NewWorkflowText}" Click="OnNewWorkflow" IsVisible="{Binding !IsCreating}" AutomationProperties.Name="{Binding NewWorkflowText}" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XXS}" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
              <TextBlock Classes="caption subtle" Text="{Binding AgentRouteLead}" VerticalAlignment="Center" />
              <TextBlock x:Name="WorkflowsAgentCommand" Classes="caption mono" Text="{Binding AgentRouteCommand}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <ItemsControl x:Name="WorkflowRows" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="wf:WorkflowRowViewModel">
                <Border Classes="item-row clickable" Focusable="True" KeyDown="OnWorkflowRowKey" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" MinHeight="{StaticResource Row.Height.Default}" Margin="0,8" VerticalAlignment="Center">
                    <!-- The row is the one focus stop and draws the ring; the title is a click target only, so it draws none of its own (Enter or Space on the row opens it).
                         Margin="-2,0": the shared row-title style pulls the button up 2 px for a ring this one never draws (QueueStyles.axaml:40-42), which put the title under 8 px from the row's top; keep the sideways -2 so the text lines up. -->
                    <Button Classes="row-title" Focusable="False" Margin="-2,0" Click="OnOpenWorkflow" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Name}">
                      <TextBlock Classes="body-strong" Text="{Binding NameText}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                    <controls:StateChipView Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Word="{Binding ChipWord}" Tone="{Binding ChipToneWord}" Glyph="{Binding ChipGlyph}" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" AutomationProperties.AccessibilityView="Raw">
                      <TextBlock Classes="caption subtle mono" Text="{Binding IdText}" IsVisible="{Binding HasIdText}" />
                      <TextBlock Classes="caption subtle" Text="{Binding RevisionText}" IsVisible="{Binding HasRevisionText}" />
                      <TextBlock Classes="caption subtle" Text="{Binding ChangedText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Level 2: one workflow's runs, newest first. -->
    <StackPanel x:Name="WorkflowRunsLevel" Spacing="{StaticResource Size.PanelGap}" IsVisible="{Binding IsRuns}">
      <!-- One row, every item centred on it: the title used to stay top-aligned (Stretch) and sat 3 px above the status text and the buttons (#2689).
           Avalonia has no baseline alignment, so the smaller status text takes the title's line height (as Health's labels do, R12): centred on equal line boxes
           its baseline lands within a pixel of the title's and the buttons' text, at any text scale. -->
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock x:Name="RunsHead" Classes="caption subtle" LineHeight="{DynamicResource Type.BodyStrong.LineHeight}" Text="{Binding Runs.Head}" VerticalAlignment="Center" />
        <Button x:Name="RunNow" VerticalAlignment="Center" Content="{Binding Runs.RunNowText}" Click="OnRunNow" IsEnabled="{Binding Runs.CanPressRunNow}" AutomationProperties.Name="{Binding Runs.RunNowText}" />
        <Button x:Name="WorkflowEdit" VerticalAlignment="Center" IsVisible="{Binding ShowsEdit}" Content="{Binding EditText}" Click="OnEdit" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding EditText}" />
        <Button x:Name="WorkflowActivate" VerticalAlignment="Center" IsVisible="{Binding ShowActivateButton}" Content="{Binding ActivateText}" Click="OnActivate" AutomationProperties.AutomationId="WorkflowActivate" AutomationProperties.Name="{Binding ActivateText}" />
        <Button x:Name="WorkflowPause" VerticalAlignment="Center" IsVisible="{Binding CanPause}" Content="{Binding PauseText}" Click="OnPause" AutomationProperties.AutomationId="WorkflowPause" AutomationProperties.Name="{Binding PauseText}" />
      </StackPanel>
      <Border x:Name="RunsNoticeName" IsVisible="{Binding Runs.HasNotice}" AutomationProperties.Name="{Binding Runs.NoticeText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="caption" Text="{Binding Runs.NoticeText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Border x:Name="StateNotice" IsVisible="{Binding HasStateNotice}" AutomationProperties.Name="{Binding StateNoticeText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="caption" Text="{Binding StateNoticeText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <!-- After a save (#3303): the new revision is saved and the live one is unchanged, or the workflow is off. -->
      <StackPanel x:Name="SavedLine" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding HasSavedLine}">
        <Border x:Name="SavedLineName" VerticalAlignment="Center" AutomationProperties.Name="{Binding SavedLineText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="caption" Text="{Binding SavedLineText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Button x:Name="WorkflowMakeLive" VerticalAlignment="Center" IsVisible="{Binding CanMakeLive}" Content="{Binding MakeLiveText}" Click="OnMakeLive" AutomationProperties.AutomationId="WorkflowMakeLive" AutomationProperties.Name="{Binding MakeLiveText}" />
      </StackPanel>
      <wv:WorkflowEditorSheet x:Name="WorkflowEditor" IsVisible="{Binding IsSettingsOpen}" />
      <TextBlock x:Name="RunsDetail" Classes="caption subtle" Text="{Binding Runs.DetailText}" TextWrapping="Wrap" />
      <!-- The graph at the positions Sindri served (the app lays nothing out); a node with no position is named, not drawn. -->
      <StackPanel x:Name="RunsGraph" Spacing="4" IsVisible="{Binding Runs.Graph, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid x:Name="RunsEditPanel" ColumnDefinitions="*,Auto" IsVisible="{Binding IsEditing}">
          <wv:GraphEditBar x:Name="RunsEdit" DataContext="{Binding GraphEdit}" />
          <Button x:Name="WorkflowEditDone" Grid.Column="1" VerticalAlignment="Top" Content="{Binding DoneText}" Click="OnDone" AutomationProperties.Name="{Binding DoneText}" />
        </Grid>
        <Border Classes="panel" Height="320">
          <wv:GraphCanvas x:Name="RunsCanvas" Graph="{Binding Runs.Graph}" />
        </Border>
        <!-- What the selected step is and does, read-only, while Edit is off (#2807). It shows for every workflow, archived too; only Step settings needs edit rights. -->
        <StackPanel x:Name="StepRow" Orientation="Horizontal" Spacing="12" IsVisible="{Binding ShowsStepRow}">
          <Border x:Name="StepSummary" VerticalAlignment="Center" IsVisible="{Binding HasStepSummary}" AutomationProperties.Name="{Binding StepSummaryText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="caption" Text="{Binding StepSummaryText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <Button x:Name="StepSettings" VerticalAlignment="Center" IsVisible="{Binding CanOpenSettings}" Content="{Binding StepSettingsText}" Click="OnStepSettings" AutomationProperties.Name="{Binding StepSettingsText}" />
        </StackPanel>
        <Border x:Name="RunsUnplacedName" IsVisible="{Binding Runs.Graph.HasUnplaced}" AutomationProperties.Name="{Binding Runs.Graph.UnplacedText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="caption subtle" Text="{Binding Runs.Graph.UnplacedText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
      </StackPanel>
      <Border x:Name="RunsPanel" Classes="panel" AutomationProperties.Name="{Binding Runs.Title}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
        <StackPanel>
          <Border x:Name="RunsReadingName" Margin="16,8" IsVisible="{Binding Runs.IsReading}" AutomationProperties.Name="{Binding Runs.ReadingText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="caption quiet" Text="{Binding Runs.ReadingText}" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <StackPanel x:Name="RunsFailed" Margin="16,8" Spacing="8" IsVisible="{Binding Runs.IsFailed}">
            <Border x:Name="RunsFailedName" AutomationProperties.Name="{Binding Runs.FailedText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
              <TextBlock Classes="caption quiet" Text="{Binding Runs.FailedText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <Button x:Name="RunsRetry" Content="{Binding Runs.RetryText}" Click="OnRetryRuns" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Runs.RetryText}" />
          </StackPanel>
          <Border x:Name="RunsEmptyName" Margin="16,8" IsVisible="{Binding Runs.IsEmpty}" AutomationProperties.Name="{Binding Runs.EmptyText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="caption quiet" Text="{Binding Runs.EmptyText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <ItemsControl x:Name="RunRows" ItemsSource="{Binding Runs.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="wf:RunRowViewModel">
                <Border Classes="item-row clickable" Focusable="True" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" MinHeight="{StaticResource Row.Height.Default}" Margin="0,8" VerticalAlignment="Center">
                    <!-- The same vertical padding and title margin as a workflow list row (#2700): the shared row-title style's -2 would otherwise pull the title up out of the row's padding. -->
                    <Button Classes="row-title" Margin="-2,0" Click="OnOpenRun" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Name}">
                      <TextBlock Classes="body-strong mono" Text="{Binding Id}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                    <controls:StateChipView Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Word="{Binding ChipWord}" Tone="{Binding ChipToneWord}" Glyph="{Binding ChipGlyph}" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" AutomationProperties.AccessibilityView="Raw">
                      <TextBlock Classes="caption subtle" Text="{Binding TriggerText}" />
                      <TextBlock Classes="caption subtle" Text="{Binding RevisionText}" />
                      <TextBlock Classes="caption subtle" Text="{Binding WhenText}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="caption" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Margin="0,0,0,8" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Level 3: one run, every node with its input, output and error. -->
    <StackPanel x:Name="WorkflowRunLevel" Spacing="{StaticResource Size.PanelGap}" IsVisible="{Binding IsRun}">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <controls:StateChipView x:Name="RunChipName" Word="{Binding Run.ChipWord}" Tone="{Binding Run.ChipToneWord}" Glyph="{Binding Run.ChipGlyph}" />
        <Button x:Name="RunCancel" Content="{Binding Run.CancelText}" Click="OnCancelRun" IsVisible="{Binding Run.CanCancel}" IsEnabled="{Binding Run.CanPressCancel}" AutomationProperties.Name="{Binding Run.CancelText}" />
      </StackPanel>
      <Border x:Name="RunNoticeName" IsVisible="{Binding Run.HasNotice}" AutomationProperties.Name="{Binding Run.NoticeText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="caption" Text="{Binding Run.NoticeText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="12" AutomationProperties.AccessibilityView="Raw">
        <TextBlock Classes="caption subtle" Text="{Binding Run.TriggerText}" />
        <TextBlock Classes="caption subtle" Text="{Binding Run.RevisionText}" />
        <TextBlock Classes="caption subtle" Text="{Binding Run.WhenText}" />
      </StackPanel>
      <Border x:Name="RunReadingName" IsVisible="{Binding Run.IsReading}" AutomationProperties.Name="{Binding Run.ReadingText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="caption quiet" Text="{Binding Run.ReadingText}" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <StackPanel x:Name="RunFailed" Spacing="8" IsVisible="{Binding Run.IsFailed}">
        <Border x:Name="RunFailedName" AutomationProperties.Name="{Binding Run.FailedText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="caption quiet" Text="{Binding Run.FailedText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Button x:Name="RunRetry" Content="{Binding Run.RetryText}" Click="OnRetryRun" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Run.RetryText}" />
      </StackPanel>
      <Border x:Name="RunErrorName" IsVisible="{Binding Run.HasError}" AutomationProperties.Name="{Binding Run.ErrorText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <SelectableTextBlock Classes="caption" Text="{Binding Run.ErrorText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <StackPanel x:Name="RunOutputs" Spacing="4" IsVisible="{Binding Run.HasOutputs}">
        <TextBlock Classes="caption subtle" Text="{Binding Run.OutputsHeading}" />
        <SelectableTextBlock Classes="mono" Text="{Binding Run.OutputsText}" TextWrapping="Wrap" />
      </StackPanel>
      <!-- The graph at the positions Sindri served (the app lays nothing out); a node with no position is named, not drawn. -->
      <StackPanel x:Name="RunGraph" Spacing="4" IsVisible="{Binding Run.Graph, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border Classes="panel" Height="320">
          <wv:GraphCanvas x:Name="RunCanvas" Graph="{Binding Run.Graph}" />
        </Border>
        <Border x:Name="RunUnplacedName" IsVisible="{Binding Run.Graph.HasUnplaced}" AutomationProperties.Name="{Binding Run.Graph.UnplacedText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="caption subtle" Text="{Binding Run.Graph.UnplacedText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
      </StackPanel>
      <ItemsControl x:Name="RunGroups" ItemsSource="{Binding Run.Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="wf:NodeGroupViewModel">
            <Border Classes="panel" Margin="0,0,0,8" AutomationProperties.Name="{Binding HeaderText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
              <StackPanel Spacing="8" Margin="16,8">
                <TextBlock Classes="body-strong" Text="{Binding HeaderText}" />
                <ItemsControl ItemsSource="{Binding Runs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="wf:NodeRunViewModel">
                      <Border Classes="item-row clickable" Focusable="True" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
                        <StackPanel Spacing="4" Margin="0,4">
                          <StackPanel Orientation="Horizontal" Spacing="12" AutomationProperties.AccessibilityView="Raw">
                            <TextBlock Classes="body-strong" Text="{Binding TitleText}" />
                            <controls:StateChipView Word="{Binding ChipWord}" Tone="{Binding ChipToneWord}" Glyph="{Binding ChipGlyph}" />
                          </StackPanel>
                          <Button HorizontalAlignment="Left" Content="{Binding TakeOverText}" Click="OnTakeOverNode" IsVisible="{Binding CanTakeOver}" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{Binding TakeOverText}" />
                          <Button HorizontalAlignment="Left" Content="{Binding HandBackText}" Click="OnHandBackNode" IsVisible="{Binding CanHandBack}" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{Binding HandBackText}" />
                          <TextBlock Classes="caption" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                          <TextBlock Classes="caption subtle" Text="{Binding TruncatedText}" IsVisible="{Binding IsTruncated}" TextWrapping="Wrap" />
                          <StackPanel Spacing="2" IsVisible="{Binding HasInput}">
                            <TextBlock Classes="caption subtle" Text="{Binding InputHeading}" />
                            <SelectableTextBlock Classes="mono" Text="{Binding InputText}" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Spacing="2" IsVisible="{Binding HasOutput}">
                            <TextBlock Classes="caption subtle" Text="{Binding OutputHeading}" />
                            <SelectableTextBlock Classes="mono" Text="{Binding OutputText}" TextWrapping="Wrap" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
