<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="using:Aw.Sindri.Ui.ViewModels.Workflows"
             xmlns:wfv="using:Aw.Sindri.Ui.Views.Workflows"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels"
             x:Class="Aw.Sindri.Ui.Views.Workflows.WorkflowsPage"
             x:DataType="wf:WorkflowsViewModel">
  <!-- The Workflows page (screens spec §4.2): the head with the root-wide counts and the filters, then the open root runs grouped by
       workflow in the order the API serves them, the finished line collapsed under them, and the shared states. -->
  <StackPanel Spacing="{StaticResource Size.PanelGap}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Classes="page-title" Text="Workflows" AutomationProperties.Name="Workflows" />
        <TextBlock x:Name="WorkflowsHead" Classes="caption subtle" Text="{Binding Head}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Head}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="WorkflowsStart" Classes="command-control" Click="OnStart" AutomationProperties.Name="{Binding StartLabel}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="button" Text="{Binding StartLabel}" VerticalAlignment="Center" />
            <Border Classes="kbd" VerticalAlignment="Center"><TextBlock Classes="kbd" Text="N" /></Border>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- The toolbar (F3 workflows spec §2): the view switch, the workflow chip (the existing workflow filter), the search (the existing item
         filter: Enter asks the API, typing narrows what is loaded), the filter segments with their counts, and the key hints. -->
    <WrapPanel x:Name="WorkflowsToolbar" Orientation="Horizontal">
      <ListBox x:Name="WorkflowsViewSwitch" Classes="segmented" SelectedIndex="{Binding ViewIndex, Mode=TwoWay}" Margin="0,0,12,6" AutomationProperties.Name="{Binding ViewBoardText}">
        <ListBoxItem x:Name="WorkflowsViewBoardItem" AutomationProperties.Name="{Binding ViewBoardText}"><TextBlock Classes="caption" Text="{Binding ViewBoardText}" AutomationProperties.AccessibilityView="Raw" /></ListBoxItem>
        <ListBoxItem x:Name="WorkflowsViewListItem" AutomationProperties.Name="{Binding ViewListText}"><TextBlock Classes="caption" Text="{Binding ViewListText}" AutomationProperties.AccessibilityView="Raw" /></ListBoxItem>
      </ListBox>
      <ComboBox x:Name="RecipeFilter" ItemsSource="{Binding RecipeChoices}" SelectionChanged="OnRecipeChosen" PlaceholderText="{Binding RecipeFilterName}" MinWidth="180" Margin="0,0,12,6"
                AutomationProperties.Name="{Binding RecipeFilterName}" />
      <TextBox x:Name="SubjectFilter" PlaceholderText="{Binding SubjectFilterName}" KeyDown="OnSubjectKey" TextChanged="OnSubjectTyped" MinWidth="200" MaxWidth="360" Margin="0,0,12,6"
               AutomationProperties.Name="{Binding SubjectFilterName}" />
      <ListBox x:Name="WorkflowsFilter" Classes="segmented" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" Margin="0,0,12,6" AutomationProperties.Name="{Binding FilterAllText}">
        <ListBoxItem x:Name="WorkflowsFilterAllItem" AutomationProperties.Name="{Binding FilterAllText}"><TextBlock Classes="caption" Text="{Binding FilterAllText}" AutomationProperties.AccessibilityView="Raw" /></ListBoxItem>
        <ListBoxItem x:Name="WorkflowsFilterNeedsYouItem" AutomationProperties.Name="{Binding FilterNeedsYouText}"><TextBlock Classes="caption" Text="{Binding FilterNeedsYouText}" AutomationProperties.AccessibilityView="Raw" /></ListBoxItem>
        <ListBoxItem x:Name="WorkflowsFilterMineItem" AutomationProperties.Name="{Binding FilterMineText}"><TextBlock Classes="caption" Text="{Binding FilterMineText}" AutomationProperties.AccessibilityView="Raw" /></ListBoxItem>
      </ListBox>
      <TextBlock x:Name="WorkflowsKeyHints" Classes="caption subtle" Text="{Binding KeyHints}" VerticalAlignment="Center" Margin="0,0,0,6" AutomationProperties.AccessibilityView="Raw" />
    </WrapPanel>

    <StackPanel x:Name="WorkflowsPageStale" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsStale}">
      <icons:StateIcon Glyph="Stale" VerticalAlignment="Center" />
      <TextBlock Classes="caption subtle" Text="{Binding StaleText}" VerticalAlignment="Center" />
    </StackPanel>

    <!-- A key that only names a later phase (B, N) says so here, politely, and changes nothing. -->
    <TextBlock x:Name="WorkflowsKeyNote" Classes="caption" Text="{Binding KeyNote}" IsVisible="{Binding HasKeyNote}" TextWrapping="Wrap"
               AutomationProperties.Name="{Binding KeyNote}" />
    <TextBlock x:Name="WorkflowsKeyNoteAnnouncement" Classes="caption live-region" Classes.live="{Binding KeyNoteVoice.IsAnnouncing}" Width="0" Opacity="0"
               IsHitTestVisible="False" Text="{Binding KeyNoteVoice.Announcement}" />

    <TextBlock x:Name="WorkflowsNoRunsMatch" Classes="caption quiet" Text="{Binding NoRunsMatchText}" IsVisible="{Binding NoRunsMatch}" TextWrapping="Wrap"
               AutomationProperties.Name="{Binding NoRunsMatchText}" />
    <TextBlock x:Name="WorkflowsBoardEmpty" Classes="caption quiet" Text="{Binding BoardEmptyText}" IsVisible="{Binding IsBoardEmpty}" TextWrapping="Wrap"
               AutomationProperties.Name="{Binding BoardEmptyText}" />
    <TextBlock x:Name="WorkflowsBoardUnreadable" Classes="caption quiet" Text="{Binding UnreadableText}" IsVisible="{Binding IsBoardUnreadable}" TextWrapping="Wrap"
               AutomationProperties.Name="{Binding UnreadableText}" />
    <wfv:BoardView x:Name="WorkflowsBoard" IsVisible="{Binding ShowBoard}" />
    <TextBlock x:Name="WorkflowsOffBoard" Classes="caption quiet" Text="{Binding OffBoardText}" IsVisible="{Binding HasOffBoard}" TextWrapping="Wrap"
               AutomationProperties.Name="{Binding OffBoardText}" />

    <wfv:RunListView x:Name="WorkflowsList" IsVisible="{Binding IsList}" />
  </StackPanel>
</UserControl>
