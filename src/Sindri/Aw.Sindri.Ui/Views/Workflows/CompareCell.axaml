<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="using:Aw.Sindri.Ui.ViewModels.Workflows"
             xmlns:controls="using:Aw.Sindri.Ui.Views.Controls"
             x:Class="Aw.Sindri.Ui.Views.Workflows.CompareCell"
             x:DataType="wf:CompareCellViewModel">
  <!-- One run's side of a Compare step (#3683): its status and duration, the body lines with the differing ones marked, and the message; the page places it once for run A and once for run B. -->
  <Border Classes="panel" Margin="0,0,0,4">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,6" IsVisible="{Binding HasStatus}">
              <controls:StateChipView Word="{Binding StatusWord}" Tone="{Binding ToneWord}" Glyph="{Binding StatusGlyph}" />
              <TextBlock Classes="caption subtle" Text="{Binding DurationText}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="caption subtle" Text="{Binding BodyLabel}" Margin="12,4,12,0" IsVisible="{Binding HasLines}" />
            <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding HasLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="wf:CompareLineViewModel">
                  <Border Classes="cmpline" Classes.differs="{Binding Differs}" Padding="12,0">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="caption mono" Text="{Binding Text}" />
                      <TextBlock Grid.Column="1" Classes="caption compare-differs" Text="&#9670; differs" IsVisible="{Binding Differs}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="cmpline" Classes.differs="{Binding MessageDiffers}" Padding="12,6" IsVisible="{Binding HasMessage}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caption" Text="{Binding Message}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Classes="caption compare-differs" Text="&#9670; differs" IsVisible="{Binding MessageDiffers}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
</UserControl>
