<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="using:Aw.Sindri.Ui.ViewModels.Workflows"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             xmlns:wf2="using:Aw.Sindri.Ui.Views.Workflows"
             xmlns:comp="using:Aw.Sindri.Ui.Views.Components"
             x:Class="Aw.Sindri.Ui.Views.Workflows.InstanceRow"
             x:DataType="wf:InstanceRowViewModel">
  <!-- One row of the Workflows list (F3 workflows spec §2 "List"): six columns, Item (the title is a button that opens the run, the mono
       reference under it), Stage, Status (the one status badge), Step, Waiting on and Updated. The list hides columns as it narrows
       (ListBands); a hidden cell keeps its place at width 0. Everything else about a run (inputs, every stage, the address with Copy) waits
       in the run's drawer. The name is the item, the workflow, the status, the stage and who is on it. The row draws its own focus border
       (item-row), not the adorner. -->
  <Border x:Name="WorkflowRowFrame" Classes="item-row workflow-row" Classes.selected="{Binding IsSelected}" Classes.stale="{Binding IsStale}" Focusable="True"
          MinHeight="{StaticResource Size.Row}"
          AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
    <Grid x:Name="WorkflowRowGrid" ColumnDefinitions="2.2*,128,148,1.8*,124,80" VerticalAlignment="Center">
      <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
        <Button x:Name="WorkflowRowOpen" Classes="row-title" Click="OnOpen" AutomationProperties.Name="{Binding OpenName}">
          <TextBlock Classes="body-strong" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
        </Button>
        <TextBlock x:Name="WorkflowRowReference" Classes="caption mono subtle" Text="{Binding Reference}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
        <wf2:ChildAnswerButton x:Name="WorkflowChildAnswer" DataContext="{Binding ChildAnswer}"
                               IsVisible="{Binding $parent[UserControl].((wf:InstanceRowViewModel)DataContext).ChildAnswer, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <!-- A protected answer is the lock, here in the row so A (and a click) reach its popover even where the columns are hidden. -->
        <comp:ProtectedActionButton x:Name="WorkflowProtected" DataContext="{Binding Protected}" HorizontalAlignment="Left"
                                    IsVisible="{Binding $parent[UserControl].((wf:InstanceRowViewModel)DataContext).Protected, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <TextBlock x:Name="WorkflowRowStage" Grid.Column="1" Classes="caption" Text="{Binding StageName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"
                 AutomationProperties.AccessibilityView="Raw" />
      <ctl:StatusBadge x:Name="WorkflowRowStatus" Grid.Column="2" Status="{Binding Status}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0" />
      <TextBlock x:Name="WorkflowRowNow" Grid.Column="3" Classes="caption subtle" Text="{Binding Now}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"
                 AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="WorkflowRowWho" Grid.Column="4" Classes="caption subtle" Text="{Binding WaitingOn}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"
                 AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="WorkflowRowUpdated" Grid.Column="5" Classes="caption subtle" Text="{Binding UpdatedText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                 AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </Border>
</UserControl>
