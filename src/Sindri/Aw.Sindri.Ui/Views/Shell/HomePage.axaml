<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels"
             xmlns:shell="using:Aw.Sindri.Ui.ViewModels.Shell"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             xmlns:queue="using:Aw.Sindri.Ui.ViewModels.Queue"
             xmlns:nyvm="using:Aw.Sindri.Ui.ViewModels.NeedsYou"
             xmlns:nyv="using:Aw.Sindri.Ui.Views.NeedsYou"
             xmlns:rows="using:Aw.Sindri.Ui.Views.Queue"
             xmlns:tv="using:Aw.Sindri.Ui.Views.Todo"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             x:Class="Aw.Sindri.Ui.Views.Shell.HomePage"
             x:DataType="shell:ShellViewModel">
  <!-- Home (UI spec §3.2, §4.2): four panels in a fixed order. Each panel is a header row (the eyebrow over a hairline,
       home.html .phead) and a body. Running and With you, and Queued, are GET /queue's groups (U2: at most five rows, then
       "Show all N in Queue"; each group's own empty sentence, E-18); Needs you is the served list (U3'). The health strip is the status as labelled cells and opens Health. -->
  <UserControl.Styles>
    <!-- The two focus regions of Home (todo spec D6, §3.3): the one with focus draws its edge in the accent colour and its heading with it. -->
    <Style Selector="Border.panel.region-focus">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <Style Selector="TextBlock.region-focus">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
    </Style>
    <!-- The setup meter's track stays visible at 0 of 5: Surface3 vanishes on the card. -->
    <Style Selector="ProgressBar.home-meter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface4}" />
    </Style>
    <Style Selector="TextBlock.attention">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Attention}" />
    </Style>
    <!-- One accent (#2780): Primary is the nav selection and the page's ONE primary button, the first listed Needs-you row that has one (IsLeadAction, not its position). Every other row's
         primary action draws as a secondary button, and an attention tag on a Needs-you row is a neutral chip (its word still says what it is). -->
    <Style Selector="Border.needs-you-row:not(.lead) Button.command-control.primary:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Border.needs-you-row:not(.lead) Button.command-control.primary:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
    </Style>
    <Style Selector="Border.needs-you-row:not(.lead) Button.command-control.primary:pressed:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
    </Style>
    <Style Selector="Border.needs-you-row ctl|StateChipView.attn">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    </Style>
    <Style Selector="Border.needs-you-row ctl|StateChipView.attn > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.InkMuted}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="{StaticResource Size.PanelGap}">
    <TextBlock Classes="page-title" Text="{Binding Text.Home}" AutomationProperties.Name="{Binding Text.Home}" />

    <!-- The setup line (setup spec §2.4): one 40 px line above Needs you while any step is open, no card. It opens Settings at the checklist. -->
    <Border x:Name="SetupHomeLine" Classes="setup-line" IsVisible="{Binding Setup.IsHomeLineShown}">
      <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="48" ColumnSpacing="12">
        <Button x:Name="SetupHomeLink" Classes="setup-link" Click="OnSetupLink" AutomationProperties.Name="{Binding Setup.HomeLineName}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
            <TextBlock Classes="body-strong" Text="{Binding Setup.HomeLineText}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Classes="caption subtle" Text="{Binding Setup.CountText}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
          </StackPanel>
        </Button>
        <!-- F3 home spec §1 Q6: the 120 px meter after the words, done steps of all of them; the words above carry the same count. -->
        <ProgressBar x:Name="SetupHomeMeter" Grid.Column="1" Classes="map-meter home-meter" Width="120" MinWidth="0" Opacity="{Binding Setup.MeterOpacity}" VerticalAlignment="Center" Minimum="0" Maximum="{Binding Setup.MeterMax}" Value="{Binding Setup.MeterDone}" AutomationProperties.AccessibilityView="Raw" />
        <Button x:Name="SetupHomeContinue" Grid.Column="2" Classes="command-control" Click="OnSetupContinue" VerticalAlignment="Center" Margin="0,0,24,0" AutomationProperties.Name="{Binding Setup.ContinueName}">
          <TextBlock Classes="button" Text="{Binding Setup.ContinueText}" AutomationProperties.AccessibilityView="Raw" />
        </Button>
      </Grid>
    </Border>

    <!-- The Todo panel (todo spec §3.1): across both columns, above Needs you; Home's decisions filter (G D) hides it. The host carries the
         shell's flag, because the panel's own DataContext is the Todo view model. -->
    <Panel x:Name="TodoPanelHost" IsVisible="{Binding IsTodoShown}">
      <tv:TodoPanel DataContext="{Binding Todo}" />
    </Panel>

    <!-- F3 home spec §2: Needs you on the left, the wider main column; Running (the workflow strip, then With you) and Queued on the right; the health strip across the bottom.
         Under 1100 px the columns stack (HomePage.axaml.cs). -->
    <Grid x:Name="HomeColumns" ColumnDefinitions="3*,16,2*">
      <StackPanel x:Name="HomeLeft" Spacing="{StaticResource Size.PanelGap}">
        <Border x:Name="NeedsYouPanel" Classes="panel" ClipToBounds="True" Classes.region-focus="{Binding IsNeedsYouFocused}" PointerEntered="OnNeedsYouPanelEntered" PointerExited="OnNeedsYouPanelExited" AutomationProperties.Name="{Binding Text.NeedsYouPanel}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
          <StackPanel>
            <Border Classes="phead">
              <Grid ColumnDefinitions="*,Auto">
                <!-- A Grid, not a StackPanel: a horizontal StackPanel measures the summary at its full width, so in a narrow cell it was drawn under the right cell (#1061). -->
                <TextBlock Classes="section-title" Classes.region-focus="{Binding IsNeedsYouFocused}" Text="{Binding Text.NeedsYouPanel}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Text.NeedsYouPanel}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <!-- B2: "N marked seen · Undo" for 5 min after Mark all seen; the Undo button is a plain tab stop, and its words are spoken once by NeedsYouSeenLive. -->
                  <StackPanel x:Name="NeedsYouUndo" Orientation="Horizontal" Spacing="8" IsVisible="{Binding NeedsYou.Seen.UndoOffered}" VerticalAlignment="Center">
                    <TextBlock x:Name="NeedsYouUndoText" Classes="caption subtle" Text="{Binding NeedsYou.Seen.UndoText}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Classes="caption subtle" Text="·" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <Button x:Name="NeedsYouUndoButton" Classes="copy" Click="OnUndoSeen" GotFocus="OnUndoHeld" LostFocus="OnUndoReleased" PointerEntered="OnUndoHeld" PointerExited="OnUndoReleased" AutomationProperties.Name="{Binding Text.UndoMarkAllSeen}">
                      <TextBlock Classes="caption" Text="{Binding Text.Undo}" />
                    </Button>
                  </StackPanel>
                  <Button x:Name="MarkAllSeen" Classes="copy" Click="OnMarkAllSeen" IsVisible="{Binding !NeedsYou.IsEmpty}"
                          AutomationProperties.Name="{Binding Text.MarkAllSeen}">
                    <TextBlock Classes="caption" Text="{Binding Text.MarkAllSeen}" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
            <!-- Home's one display number (#2780): how many need you. Nothing at zero; the empty sentence below says so. -->
            <StackPanel x:Name="NeedsYouCountLine" Orientation="Horizontal" Spacing="8" Margin="24,16,24,8" IsVisible="{Binding Attention.NeedsYouNumber, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        AutomationProperties.Name="{Binding Attention.NeedsYouLine}">
              <TextBlock x:Name="NeedsYouNumber" Classes="display" Text="{Binding Attention.NeedsYouNumber}" VerticalAlignment="Bottom" AutomationProperties.AccessibilityView="Raw" />
              <TextBlock x:Name="NeedsYouSummary" Classes="caption subtle" Text="{Binding Attention.NeedsYouWord}" VerticalAlignment="Bottom" Margin="0,0,0,6" AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
            <TextBlock x:Name="NeedsYouBanner" Classes="caption" Text="{Binding NeedsYou.Banner}" IsVisible="{Binding NeedsYou.HasBanner}" Margin="24,8"
                       TextWrapping="Wrap" AutomationProperties.Name="{Binding NeedsYou.Banner}" />
            <Button x:Name="NeedsYouHeld" Classes="held-pill" Click="OnShowNeedsYouHeld" IsVisible="{Binding NeedsYou.HasHeld}" HorizontalAlignment="Center"
                    AutomationProperties.Name="{Binding NeedsYou.HeldText}">
              <TextBlock Classes="caption" Text="{Binding NeedsYou.HeldText}" />
            </Button>
            <ItemsControl x:Name="NeedsYouRows" ItemsSource="{Binding NeedsYou.Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="nyvm:NeedsYouRowViewModel">
                  <nyv:NeedsYouRow />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="NeedsYouSkeleton" IsVisible="{Binding NeedsYou.IsLoading}" AutomationProperties.AccessibilityView="Raw">
              <Grid Classes="skrow" ColumnDefinitions="70,*,40"><Border Classes="skeleton" Width="60" /><Border Grid.Column="1" Classes="skeleton" Width="300" /><Border Grid.Column="2" Classes="skeleton" Width="32" /></Grid>
              <Grid Classes="skrow" ColumnDefinitions="70,*,40"><Border Classes="skeleton" Width="60" /><Border Grid.Column="1" Classes="skeleton" Width="220" /><Border Grid.Column="2" Classes="skeleton" Width="32" /></Grid>
              <Grid Classes="skrow" ColumnDefinitions="70,*,40"><Border Classes="skeleton" Width="60" /><Border Grid.Column="1" Classes="skeleton" Width="260" /><Border Grid.Column="2" Classes="skeleton" Width="32" /></Grid>
            </StackPanel>
            <!-- The stack sits at 16 so Retry's text, inside its padding, lines up at 24; the caption takes 8 more to reach the card's text column (24). -->
            <StackPanel x:Name="NeedsYouFailed" Margin="16,8" Spacing="8" IsVisible="{Binding NeedsYou.HasReadError}">
              <Border x:Name="NeedsYouFailedName" Margin="8,0,0,0" AutomationProperties.Name="{Binding NeedsYou.ReadError}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                <TextBlock Classes="caption subtle" Text="{Binding NeedsYou.ReadError}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
              </Border>
              <Button x:Name="NeedsYouRetry" Content="{Binding Text.NeedsYouRetry}" Click="OnRetryNeedsYou" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text.NeedsYouRetry}" />
            </StackPanel>
            <TextBlock x:Name="NeedsYouEmpty" Classes="caption subtle" Text="{Binding NeedsYou.EmptyLine}" Margin="24,8" TextAlignment="Left"
                       IsVisible="{Binding NeedsYou.EmptyLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding NeedsYou.EmptyLine}" />
            <Button x:Name="NeedsYouShowAll" HorizontalAlignment="Left" Classes="copy" Click="OnShowAllNeedsYou" IsVisible="{Binding NeedsYou.HasOverflow}"
                    AutomationProperties.Name="{Binding NeedsYou.OverflowText}" Margin="16,8">
              <TextBlock Classes="caption" Text="{Binding NeedsYou.OverflowText}" />
            </Button>
          </StackPanel>
        </Border>

        <!-- Review page spec §16 pick 5: one line under Needs you, not counted in it; it opens Reviews. -->
        <Button x:Name="ReviewsWaitingLink" Classes="copy" HorizontalAlignment="Left" Click="OnOpenReviews" IsVisible="{Binding HasReviewsWaitingLine}"
                AutomationProperties.Name="{Binding ReviewsWaitingLine}">
          <TextBlock Classes="caption" Text="{Binding ReviewsWaitingLine}" />
        </Button>

        <!-- Linear hub spec §3, "With #2076": one more line under the PRs line; it opens Work on the Linear view. -->
        <Button x:Name="LinearNewLink" Classes="copy" HorizontalAlignment="Left" Click="OnOpenLinear" IsVisible="{Binding HasLinearNewLine}"
                AutomationProperties.Name="{Binding LinearNewLine}">
          <TextBlock Classes="caption" Text="{Binding LinearNewLine}" />
        </Button>

      </StackPanel>
      <StackPanel x:Name="HomeRight" Grid.Column="2" Spacing="{StaticResource Size.PanelGap}">

        <!-- §8: new rows wait behind this pill while the pointer is over Running or Queued. -->
        <Button x:Name="HomeHeldPill" Classes="held-pill" Click="OnShowHeld" IsVisible="{Binding Queue.HasHeld}" HorizontalAlignment="Center"
                AutomationProperties.Name="{Binding Queue.HeldText}">
          <TextBlock Classes="caption" Text="{Binding Queue.HeldText}" />
        </Button>

        <Grid x:Name="PanelGrid" ColumnDefinitions="*" RowDefinitions="Auto,16,Auto" PointerEntered="OnPanelEntered" PointerExited="OnPanelExited">
          <Border x:Name="RunningPanel" Classes="panel" ClipToBounds="True" AutomationProperties.Name="{Binding Text.RunningPanel}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
            <!-- The panel stretches to its row's height; an empty group's sentence sits centred in the body (states.html .empty). -->
            <DockPanel>
              <Border Classes="phead" DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="section-title" VerticalAlignment="Center" Text="{Binding Queue.RunningHeader}" AutomationProperties.Name="{Binding Queue.RunningHeader}" />
                  <StackPanel x:Name="RunningStale" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding Queue.IsStale}">
                    <icons:StateIcon Glyph="Stale" VerticalAlignment="Center" />
                    <TextBlock Classes="caption subtle" Text="{Binding Text.Stale}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" x:Name="RunningShowAll" Classes="copy" Tag="Running" Click="OnShowAll" IsVisible="{Binding Queue.HasMoreRunning}"
                      AutomationProperties.Name="{Binding Queue.ShowAllRunning}" Margin="16,8">
                <TextBlock Classes="caption" Text="{Binding Queue.ShowAllRunning}" />
              </Button>
              <Panel>
              <ItemsControl VerticalAlignment="Top" x:Name="RunningRows" ItemsSource="{Binding Queue.RunningRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="queue:ItemRowViewModel">
                    <rows:CompactItemRow />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock VerticalAlignment="Center" x:Name="RunningEmpty" Classes="caption quiet" Text="{Binding Queue.RunningEmpty}"
                         IsVisible="{Binding Queue.RunningEmpty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         AutomationProperties.Name="{Binding Queue.RunningEmpty}" />
              </Panel>
            </DockPanel>
          </Border>
          <Border x:Name="QueuedPanel" Grid.Row="2" Classes="panel" ClipToBounds="True" AutomationProperties.Name="{Binding Text.QueuedPanel}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
            <!-- The panel stretches to its row's height; an empty group's sentence sits centred in the body (states.html .empty). -->
            <DockPanel>
              <Border Classes="phead" DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="section-title" VerticalAlignment="Center" Text="{Binding Queue.QueuedHeader}" AutomationProperties.Name="{Binding Queue.QueuedHeader}" />
                  <StackPanel x:Name="QueuedStale" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding Queue.IsStale}">
                    <icons:StateIcon Glyph="Stale" VerticalAlignment="Center" />
                    <TextBlock Classes="caption subtle" Text="{Binding Text.Stale}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" x:Name="QueuedShowAll" Classes="copy" Tag="All" Click="OnShowAll" IsVisible="{Binding Queue.HasMoreQueued}"
                      AutomationProperties.Name="{Binding Queue.ShowAllQueued}" Margin="16,8">
                <TextBlock Classes="caption" Text="{Binding Queue.ShowAllQueued}" />
              </Button>
              <Panel>
              <ItemsControl VerticalAlignment="Top" x:Name="QueuedRows" ItemsSource="{Binding Queue.QueuedRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="queue:ItemRowViewModel">
                    <rows:CompactItemRow />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock VerticalAlignment="Center" x:Name="QueuedEmpty" Classes="caption quiet" Text="{Binding Queue.QueuedEmpty}"
                         IsVisible="{Binding Queue.QueuedEmpty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         AutomationProperties.Name="{Binding Queue.QueuedEmpty}" />
              </Panel>
            </DockPanel>
          </Border>
        </Grid>

      </StackPanel>
    </Grid>

    <!-- Sindri health (home.html .strip): the eyebrow with its G . hint, the status as labelled cells, and a trailing ›;
         one button named by the health line, which opens Health (§4.2) on a click or Enter. -->
    <Button x:Name="HealthStrip" Classes="health-strip" Click="OnHealthStrip"
            AutomationProperties.Name="{Binding Health.StripName}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel x:Name="HealthKeys" Classes="strip-head" Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="caption subtle" Text="{Binding Text.HealthPanel}" VerticalAlignment="Center" />
          <!-- R3 (§4.1): while the views are stale the strip's values are marked so, as the pill is. -->
          <StackPanel x:Name="StripStale" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center"
                      IsVisible="{Binding Pill.IsDataStale}">
            <icons:StateIcon x:Name="StripStaleGlyph" Glyph="Stale" VerticalAlignment="Center" />
            <TextBlock x:Name="StripStaleText" Classes="caption subtle" Text="{Binding Text.Stale}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <ItemsControl x:Name="HealthCells" Grid.Column="1" ItemsSource="{Binding Health.Detail.Strip}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- R7: cells take their own width and wrap to a second row when the window is narrow, so no value
                   (the pid first) is ever trimmed. -->
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HealthCell">
              <Border Classes="cell">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <icons:StateIcon Glyph="{Binding Glyph}" IsVisible="{Binding HasGlyph}" VerticalAlignment="Center" />
                  <TextBlock Classes="caption subtle" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Classes="caption" Classes.attention="{Binding IsAttention}" Text="{Binding Value}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="HealthChevron" Grid.Column="2" Classes="body-strong subtle" Text="›" Margin="12,0,24,0"
                   VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
      </Grid>
    </Button>
  </StackPanel>
</UserControl>
