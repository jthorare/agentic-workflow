<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aw.Sindri.Ui.ViewModels"
        xmlns:shell="using:Aw.Sindri.Ui.ViewModels.Shell"
        xmlns:views="using:Aw.Sindri.Ui.Views.Shell"
        xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
        xmlns:controls="using:Aw.Sindri.Ui.Views.Controls"
        xmlns:root="using:Aw.Sindri.Ui.Views.Palette"
        xmlns:queue="using:Aw.Sindri.Ui.Views.Queue"
        xmlns:agv="using:Aw.Sindri.Ui.Views.Agents"
        xmlns:jv="using:Aw.Sindri.Ui.Views.Jobs"
        xmlns:cxv="using:Aw.Sindri.Ui.Views.Connections"
        xmlns:mmv="using:Aw.Sindri.Ui.Views.Memory"
        xmlns:rsv="using:Aw.Sindri.Ui.Views.Resources"
        xmlns:wfv="using:Aw.Sindri.Ui.Views.Workflows"
        xmlns:pv="using:Aw.Sindri.Ui.Views.Projects"
        xmlns:lnv="using:Aw.Sindri.Ui.Views.Linear"
        xmlns:rwv="using:Aw.Sindri.Ui.Views.Reviews"
        xmlns:cwv="using:Aw.Sindri.Ui.Views.Context.Whole"
        xmlns:cnv="using:Aw.Sindri.Ui.Views.Context.Concepts"
        xmlns:cnvm="using:Aw.Sindri.Ui.ViewModels.Context.Concepts"
        xmlns:ctxv="using:Aw.Sindri.Ui.Views.Context"
        xmlns:item="using:Aw.Sindri.Ui.Views.Item"
        xmlns:ny="using:Aw.Sindri.Ui.Views.NeedsYou"
        xmlns:tdv="using:Aw.Sindri.Ui.Views.Todo"
        x:Class="Aw.Sindri.Ui.Views.Shell.ShellWindow"
        x:DataType="shell:ShellViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        MinWidth="{StaticResource Size.WindowMinWidth}" MinHeight="{StaticResource Size.WindowMinHeight}">
  <!-- The shell (UI spec §3.2, §4.1): a top bar, the page, and the detail sheet over it; a version mismatch takes the whole
       window. Each pre-API state is a panel the view model makes visible; the view decides nothing. -->
  <Window.Styles>
    <StyleInclude Source="avares://Aw.Sindri.Ui/Views/Shell/ShellStyles.axaml" />
    <!-- The state live regions below are live only while their state holds, so their resting text, set once the gate is
         off, is never spoken (docs/csharp/sindri-ui.md "LiveSetting on macOS"). -->
    <Style Selector="TextBlock.live-region.live">
      <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    </Style>
  </Window.Styles>

  <Panel>
    <!-- Version mismatch (§4.1, states.html): a full-window card, no data, no actions: the sentence, both versions as
         labelled rows, and the fix, with sindri in the command chip. -->
    <Border x:Name="VersionMismatchPanel" IsVisible="{Binding IsVersionMismatch}" Classes="card state-card"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="{StaticResource Space.SM}">
        <TextBlock x:Name="VersionMismatchText" Classes="detail-title" TextWrapping="Wrap" Focusable="True"
                   Text="{Binding Text.VersionMismatch}" AutomationProperties.Name="{Binding Text.VersionMismatch}" />
        <ItemsControl x:Name="VersionRows" ItemsSource="{Binding Health.Detail.Versions}" AutomationProperties.Name="{Binding Reason}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HealthCell">
              <Grid ColumnDefinitions="80,*" AutomationProperties.Name="{Binding Label}">
                <TextBlock Classes="caption subtle" Text="{Binding Label}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Value}" AutomationProperties.Name="{Binding Value}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- N4: the fix as a sentence around sindri in the mono command chip; the line is named by the whole sentence. -->
        <StackPanel x:Name="VersionFix" Orientation="Horizontal" Spacing="10" AutomationProperties.Name="{Binding Text.VersionMismatchFix}">
          <TextBlock x:Name="VersionFixText" Classes="body muted" Text="{Binding Text.VersionMismatchFixLead}" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding Text.VersionMismatchFixLead}" />
          <Border Classes="command">
            <TextBlock x:Name="VersionFixCommand" Classes="mono" Text="{Binding Text.StartFix}"
                       AutomationProperties.Name="{Binding Text.StartFix}" />
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>

    <DockPanel IsVisible="{Binding IsChromeVisible}">
      <views:TopBar x:Name="TopBar" DockPanel.Dock="Top" ZIndex="1" />

      <!-- Stale after three failed refreshes (§4.1): "Sindri not responding: run sindri doctor" in full under the top bar,
           since the pill keeps ⌛ stale and its Refresh at the 1,000 px minimum. -->
      <Border x:Name="NotRespondingBanner" DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding IsNotRespondingBanner}"
              AutomationProperties.Name="{Binding Text.NotResponding}">
        <!-- A WrapPanel, like Unreadable's below: at the 1,000 px minimum or a large text scale the command moves to its
             own line instead of running past the window's edge. -->
        <WrapPanel ItemSpacing="10" LineSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <icons:StateIcon Glyph="Stale" VerticalAlignment="Center" />
            <TextBlock x:Name="NotRespondingText" Classes="body" Text="{Binding Text.NotRespondingLead}" VerticalAlignment="Center"
                       AutomationProperties.Name="{Binding Text.NotRespondingLead}" />
          </StackPanel>
          <Border Classes="command" VerticalAlignment="Center">
            <TextBlock x:Name="NotRespondingFixText" Classes="mono" Text="{Binding Text.DoctorFix}"
                       AutomationProperties.Name="{Binding Text.DoctorFix}" />
          </Border>
        </WrapPanel>
      </Border>

      <!-- Unreadable (§4.1): a banner with the code and sindri doctor; the page below keeps its last data. Three units
           in a WrapPanel: the icon with the heading, the reason, and "Check it:" with the command. They share a line
           while they fit; a longer reason takes the full width and wraps, and the command moves to the next line whole,
           so nothing runs past the window's edge at the 1,000 px minimum. -->
      <Border x:Name="UnreadableBanner" DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding IsUnreadable}">
        <WrapPanel ItemSpacing="12" LineSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <icons:StateIcon Glyph="Down" VerticalAlignment="Center" />
            <TextBlock x:Name="UnreadableHeading" Classes="body-strong" Text="{Binding Text.Unreadable}" VerticalAlignment="Center"
                       AutomationProperties.Name="{Binding Text.Unreadable}" />
          </StackPanel>
          <TextBlock x:Name="UnreadableText" Classes="body" Text="{Binding Reason}" TextWrapping="Wrap" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding Reason}" />
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock x:Name="UnreadableCheckIt" Classes="body subtle" Text="{Binding Text.CheckIt}" VerticalAlignment="Center"
                       AutomationProperties.Name="{Binding Text.CheckIt}" />
            <Border Classes="command">
              <TextBlock x:Name="DoctorFixText" Classes="mono" Text="{Binding Text.DoctorFix}"
                         AutomationProperties.Name="{Binding Text.DoctorFix}" />
            </Border>
          </StackPanel>
        </WrapPanel>
      </Border>

      <!-- Stalled and rebuilding (§4.1): the views' own sentence as served (GET /sindri/services' empty) across the page; the
           stalled one carries Rebuild views, the catalog's RebuildViews row through the control renderer. Rows stay. -->
      <Border x:Name="ViewsBanner" DockPanel.Dock="Top" Classes="banner" DataContext="{Binding Health.Banner}" x:DataType="shell:ViewsBanner"
              IsVisible="{Binding IsShown}" AutomationProperties.Name="{Binding Text}">
        <WrapPanel ItemSpacing="12" LineSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <icons:StateIcon x:Name="StalledGlyph" Glyph="Down" Classes="error" IsVisible="{Binding IsStalled}" VerticalAlignment="Center" />
            <icons:StateIcon x:Name="RebuildingGlyph" Icon="Spinner" Spins="{Binding IsRebuilding}" IsVisible="{Binding IsRebuilding}"
                             VerticalAlignment="Center" />
            <TextBlock x:Name="ViewsBannerText" Classes="body" Text="{Binding ShownText}" TextWrapping="Wrap" VerticalAlignment="Center"
                       AutomationProperties.Name="{Binding Text}" />
          </StackPanel>
          <Panel IsVisible="{Binding HasRebuild}" VerticalAlignment="Center">
            <controls:CommandControl x:Name="RebuildControl" DataContext="{Binding Rebuild}" />
          </Panel>
        </WrapPanel>
      </Border>

      <Panel>
        <Border x:Name="Page" Classes="focus-region" Focusable="True" AutomationProperties.Name="{Binding PageName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
          <Panel>
            <!-- Connecting (§4.1, states.html): Home's frame with static, left-aligned skeleton bars, first load only. -->
            <StackPanel x:Name="ConnectingSkeleton" IsVisible="{Binding IsConnecting}" Margin="{StaticResource Space.LG.Thickness}"
                        Spacing="{StaticResource Size.PanelGap}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                <TextBlock Classes="page-title" Text="{Binding Text.Home}" AutomationProperties.Name="{Binding Text.Home}" />
                <Border Classes="skeleton" Width="180" VerticalAlignment="Center" />
              </StackPanel>
              <Border Classes="panel">
                <StackPanel>
                  <Border Classes="phead">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="section-title" Text="{Binding Text.NeedsYouPanel}" VerticalAlignment="Center"
                                 AutomationProperties.Name="{Binding Text.NeedsYouPanel}" />
                      <TextBlock x:Name="ConnectingText" Grid.Column="1" Classes="caption subtle" Text="{Binding Text.Connecting}"
                                 VerticalAlignment="Center" AutomationProperties.Name="{Binding Text.Connecting}" />
                    </Grid>
                  </Border>
                  <Grid Classes="skrow" ColumnDefinitions="70,*,40"><Border Classes="skeleton" Width="60" /><Border Grid.Column="1" Classes="skeleton" Width="420" /><Border Grid.Column="2" Classes="skeleton" Width="32" /></Grid>
                  <Grid Classes="skrow" ColumnDefinitions="70,*,40"><Border Classes="skeleton" Width="52" /><Border Grid.Column="1" Classes="skeleton" Width="330" /><Border Grid.Column="2" Classes="skeleton" Width="32" /></Grid>
                  <Grid Classes="skrow" ColumnDefinitions="70,*,40"><Border Classes="skeleton" Width="64" /><Border Grid.Column="1" Classes="skeleton" Width="480" /><Border Grid.Column="2" Classes="skeleton" Width="32" /></Grid>
                  <Grid Classes="skrow" ColumnDefinitions="70,*,40"><Border Classes="skeleton" Width="48" /><Border Grid.Column="1" Classes="skeleton" Width="270" /><Border Grid.Column="2" Classes="skeleton" Width="32" /></Grid>
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,16,*">
                <Border Classes="panel" Padding="{StaticResource Space.MD.Thickness}">
                  <Border Classes="skeleton" Width="240" />
                </Border>
                <Border Grid.Column="2" Classes="panel" Padding="{StaticResource Space.MD.Thickness}">
                  <Border Classes="skeleton" Width="180" />
                </Border>
              </Grid>
            </StackPanel>

            <!-- Not running (§4.1, states.html): a compact card centred in the page: the struck ◆ mark (the tray's
                 not-running mark) and the word, the reason, sindri to run, and how often the app looks again. Settings (⌘,) shows over it; Esc returns. -->
            <Border x:Name="NotRunningPanel" Classes="card state-card" IsVisible="{Binding IsNotRunningPanel}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel Spacing="{StaticResource Space.SM}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
                  <Path x:Name="NotRunningMark" Classes="struck-mark" Data="M8,2 L14,8 L8,14 L2,8 Z M2,2 L14,14"
                        VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                  <TextBlock x:Name="NotRunningText" Classes="detail-title" Text="{Binding Text.NotRunning}"
                             AutomationProperties.Name="{Binding Text.NotRunning}" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource Space.SM}" IsVisible="{Binding !Start.HidesNotRunningReason}">
                <TextBlock x:Name="ReasonText" Classes="body muted" Text="{Binding Reason}" TextWrapping="Wrap"
                           AutomationProperties.Name="{Binding Reason}" />
                <!-- I7: the reason's detail on its own mono line: the record's path shortened (~, a middle ellipsis), the address, or
                     the record against the answer; never wrapped mid-path. -->
                <TextBlock x:Name="ReasonDetailText" Classes="mono subtle" Text="{Binding ReasonDetail}" TextWrapping="NoWrap"
                           TextTrimming="PrefixCharacterEllipsis" IsVisible="{Binding ReasonDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.Name="{Binding ReasonDetail}" />
                </StackPanel>
                <TextBlock x:Name="StartMessageText" Classes="body" Text="{Binding Start.Message}" TextWrapping="Wrap"
                           IsVisible="{Binding Start.HasMessage}" AutomationProperties.Name="{Binding Start.Message}" />
                <TextBlock x:Name="StartDetailsText" Classes="mono subtle" Text="{Binding Start.Details}" TextWrapping="Wrap"
                           IsVisible="{Binding Start.HasDetails}" AutomationProperties.Name="{Binding Start.Details}" />
                <Button x:Name="StartSindriButton" Classes="accent" Click="OnStartSindri" HorizontalAlignment="Left" Content="{Binding Start.Primary}"
                        IsVisible="{Binding Start.HasPrimary}" AutomationProperties.Name="{Binding Start.Primary}" />
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Start.ShowsTerminalCommand}">
                  <TextBlock Classes="body subtle" Text="{Binding Text.StartIt}" AutomationProperties.Name="{Binding Text.StartIt}" VerticalAlignment="Center" />
                  <Border Classes="command">
                    <TextBlock x:Name="FixText" Classes="mono" Text="{Binding Text.StartFix}"
                               AutomationProperties.Name="{Binding Text.StartFix}" />
                  </Border>
                </StackPanel>
                <!-- §12.4, states.html's help line: the follower's retry wait (HealthViewModel.RetryEvery), in caption type. -->
                <TextBlock x:Name="LooksAgainText" Classes="caption subtle" Text="{Binding Text.LooksAgain}"
                           AutomationProperties.Name="{Binding Text.LooksAgain}" />
              </StackPanel>
            </Border>

            <!-- The pages (§3.3), each shown by the view model's page flag. -->
            <ScrollViewer x:Name="Pages" IsVisible="{Binding IsPagesShown}">
              <Panel x:Name="PageContent" Classes="page-content" Classes.edge="{Binding IsEdgeTabShown}">
                <views:HomePage x:Name="HomePage" IsVisible="{Binding IsHomeShown}" />
                <!-- Projects (Projects page spec §7): the owner's projects in state groups. -->
                <Panel IsVisible="{Binding IsProjects}"><pv:ProjectsPage x:Name="ProjectsPage" DataContext="{Binding Projects}" /></Panel>
                <!-- Reviews (review page spec §6.1): the owner's PRs and the ones waiting on them. -->
                <Panel IsVisible="{Binding IsReviews}"><rwv:ReviewsPage x:Name="ReviewsPage" DataContext="{Binding Reviews}" /></Panel>
                <controls:Deferred IsVisible="{Binding IsWork}">
                  <controls:Deferred.Template>
                    <DataTemplate><queue:QueuePage x:Name="QueuePage" /></DataTemplate>
                  </controls:Deferred.Template>
                </controls:Deferred>
                <Panel IsVisible="{Binding IsContext}">
                  <controls:Deferred DataContext="{Binding Context}">
                    <controls:Deferred.Template>
                      <DataTemplate><ctxv:ContextPage x:Name="ContextPage" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </Panel>
                <Panel IsVisible="{Binding IsAgents}">
                  <controls:Deferred DataContext="{Binding Agents}">
                    <controls:Deferred.Template>
                      <DataTemplate><agv:AgentsPage x:Name="AgentsPage" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </Panel>
                <!-- System hosts the control plane's health until U12 builds the rest (screens spec §4.6). -->
                <Panel IsVisible="{Binding IsSystem}">
                  <StackPanel Spacing="{StaticResource Size.PanelGap}">
                    <controls:Deferred DataContext="{Binding Health}">
                      <controls:Deferred.Template>
                        <DataTemplate><views:HealthPage x:Name="HealthPage" /></DataTemplate>
                      </controls:Deferred.Template>
                    </controls:Deferred>
                    <!-- Jobs is not a tab: System leads to it (G J and the palette too). -->
                    <Button x:Name="JobsLink" Classes="row-title" Click="OnJobsLink" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text.JobsLinkName}">
                      <TextBlock Classes="body" Text="{Binding Text.JobsLink}" AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                    <!-- Memory is not a tab either: System leads to it (G M and the palette too). -->
                    <Button x:Name="MemoryLink" Classes="row-title" Click="OnMemoryLink" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text.MemoryLinkName}">
                      <TextBlock Classes="body" Text="{Binding Text.MemoryLink}" AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                    <!-- Resources is not a tab either: System leads to it (G R and the palette too). -->
                    <Button x:Name="ResourcesLink" Classes="row-title" Click="OnResourcesLink" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text.ResourcesLinkName}">
                      <TextBlock Classes="body" Text="{Binding Text.ResourcesLink}" AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                  </StackPanel>
                </Panel>
                <Panel IsVisible="{Binding IsConnections}">
                  <controls:Deferred DataContext="{Binding Connections}">
                    <controls:Deferred.Template>
                      <DataTemplate><cxv:ConnectionsPage x:Name="ConnectionsPage" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </Panel>
                <!-- The Memory page (PR 18a): not a tab; G M, the palette, System's Memory link and a memory/<name> link open it. -->
                <Panel IsVisible="{Binding IsMemory}">
                  <controls:Deferred DataContext="{Binding MemoryPage}">
                    <controls:Deferred.Template>
                      <DataTemplate><mmv:MemoryPage x:Name="MemoryPage" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </Panel>
                <!-- The Resources page (PR 18b): not a tab; G R, the palette and System's Resources link open it. -->
                <Panel IsVisible="{Binding IsResources}">
                  <controls:Deferred DataContext="{Binding ResourcesPage}">
                    <controls:Deferred.Template>
                      <DataTemplate><rsv:ResourcesPage x:Name="ResourcesPage" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </Panel>
                <Panel IsVisible="{Binding IsJobs}">
                  <controls:Deferred DataContext="{Binding Jobs}">
                    <controls:Deferred.Template>
                      <DataTemplate><jv:JobsPage x:Name="JobsPage" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </Panel>
                <Panel IsVisible="{Binding IsWorkflows}">
                  <controls:Deferred DataContext="{Binding Workflows}">
                    <controls:Deferred.Template>
                      <DataTemplate><wfv:WorkflowsPage x:Name="WorkflowsPage" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </Panel>
                <!-- Settings (⌘,): SindriApp puts Settings' view here at start-up; the placeholder shows where nothing does (view tests). -->
                <ContentControl x:Name="SettingsSlot" IsVisible="{Binding IsSettings}">
                  <views:PlaceholderPage x:Name="SettingsPlaceholder" Title="{Binding Text.Settings}" />
                </ContentControl>
              </Panel>
            </ScrollViewer>
            <!-- The Needs-you inbox (F3 needs-you spec §2): over Home's panels while Home stays the page; it scrolls its own list and card, so it sits beside the pages' scroller. -->
            <Panel x:Name="NeedsYouInboxLayer" IsVisible="{Binding IsInboxShown}">
              <controls:Deferred DataContext="{Binding Inbox}">
                <controls:Deferred.Template>
                  <DataTemplate><ny:NeedsYouPage x:Name="NeedsYouInboxPage" /></DataTemplate>
                </controls:Deferred.Template>
              </controls:Deferred>
            </Panel>
            <!-- One PR's review page (review page spec §6.2): over the Reviews list, in place of it. -->
            <ScrollViewer x:Name="ReviewPageLayer" IsVisible="{Binding IsReviewPageShown}">
              <Panel Classes="page-content"><rwv:ReviewPageView x:Name="ReviewPageContent" DataContext="{Binding ReviewPage}" /></Panel>
            </ScrollViewer>
          </Panel>
        </Border>

        <!-- The closed sheet's edge tab: the last subject, which reopens it. -->
        <Button x:Name="EdgeTab" Classes="edge-tab" IsVisible="{Binding IsEdgeTabShown}" Click="OnEdgeTab"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                AutomationProperties.Name="{Binding EdgeTabName}">
          <LayoutTransformControl>
            <LayoutTransformControl.LayoutTransform>
              <RotateTransform Angle="-90" />
            </LayoutTransformControl.LayoutTransform>
            <TextBlock Classes="mono" Text="{Binding EdgeTabText}" />
          </LayoutTransformControl>
        </Button>

        <!-- The detail sheet (§3.2): over the page at the right, 420–760 px wide; below 1100 px it covers the page. -->
        <Border x:Name="Sheet" Classes="sheet focus-region" IsVisible="{Binding IsSheetShown}" Focusable="True"
                AutomationProperties.Name="{Binding SheetName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
          <DockPanel>
            <Thumb x:Name="SheetGrip" Classes="sheet-grip" DockPanel.Dock="Left" Cursor="SizeWestEast"
                   DragDelta="OnSheetDrag" DragCompleted="OnSheetDragged"
                   AutomationProperties.Name="{Binding Text.Sheet}" />
            <DockPanel Margin="24,16">
              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                <Button x:Name="SheetBack" Classes="back" Content="{Binding Text.Back}" Click="OnBack"
                        AutomationProperties.Name="{Binding Text.Back}" Margin="0,0,12,0" />
                <!-- The focus target is a Text-typed wrapper named for the kind and subject ("Workflow WFI-1"); the subject is mono (an id) except a project's, which is its name; the visible subject inside it is Raw, as ChordHint's key is (a TextBlock's peer reads its Text and ignores a Name). -->
                <Border x:Name="SheetTitle" Classes="sheet-title" Grid.Column="1" Focusable="True" VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text"
                        AutomationProperties.Name="{Binding SheetName}">
                  <TextBlock x:Name="SheetSubjectText" Classes="detail-title" Classes.mono="{Binding SheetTitleIsMono}" Text="{Binding SheetTitle}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding SheetSubject}" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <Button x:Name="SheetClose" Grid.Column="2" Click="OnCloseSheet" Margin="12,0,0,0"
                        AutomationProperties.Name="{Binding Text.CloseSheetName}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:StateIcon Icon="Close" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Text.CloseSheet}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <!-- The one sheet layer's content, chosen by the kind of link that opened it (SheetLink.Kind): every kind shows
                   "not served yet" (IsSheetPlaceholderShown) until its lane claims the kind in ShellViewModel.Sheet.cs and adds its own content here. -->
              <Panel x:Name="SheetContent">
                <TextBlock x:Name="SheetBody" Classes="body muted" Text="{Binding Text.NotServedYet}" IsVisible="{Binding IsSheetPlaceholderShown}"
                           AutomationProperties.Name="{Binding Text.NotServedYet}" />
                <!-- U2's item sheet (kind: Item). -->
                <ScrollViewer x:Name="ItemSheetScroll" IsVisible="{Binding IsItemSheet}">
                  <controls:Deferred DataContext="{Binding Item}">
                    <controls:Deferred.Template>
                      <DataTemplate><item:ItemSheet x:Name="ItemSheet" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </ScrollViewer>
                <!-- U3' T9: a Needs-you row's sheet (kind: NeedsYou); the decision sheet is kind Decision (T6). -->
                <ScrollViewer x:Name="NeedsYouSheetScroll" IsVisible="{Binding IsNeedsYouSheet}">
                  <controls:Deferred DataContext="{Binding NeedsYou.SheetRow}">
                    <controls:Deferred.Template>
                      <DataTemplate><ny:NeedsYouSheet x:Name="NeedsYouSheet" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </ScrollViewer>
                <ScrollViewer x:Name="DecisionSheetScroll" IsVisible="{Binding IsDecisionSheet}">
                  <controls:Deferred DataContext="{Binding Decision}">
                    <controls:Deferred.Template>
                      <DataTemplate><ny:DecisionSheet x:Name="DecisionSheet" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </ScrollViewer>
                <!-- LANE ANCHOR U3': the sheet content for the kinds U3' claims (kinds: NeedsYou, Decision). Insert immediately above this marker, never between the markers. -->
                <!-- LANE ANCHOR U9: the sheet content for the kinds U9 claims (kinds: Node), the node card of the Context page. Insert immediately below this marker, never between the markers. -->
                <!-- LANE ANCHOR U11a: the sheet content for the kinds U11a claims (kinds: Session), the session sheet. Insert immediately below this marker, never between the markers. -->
                <ScrollViewer x:Name="JobSheetScroll" IsVisible="{Binding IsJobSheet}">
                  <controls:Deferred DataContext="{Binding JobSheet}">
                    <controls:Deferred.Template>
                      <DataTemplate><jv:JobSheetView x:Name="JobSheetContent" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </ScrollViewer>
                <ScrollViewer x:Name="ConnectionSheetScroll" IsVisible="{Binding IsConnectionSheet}">
                  <controls:Deferred DataContext="{Binding ConnectionSheet}">
                    <controls:Deferred.Template>
                      <DataTemplate><cxv:ConnectionSheetView x:Name="ConnectionSheetContent" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </ScrollViewer>
                <ScrollViewer x:Name="ProjectSheetScroll" IsVisible="{Binding IsProjectSheet}">
                  <controls:Deferred DataContext="{Binding ProjectSheet}">
                    <controls:Deferred.Template>
                      <DataTemplate><pv:ProjectSheetView x:Name="ProjectSheetContent" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </ScrollViewer>
                <ScrollViewer x:Name="IssueSheetScroll" IsVisible="{Binding IsIssueSheet}" VerticalScrollBarVisibility="Disabled">
                  <controls:Deferred DataContext="{Binding IssueSheet}">
                    <controls:Deferred.Template>
                      <DataTemplate><lnv:LinearIssueSheetView x:Name="IssueSheetContent" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </ScrollViewer>
                <ScrollViewer x:Name="ProjectAddScroll" IsVisible="{Binding IsProjectAddSheet}">
                  <controls:Deferred DataContext="{Binding ProjectAdd}">
                    <controls:Deferred.Template>
                      <DataTemplate><pv:ProjectAddView x:Name="ProjectAddContent" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </ScrollViewer>
                <ScrollViewer x:Name="PageSheetScroll" IsVisible="{Binding IsPageSheet}">
                  <controls:Deferred DataContext="{Binding ActivePageSheet}">
                    <controls:Deferred.Template>
                      <DataTemplate><cwv:PageSheetView x:Name="PageSheetContent" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </ScrollViewer>
                <ScrollViewer x:Name="AddSeveralPagesScroll" IsVisible="{Binding IsAddSeveralPages}">
                  <controls:Deferred DataContext="{Binding ActiveAddSeveralPages}">
                    <controls:Deferred.Template>
                      <DataTemplate><cwv:AddSeveralPagesView x:Name="AddSeveralPagesContent" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </ScrollViewer>
                <ScrollViewer x:Name="ReviewFixSheetScroll" IsVisible="{Binding IsFixTaskSheet}">
                  <rwv:ReviewFixSheetView x:Name="ReviewFixSheetContent" DataContext="{Binding ReviewFix}" />
                </ScrollViewer>
                <ScrollViewer x:Name="LibrarySheetScroll" IsVisible="{Binding IsLibrarySheet}">
                  <rwv:LibrarySheetView x:Name="LibrarySheetContent" DataContext="{Binding Reviews.Library}" />
                </ScrollViewer>
                <ScrollViewer x:Name="PinSheetScroll" IsVisible="{Binding IsPinSheet}">
                  <ContentControl x:Name="PinSheetSlot" Content="{Binding PinSheetContent}">
                    <ContentControl.DataTemplates>
                      <DataTemplate DataType="cnvm:PinSheetViewModel"><cnv:PinSheetView x:Name="PinSheetContent" /></DataTemplate>
                      <DataTemplate DataType="cnvm:PinSeveralViewModel"><cnv:PinSeveralView x:Name="PinSeveralContent" /></DataTemplate>
                    </ContentControl.DataTemplates>
                  </ContentControl>
                </ScrollViewer>
                <ScrollViewer x:Name="SessionSheetScroll" IsVisible="{Binding IsSessionSheet}">
                  <controls:Deferred DataContext="{Binding AgentSheet}">
                    <controls:Deferred.Template>
                      <DataTemplate><agv:SessionSheetView x:Name="SessionSheetContent" /></DataTemplate>
                    </controls:Deferred.Template>
                  </controls:Deferred>
                </ScrollViewer>
              </Panel>
            </DockPanel>
          </DockPanel>
        </Border>

        <!-- The toast (todo spec §3.3): one slot over the page's bottom, shown only while a toast shows; F6 reaches it. -->
        <views:ToastHost x:Name="Toast" IsVisible="{Binding Toast.IsShown}" />
      </Panel>
    </DockPanel>

    <!-- WCAG 4.1.3: the Unreadable banner, the Not responding banner and the Not running card announce themselves through
         polite live regions, as Refresh's "Sending…" does: a TextBlock whose Text changes, with no separate name, never "",
         live only while its state holds (the view model changes the flag before the text). They sit here, outside the
         banners, so each is in the tree before its state comes and the text change is what is spoken; invisible and
         zero-width, so they take no room and show nothing. -->
    <TextBlock x:Name="UnreadableLive" Classes="live-region" Classes.live="{Binding IsUnreadable}" Text="{Binding UnreadableAnnouncement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <TextBlock x:Name="NotRespondingLive" Classes="live-region" Classes.live="{Binding IsNotRespondingBanner}" Text="{Binding NotRespondingAnnouncement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <TextBlock x:Name="NotRunningLive" Classes="live-region" Classes.live="{Binding IsNotRunning}" Text="{Binding NotRunningAnnouncement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <TextBlock x:Name="MismatchLive" Classes="live-region" Classes.live="{Binding IsVersionMismatch}" Text="{Binding MismatchAnnouncement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <TextBlock x:Name="RunningLive" Classes="live-region" Classes.live="{Binding IsRecovered}" Text="{Binding RecoveredAnnouncement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <TextBlock x:Name="ViewsLive" Classes="live-region" Classes.live="{Binding Health.Banner.IsShown}" Text="{Binding Health.Banner.Announcement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <TextBlock x:Name="ViewsRecoveredLive" Classes="live-region" Classes.live="{Binding Health.Banner.IsRecovered}" Text="{Binding Health.Banner.RecoveredAnnouncement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <!-- A command the palette started and closed on before its outcome: no control has a view on show to say it, so this region does. -->
    <TextBlock x:Name="CommandOutcomeLive" Classes="live-region" Classes.live="{Binding CommandOutcome.IsLive}" Text="{Binding CommandOutcome.Text}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <!-- The queue's polite region (§3.3): "ITM-… cleared" and "N new", live only while it speaks (the view model changes the flag first). -->
    <TextBlock x:Name="QueueLive" Classes="live-region" Classes.live="{Binding Queue.IsAnnouncing}" Text="{Binding Queue.Announcement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <!-- Needs you (§5): "N now need you", once for each rise; the flag changes before the text. -->
    <TextBlock x:Name="NeedsYouLive" Classes="live-region" Classes.live="{Binding IsNeedsYouAnnouncing}" Text="{Binding NeedsYouAnnouncement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <!-- Mark all seen (B2): "N marked seen" once when its Undo is offered; the flag changes before the text. -->
    <TextBlock x:Name="NeedsYouSeenLive" Classes="live-region" Classes.live="{Binding NeedsYou.Seen.UndoOffered}" Text="{Binding NeedsYou.Seen.UndoAnnouncement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <!-- The decision sheet's polite region: what Decide answered or refused; the flag changes before the text. -->
    <TextBlock x:Name="DecisionLive" Classes="live-region" Classes.live="{Binding Decision.IsAnnouncing}" Text="{Binding Decision.Announcement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <!-- The Linear New issue dialog's polite region: its blank-title and no-team lines, "Checking…", "Retry?" and "Created ENG-58" (the dialog closes on a create, so the region is the shell's); the flag changes before the text. -->
    <TextBlock x:Name="NewIssueLive" Classes="live-region" Classes.live="{Binding NewIssue.IsAnnouncing}" Text="{Binding NewIssue.Announcement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <!-- The item sheet's polite region (L8): the refusal a gone control leaves behind, spoken once; the flag changes before the text. -->
    <TextBlock x:Name="ItemLive" Classes="live-region" Classes.live="{Binding Item.IsAnnouncing}" Text="{Binding Item.Announcement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <!-- The toast's polite region (todo spec §3.5): its text and the Undo key, spoken once; the flag changes before the text. -->
    <TextBlock x:Name="ToastLive" Classes="live-region" Classes.live="{Binding Toast.IsAnnouncing}" Text="{Binding Toast.Announcement}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <!-- The palette and the ? sheet (§8): layers over everything, shown by their view models; Esc closes the topmost. -->
    <Panel x:Name="PaletteLayer" IsVisible="{Binding Palette.IsOpen}">
      <controls:Deferred DataContext="{Binding Palette}">
        <controls:Deferred.Template>
          <DataTemplate><root:CommandPalette x:Name="CommandPalette" /></DataTemplate>
        </controls:Deferred.Template>
      </controls:Deferred>
    </Panel>
    <!-- The quick-add box (todo spec §3.2): under the top bar, over the page, which stays visible behind it. -->
    <Panel x:Name="QuickAddLayer" IsVisible="{Binding QuickAdd.IsOpen}">
      <controls:Deferred DataContext="{Binding QuickAdd}">
        <controls:Deferred.Template>
          <DataTemplate><tdv:QuickAddBox x:Name="QuickAddBox" /></DataTemplate>
        </controls:Deferred.Template>
      </controls:Deferred>
    </Panel>
    <Panel x:Name="CreateLayer" IsVisible="{Binding Create.IsOpen}">
      <controls:Deferred DataContext="{Binding Create}">
        <controls:Deferred.Template>
          <DataTemplate><item:CreateItemDialog x:Name="CreateItemDialog" /></DataTemplate>
        </controls:Deferred.Template>
      </controls:Deferred>
    </Panel>
    <Panel x:Name="NewIssueLayer" IsVisible="{Binding NewIssue.IsOpen}">
      <controls:Deferred DataContext="{Binding NewIssue}">
        <controls:Deferred.Template>
          <DataTemplate><lnv:NewLinearIssueDialog x:Name="NewLinearIssueDialog" /></DataTemplate>
        </controls:Deferred.Template>
      </controls:Deferred>
    </Panel>
    <Panel x:Name="ShortcutsLayer" IsVisible="{Binding Shortcuts.IsOpen}">
      <controls:Deferred DataContext="{Binding Shortcuts}">
        <controls:Deferred.Template>
          <DataTemplate><root:ShortcutsSheet x:Name="ShortcutsSheet" /></DataTemplate>
        </controls:Deferred.Template>
      </controls:Deferred>
    </Panel>
  </Panel>
</Window>
