<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Aw.Sindri.Ui.ViewModels.Shell"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             x:Class="Aw.Sindri.Ui.Views.Shell.TopBar"
             x:DataType="shell:ShellViewModel">
  <UserControl.Styles>
    <!-- The "Sending…" live region is live only while sending (Health.IsSending), so its resting text, set once the
         gate is off, is never spoken (docs/csharp/sindri-ui.md "LiveSetting on macOS"). -->
    <Style Selector="TextBlock.live-region.live">
      <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    </Style>
    <!-- Not running (states.html): the pill is the state, not a link; the Not running card is the health state and the
         Health page has nothing to show, so it is disabled like the navigation beside it, but keeps its surface and its
         word's ink (the state is never dimmed). -->
    <Style Selector="Button.health-pill:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
  </UserControl.Styles>
  <!-- The top bar (UI spec §3.2): brand, the segmented navigation with its counts, Later ▾, the ⌘K field (a click,
       Enter or Space opens the palette) and the health pill, which opens Health. The ⌘K field's column is a star column that outweighs the
       spacer and stops at 300 px plus its margins: with room it is 300 px wide at the right, and as the window narrows it
       gives way down to 160 px. Below that the bar steps down (TopBar.axaml.cs): first the ⌘K field folds to its
       magnifier, then the pill's age drops (its accessible name keeps it), then the brand keeps its mark alone, so the
       navigation and the pill's word fit at the 900 px minimum in every state and at text scale 1.3. -->
  <Border Classes="topbar focus-region" Focusable="True" AutomationProperties.Name="{Binding Text.Sindri}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
    <Grid x:Name="BarGrid" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="100*" MinWidth="184" MaxWidth="324" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,20,0">
        <icons:StateIcon x:Name="BrandMark" Classes="brand" Icon="Brand" VerticalAlignment="Center" />
        <TextBlock x:Name="BrandWord" Classes="body-strong" Text="{Binding Text.Sindri}" VerticalAlignment="Center"
                   AutomationProperties.Name="{Binding Text.Sindri}" />
      </StackPanel>

      <!-- The segmented navigation (§3.2, home.html): one group on Surface1 with a hairline; unselected labels muted, the
           selected segment on PrimarySoft with a Primary dot and its label in PrimaryHover. Dimmed and disabled while Sindri isn't running (states.html). -->
      <Border x:Name="NavSegments" Grid.Column="1" Grid.ColumnSpan="2" Classes="seg" HorizontalAlignment="Left">
        <StackPanel x:Name="NavigationGroup" Orientation="Horizontal" Spacing="2" IsEnabled="{Binding IsNavigationEnabled}">
          <ListBox x:Name="Navigation" Classes="nav" ItemsSource="{Binding Navigation}"
                   SelectedItem="{Binding SelectedNav}" SelectionMode="Single"
                   AutomationProperties.Name="{Binding Text.Pages}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="shell:NavEntry">
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
              </Style>
              <!-- A count shows when there is one, and not at all once the bar has stepped down to its last step (TopBar.Counts.cs). -->
              <Style Selector="TextBlock.nav-count">
                <Setter Property="IsVisible" Value="False" />
              </Style>
              <Style Selector="TextBlock.nav-count.has">
                <Setter Property="IsVisible" Value="True" />
              </Style>
              <Style Selector="ListBox.no-counts TextBlock.nav-count">
                <Setter Property="IsVisible" Value="False" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="shell:NavEntry">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Classes="nav-dot" VerticalAlignment="Center" />
                  <TextBlock Classes="body-strong nav-label" Text="{Binding Label}" AutomationProperties.Name="{Binding Label}" />
                  <TextBlock Classes="caption subtle nav-count" Classes.has="{Binding HasCount}" Text="{Binding Count}" AutomationProperties.Name="{Binding Count}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- The ⌘K field (home.html): a magnifier, the placeholder, and the ⌘K keycap at the right; folded ("compact"), the
           magnifier alone, still named "Search or run a command". -->
      <Border x:Name="SearchField" Grid.Column="4" Classes="search" Margin="12,0,12,0" Focusable="True" Cursor="Hand"
              PointerPressed="OnSearch" KeyDown="OnSearchKey"
              AutomationProperties.Name="{Binding Text.Search}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Button">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <Path Classes="magnifier" Data="M5.5,1 A4.5,4.5 0 1 1 5.5,10 A4.5,4.5 0 1 1 5.5,1 Z M8.8,8.8 L12,12" VerticalAlignment="Center" />
          <TextBlock x:Name="SearchText" Grid.Column="1" Classes="caption subtle search-text" Text="{Binding Text.Search}" AutomationProperties.Name="{Binding Text.Search}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
          <Border x:Name="SearchKeycap" Grid.Column="2" Classes="kbd search-key" AutomationProperties.Name="{Binding Text.SearchKey}" AutomationProperties.AccessibilityView="Raw">
            <StackPanel Orientation="Horizontal" Spacing="1" AutomationProperties.AccessibilityView="Raw">
              <icons:StateIcon Classes="kbd" Icon="Command" VerticalAlignment="Center" />
              <TextBlock Classes="kbd" Text="{Binding Text.SearchKeyLetter}" VerticalAlignment="Center"
                         AutomationProperties.Name="{Binding Text.SearchKey}" AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- The health pill (§3.2, §11.3): the state's glyph before its word, then the age; it opens Health (not while
           Sindri isn't running: then it is only the state). R4: one mark per state, the glyph, which §11.3 gives every
           state; a dot beside it only doubled it and cost the age its room.
           While stale, Refresh sits beside it (§4.1). -->
      <!-- After 300 ms in flight, "Sending…" is announced through this polite live region (§4.1), a TextBlock whose Text
           changes (a bound name on a Border raises no change) with no separate name. It is in the tree from the click,
           so assistive tech has read it before its text changes, and out of it otherwise; its text is never "" (Avalonia
           #22312). Invisible and zero-width, so the bar never moves for the in-flight moment. -->
      <TextBlock x:Name="RefreshSending" Grid.Column="5" Classes="caption live-region" Classes.live="{Binding Health.IsSending}"
                 Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Text="{Binding Health.SendingAnnouncement}" IsVisible="{Binding !Health.CanRefresh}" />
      <StackPanel x:Name="PillGroup" Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="RefreshButton" Classes="refresh" IsVisible="{Binding Pill.IsRefreshShown}" IsEnabled="{Binding Health.CanRefresh}"
                Click="OnRefresh" AutomationProperties.Name="{Binding Text.Refresh}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- §4.1 "sending" (R2): in flight, Refresh is disabled with its label kept and a spinner in the icon's place
                 (still under reduced motion); its width never changes, so the bar doesn't move. -->
            <Panel VerticalAlignment="Center">
              <icons:StateIcon x:Name="RefreshIcon" Icon="Refresh" IsVisible="{Binding Health.CanRefresh}" />
              <icons:StateIcon x:Name="RefreshSpinner" Icon="Spinner" IsVisible="{Binding !Health.CanRefresh}"
                               Spins="{Binding !Health.CanRefresh}" />
            </Panel>
            <TextBlock Classes="caption" Text="{Binding Text.Refresh}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="HealthPill" Classes="health-pill" Click="OnHealthPill" IsEnabled="{Binding IsNavigationEnabled}"
                AutomationProperties.Name="{Binding Pill.Text}" ToolTip.Tip="{Binding Pill.Text}">
          <!-- S1: the 6 px gaps are the glyph's and the age's own margins, so a state with neither (Connecting) centres its word. -->
          <StackPanel Orientation="Horizontal">
            <icons:StateIcon x:Name="PillGlyph" Glyph="{Binding Pill.Glyph}" IsVisible="{Binding Pill.HasGlyph}" Margin="0,0,6,0"
                             VerticalAlignment="Center" />
            <TextBlock x:Name="HealthPillText" Classes="body-strong" Text="{Binding Pill.Word}" VerticalAlignment="Center" />
            <Panel x:Name="PillAge" VerticalAlignment="Center">
              <TextBlock x:Name="PillAgeText" Classes="caption subtle" Text="{Binding Pill.Age}" IsVisible="{Binding Pill.HasAge}"
                         Margin="6,0,0,0" VerticalAlignment="Center" />
            </Panel>
            <!-- §3.2: any problem the status's health names, in words as served ("index failed"). -->
            <TextBlock x:Name="PillProblems" Classes="caption" Text="{Binding Pill.Problems}" IsVisible="{Binding Pill.HasProblems}"
                       Margin="6,0,0,0" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
      </StackPanel>
      <!-- The G-chord's wait (rev 7 §8): "G …" in a keycap while G waits for its second key. It sits inside the bar, vertically
           centred over the ⌘K field's right end, where its keycap is (re-check R1: laid out below the bar, the page region painted over
           it; the bar has no spare room for a column of its own at 900 px). Last in the grid so nothing in the bar draws over it; transient and exposed as text, not live: the key press is the
           user's own. -->
      <Border x:Name="ChordHint" Grid.Column="4" Classes="kbd" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
              IsHitTestVisible="False" IsVisible="{Binding IsChordPending}"
              AutomationProperties.Name="{Binding ChordHint}" AutomationProperties.AccessibilityView="Control"
              AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="kbd" Text="{Binding ChordHint}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
      </Border>
    </Grid>
  </Border>
</UserControl>
