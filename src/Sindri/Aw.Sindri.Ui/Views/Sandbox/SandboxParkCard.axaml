<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sb="using:Aw.Sindri.Ui.ViewModels.Sandbox"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             xmlns:sv="using:Aw.Sindri.Ui.Views.Sandbox"
             x:Class="Aw.Sindri.Ui.Views.Sandbox.SandboxParkCard"
             x:DataType="sb:SandboxParkCardViewModel">
  <!-- The park card (sandbox spec 8): a named focus-region group whose name is "Needs you: Step x can't start, <first clause>", never the reason code. The fix
       text and its copyable command come before the buttons; the severity is a word and a mark, and a gray or waiting card is never red. -->
  <Border x:Name="SandboxParkRegion" Classes="card-section focus-region" Focusable="True" AutomationProperties.Name="{Binding Name}">
    <StackPanel Spacing="{StaticResource Space.XS}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <icons:StateIcon x:Name="SandboxParkGlyph" Glyph="{Binding Glyph}" VerticalAlignment="Center" />
        <TextBlock x:Name="SandboxParkSeverity" Classes="eyebrow" Text="{Binding Severity}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Severity}" />
      </StackPanel>
      <TextBlock x:Name="SandboxParkSentence" Classes="body" Text="{Binding Sentence}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Sentence}" />
      <StackPanel x:Name="SandboxParkCommand" Orientation="Horizontal" Spacing="6" IsVisible="{Binding Row.HasCommand}">
        <TextBlock Classes="mono subtle" Text="{Binding Row.Command}" TextWrapping="Wrap" MaxWidth="420" VerticalAlignment="Center" AutomationProperties.Name="{Binding Row.Command}" />
        <Button x:Name="SandboxParkCopy" Classes="copy" Click="OnCopy" AutomationProperties.Name="{Binding Row.CopyName}">
          <TextBlock Classes="caption" Text="Copy" AutomationProperties.AccessibilityView="Raw" />
        </Button>
      </StackPanel>
      <sv:SandboxCheckPanel x:Name="SandboxParkCheck" DataContext="{Binding Check}" />
    </StackPanel>
  </Border>
</UserControl>
