<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:todo="using:Aw.Sindri.Ui.ViewModels.Todo"
             xmlns:tv="using:Aw.Sindri.Ui.Views.Todo"
             xmlns:shell="using:Aw.Sindri.Ui.ViewModels.Shell"
             x:Class="Aw.Sindri.Ui.Views.Todo.TodoPanel"
             x:DataType="todo:TodoPanelViewModel">
  <UserControl.Styles>
    <!-- The Show done toggle reads as the quiet "copy" link the other panels use, checked or not. -->
    <Style Selector="ToggleButton.done-toggle">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.done-toggle:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.done-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The 2 px selected border takes its extra 1 px back from the padding (base: 1 px + 6,2), so selecting a chip
         changes colours only: the text stays put and the chip keeps its size (#2761). -->
    <Style Selector="Border.phrase-chip.selected">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="5,1" />
    </Style>
    <!-- The live sync text takes its gap only while it has text, so count -> error is one gap when it is empty. -->
    <Style Selector="TextBlock.sync-gap">
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="TextBlock.caption.warning">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Attention}" />
    </Style>
    <Style Selector="Border.todo-group-head">
      <Setter Property="Padding" Value="24,8,24,4" />
    </Style>
  </UserControl.Styles>
  <!-- The Todo panel on Home (todo spec §3.1, §3.4, §3.5): a labelled region. Header: the title, the count line, the "N New todo" hint.
       Collapsed: up to five rows, overdue first, and "Show all N". Expanded: the groups in their own scroll (capped at half the
       window's height, TodoPanel.axaml.cs), the Show done toggle and Show less at the foot. Loading draws three skeleton rows as tall
       as a loaded row; an empty list says so. -->
  <Border x:Name="TodoPanelFrame" Classes="panel" Classes.region-focus="{Binding HasFocus}" Focusable="True" IsTabStop="False" FocusAdorner="{x:Null}" AutomationProperties.Name="{Binding Title}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
    <!-- Header on top, the body (collapsed or expanded) in the rest: the frame is capped at half the window (TodoPanel.axaml.cs), so
         the expanded list's own scroll gets what the header and the foot leave. -->
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Classes="phead">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <TextBlock x:Name="TodoTitle" Classes="body-strong" Classes.region-focus="{Binding HasFocus}" Text="{Binding Title}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}" />
          <!-- The count line, then the sync line (todo spec §3.1, §3.4): the quiet "Synced with Obsidian 10:05" is not a live region; the warnings and a pick's countdown share the polite one, which is always
               in the tree (its flag is set before any text). A warning draws in the warning text colour. -->
          <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
            <TextBlock x:Name="TodoCount" Margin="0,0,12,0" Classes="caption subtle" Text="{Binding CountLine}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding CountLine}" AutomationProperties.Name="{Binding CountLine}" />
            <TextBlock x:Name="TodoSyncQuiet" Grid.Column="1" Margin="0,0,12,0" Classes="caption subtle" Text="{Binding SyncQuiet}" IsVisible="{Binding SyncQuiet, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SyncQuiet}" AutomationProperties.Name="{Binding SyncQuiet}" />
            <TextBlock x:Name="TodoSyncLive" Grid.Column="2" Classes="caption subtle" Classes.sync-gap="{Binding SyncLive, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes.warning="{Binding SyncIsWarning}" AutomationProperties.LiveSetting="Polite" Text="{Binding SyncLive}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SyncLive}"
                       AutomationProperties.Name="{Binding SyncLive}" />
            <TextBlock x:Name="TodoError" Grid.Column="3" HorizontalAlignment="Left" Classes="caption warning" Text="{Binding Error}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding Error}" />
          </Grid>
          <!-- The quick-add hint (Home only): a keycap and its words. The key itself is the quick-add slice's. -->
          <StackPanel x:Name="TodoNewHint" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" AutomationProperties.Name="{Binding NewName}"
                      AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <Border Classes="kbd" VerticalAlignment="Center">
              <TextBlock x:Name="TodoNewKey" Classes="kbd" Text="{Binding NewKey}" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <TextBlock x:Name="TodoNewText" Classes="caption" Text="{Binding NewText}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Collapsed: one body of a fixed height in every state (spec D13, §3.4): five row slots (Show all shares the From elsewhere row below,
           the read error sits in the header). The rows, the skeleton and the empty sentence draw in the slots;
           none of them changes the height, so Needs you below never moves. TodoPanel.axaml.cs sets the height from Row.Height.Default. -->
      <Grid x:Name="TodoCollapsed" Grid.Row="1" ClipToBounds="True" IsVisible="{Binding !IsExpanded}">
        <StackPanel>
          <!-- The attention rows (a conflict or the hold, todo spec §3.1, D13) take the first slots, inside the five. -->
          <tv:AttentionArea x:Name="TodoAttentionCollapsed" />
          <!-- First load: three skeleton rows, each as tall as a loaded row (the same item-row), no shimmer. -->
          <StackPanel x:Name="TodoSkeleton" IsVisible="{Binding IsLoading}" AutomationProperties.AccessibilityView="Raw">
            <Border Classes="item-row">
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border Classes="skeleton" Width="20" Height="20" Margin="0,0,12,0" />
                <Border Grid.Column="1" Classes="skeleton" Width="300" />
                <Border Grid.Column="2" Classes="skeleton" Width="64" />
              </Grid>
            </Border>
            <Border Classes="item-row">
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border Classes="skeleton" Width="20" Height="20" Margin="0,0,12,0" />
                <Border Grid.Column="1" Classes="skeleton" Width="220" />
                <Border Grid.Column="2" Classes="skeleton" Width="48" />
              </Grid>
            </Border>
            <Border Classes="item-row">
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border Classes="skeleton" Width="20" Height="20" Margin="0,0,12,0" />
                <Border Grid.Column="1" Classes="skeleton" Width="260" />
                <Border Grid.Column="2" Classes="skeleton" Width="56" />
              </Grid>
            </Border>
          </StackPanel>

          <TextBlock x:Name="TodoEmpty" Classes="caption quiet" Text="{Binding EmptyText}" Margin="24,8" HorizontalAlignment="Left" TextAlignment="Left"
                     IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding EmptyText}" />

          <ItemsControl x:Name="TodoRows" ItemsSource="{Binding Rows}" IsVisible="{Binding !IsExpanded}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="todo:TodoRowViewModel">
                <tv:TodoRow />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>

      <!-- Expanded: the groups in their own scroll, then the foot. -->
      <Grid x:Name="TodoExpanded" Grid.Row="1" RowDefinitions="*,Auto" IsVisible="{Binding IsExpanded}">
        <ScrollViewer x:Name="TodoScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <tv:AttentionArea x:Name="TodoAttentionExpanded" />
            <ItemsControl x:Name="TodoGroups" ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="todo:TodoGroupViewModel">
                  <StackPanel>
                    <Border x:Name="TodoGroup" Classes="todo-group-head" AutomationProperties.Name="{Binding Heading}" AutomationProperties.AccessibilityView="Control"
                            AutomationProperties.ControlTypeOverride="Text" AutomationProperties.HeadingLevel="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TodoGroupHeading" Classes="eyebrow" Text="{Binding Heading}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Classes="caption subtle" Text="{Binding Rows.Count}" AutomationProperties.AccessibilityView="Raw" />
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="todo:TodoRowViewModel">
                          <tv:TodoRow />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="TodoDoneEmpty" Classes="caption subtle" Text="{Binding DoneEmptyText}" Margin="24,8"
                       IsVisible="{Binding DoneEmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding DoneEmptyText}" />
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,4">
            <ToggleButton x:Name="TodoDoneToggle" Classes="done-toggle" Click="OnToggleDone" IsChecked="{Binding ShowsDone, Mode=OneWay}"
                          AutomationProperties.Name="{Binding DoneToggleName}">
              <TextBlock x:Name="TodoDoneToggleText" Classes="caption" Text="{Binding DoneToggleText}" AutomationProperties.AccessibilityView="Raw" />
            </ToggleButton>
            <Button x:Name="TodoShowLess" Grid.Column="2" Classes="copy" Click="OnShowLess" AutomationProperties.Name="{Binding ShowLessText}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="caption" Text="{Binding ShowLessText}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <Border Classes="kbd" VerticalAlignment="Center">
                  <TextBlock Classes="kbd" Text="{Binding EscKey}" AutomationProperties.AccessibilityView="Raw" />
                </Border>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </Grid>

      <!-- The link list O opens on a row with several links (todo spec §3.3): a small card over the top right of the body. It takes no focus: the
           row keeps it, and J, K, Enter and Esc act on the list while it is open (ShellWindow.TodoKeys.cs). -->
      <Border x:Name="TodoLinkList" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,16,0" Padding="8" MinWidth="220"
              Background="{DynamicResource Brush.Surface3}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" CornerRadius="{StaticResource Radius.LG}"
              IsVisible="{Binding LinkList.IsOpen}" AutomationProperties.Name="{Binding LinkList.Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="List">
        <StackPanel Spacing="4">
          <ItemsControl x:Name="TodoLinkItems" ItemsSource="{Binding LinkList.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="todo:TodoLinkItemViewModel">
                <Border Classes="phrase-chip" Classes.selected="{Binding IsSelected}" Margin="0,2" AutomationProperties.Name="{Binding Ref}" AutomationProperties.AccessibilityView="Control"
                        AutomationProperties.ControlTypeOverride="ListItem">
                  <TextBlock x:Name="TodoLinkRef" Classes="caption mono" Text="{Binding Ref}" AutomationProperties.AccessibilityView="Raw" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption subtle" Text="{Binding LinkList.Hint}" AutomationProperties.AccessibilityView="Raw" />
        </StackPanel>
      </Border>

      <!-- The "From elsewhere" line (2 PRs waiting on your review · 1 Linear issue assigned, or Connect Linear when Linear is not set up): read-only counts under the
           rows, in a slot one row tall in every state (D13), so the collapsed panel's height never follows the line's words. Its view model
           is the shell's, not the panel's. -->
      <Border x:Name="TodoElsewhereSlot" Grid.Row="2" Height="{StaticResource Row.Height.Default}" ClipToBounds="True" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*">
          <Button x:Name="TodoShowAll" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="copy" Click="OnShowAll" IsVisible="{Binding ShowsShowAll}" Margin="16,0,0,0"
                  AutomationProperties.Name="{Binding ShowAllText}">
            <TextBlock x:Name="TodoShowAllText" Classes="caption" Text="{Binding ShowAllText}" AutomationProperties.AccessibilityView="Raw" />
          </Button>
          <tv:FromElsewhereLine x:Name="TodoElsewhere" Grid.Column="1" VerticalAlignment="Center" DataContext="{Binding $parent[Window].((shell:ShellViewModel)DataContext).Elsewhere}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
