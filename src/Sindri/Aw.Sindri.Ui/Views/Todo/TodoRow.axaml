<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:todo="using:Aw.Sindri.Ui.ViewModels.Todo"
             x:Class="Aw.Sindri.Ui.Views.Todo.TodoRow"
             x:DataType="todo:TodoRowViewModel">
  <UserControl.Styles>
    <!-- A ticked or removed todo reads quiet and struck through (words carry the state too: the row's sentence says "done" or "removed"). -->
    <Style Selector="Border.todo-row.done TextBlock.todo-text, Border.todo-row.removed TextBlock.todo-text">
      <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <!-- Overdue is words ("Overdue · Mon") in the error colour, never colour alone. -->
    <Style Selector="TextBlock.todo-due.overdue">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
    </Style>
  </UserControl.Styles>
  <!-- One todo row (todo spec §3.1, §3.5): the checkbox, the text, up to three link chips and "+N", the agent tag, the due word. The
       row is the one focus stop and carries the sentence; the checkbox is raw for a screen reader and takes no focus (its check-off is
       a later slice, and so are the row's keys). The row draws its own focus border (item-row), as every list row does. -->
  <Border x:Name="TodoRowFrame" Classes="item-row todo-row" Classes.done="{Binding IsDone}" Classes.removed="{Binding IsRemoved}" Focusable="True"
          AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
    <Panel>
    <!-- Enter edits in place (todo spec §3.3, §3.4): the same one-line row becomes three fields, Tab walks them, Enter saves and Esc cancels
         (TodoRow.axaml.cs). The fields belong to the edit, not to the row, so a read that lands meanwhile leaves them alone. -->
    <Border x:Name="TodoEditFrame" IsVisible="{Binding IsEditing}">
      <Grid x:Name="TodoEdit" DataContext="{Binding Edit}" x:DataType="todo:TodoEditViewModel" ColumnDefinitions="*,112,200,Auto" ColumnSpacing="8" VerticalAlignment="Center"
            KeyboardNavigation.TabNavigation="Cycle">
        <TextBox x:Name="TodoEditText" MinHeight="28" Padding="8,2" Text="{Binding Text}" AutomationProperties.Name="{Binding TextName}" />
        <TextBox x:Name="TodoEditDue" Grid.Column="1" MinHeight="28" Padding="8,2" Text="{Binding Due}" PlaceholderText="{Binding DuePlaceholder}" AutomationProperties.Name="{Binding DueName}" />
        <TextBox x:Name="TodoEditLinks" Grid.Column="2" MinHeight="28" Padding="8,2" Text="{Binding Links}" PlaceholderText="{Binding LinksPlaceholder}" AutomationProperties.Name="{Binding LinksName}" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="TodoEditSaving" Classes="caption subtle" Text="{Binding SavingText}" IsVisible="{Binding IsSaving}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="TodoEditLatest" Classes="caption" Text="{Binding Latest}" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Latest}"
                     IsVisible="{Binding Latest, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="TodoEditMessage" Classes="caption" Foreground="{DynamicResource Brush.Error}" Text="{Binding Message}" MaxWidth="260" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="TodoReading" ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center" IsVisible="{Binding IsReading}">
      <!-- Fluent's CheckBox template holds its 20 px box in a 32 px tall grid, so the row's 1 px top border made the row 33 (#2546).
           The -6 margins give back the 12 px around the box: the box stays centred and the row stays Row.Height.Default. -->
      <CheckBox x:Name="TodoDone" MinWidth="0" MinHeight="0" Padding="0" Margin="0,-6,12,-6" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False"
                IsChecked="{Binding IsDone, Mode=OneWay}" AutomationProperties.Name="{Binding DoneBoxName}" AutomationProperties.AccessibilityView="Raw" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock x:Name="TodoText" Classes="body todo-text" Text="{Binding Text}" MaxWidth="480" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding Text}" AutomationProperties.AccessibilityView="Raw" />
        <!-- The links sit right after the title, muted and unboxed (#2548): they are context, not controls. -->
        <ItemsControl x:Name="TodoChips" ItemsSource="{Binding Chips}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock x:Name="TodoChip" Classes="caption subtle mono" Text="{Binding}" AutomationProperties.AccessibilityView="Raw" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="TodoMoreChips" Classes="caption subtle" Text="{Binding MoreChips}" VerticalAlignment="Center"
                   IsVisible="{Binding MoreChips, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.AccessibilityView="Raw" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
        <!-- A key's write was refused: the row came back and says why, in words (the error colour), until the next change. -->
        <TextBlock x:Name="TodoNotice" Classes="caption" Foreground="{DynamicResource Brush.Error}" Text="{Binding Notice}"
                   IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.LiveSetting="Polite" />
        <Border x:Name="TodoTagFrame" Classes="phrase-chip" IsVisible="{Binding Tag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock x:Name="TodoTag" Classes="caption" Text="{Binding Tag}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
      </StackPanel>
      <TextBlock x:Name="TodoDue" Grid.Column="3" Classes="caption subtle todo-due" Classes.overdue="{Binding IsOverdue}" Text="{Binding DueWord}" MinWidth="104"
                 TextAlignment="Right" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
    </Grid>
    </Panel>
  </Border>
</UserControl>
