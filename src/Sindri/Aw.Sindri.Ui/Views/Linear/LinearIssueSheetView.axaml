<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvm="using:Aw.Sindri.Ui.ViewModels.Linear"
             xmlns:lv="using:Aw.Sindri.Ui.Views.Linear"
             x:Class="Aw.Sindri.Ui.Views.Linear.LinearIssueSheetView"
             x:DataType="lvm:LinearIssueSheetViewModel">
  <!-- A Linear issue's sheet (Linear hub spec §3, owner's pick A): the key and title, a two-column field grid (State, Priority, Assignee, Cycle, Labels, Project), the description,
       then the comments newest first. State and priority are words. Description and comments are plain text: web links open in the browser with their host shown, images are
       placeholders. When the server says the owner may write, the grid and the title and description become one form with a Save footer pinned under the scrolling part (the shell
       gives this sheet a fixed height, so the footer stays in view at 520 px); otherwise the sheet reads as text. Comments are in: a box above the list posts one. Every named line is a Border
       the screen reader reads as one text. -->
  <Grid x:Name="IssueSheet" RowDefinitions="*,Auto">
   <ScrollViewer x:Name="IssueFormScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{StaticResource Space.MD}">
    <TextBlock x:Name="IssueLoading" Classes="body muted" Text="{Binding LoadingText}" IsVisible="{Binding IsLoading}" AutomationProperties.Name="{Binding LoadingText}" />

    <StackPanel x:Name="IssueProblem" Spacing="8" IsVisible="{Binding IsProblem}">
      <Border x:Name="IssueProblemText" AutomationProperties.Name="{Binding ProblemText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Text="{Binding ProblemText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Button x:Name="IssueOpenInLinear" Content="{Binding OpenInLinearText}" IsVisible="{Binding CanOpenInLinear}" HorizontalAlignment="Left" Click="OnOpenInLinear" AutomationProperties.Name="{Binding OpenInLinearText}" />
    </StackPanel>

    <Border x:Name="IssueNote" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            AutomationProperties.Name="{Binding Note}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
      <TextBlock Classes="body muted" Text="{Binding Note}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
    </Border>

    <StackPanel x:Name="IssueBody" Spacing="{StaticResource Space.MD}" IsVisible="{Binding IsShown}">
      <Border x:Name="IssueWriteBanner" Classes="card" IsVisible="{Binding HasWriteBanner}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border AutomationProperties.Name="{Binding WriteBanner}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" VerticalAlignment="Center">
            <TextBlock Classes="body" Text="{Binding WriteBanner}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <Button x:Name="IssueConnect" Content="{Binding ConnectText}" IsVisible="{Binding CanConnect}" Click="OnConnect" AutomationProperties.Name="{Binding ConnectText}" />
        </StackPanel>
      </Border>

      <Border x:Name="IssueDiscard" Classes="card" IsVisible="{Binding IsConfirmingDiscard}">
        <StackPanel Spacing="8">
          <Border AutomationProperties.Name="{Binding DiscardHeading}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="body-strong" Text="{Binding DiscardHeading}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <Border AutomationProperties.Name="{Binding DiscardBody}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="body" Text="{Binding DiscardBody}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="IssueKeepEditing" Classes="accent" Content="{Binding KeepEditingText}" Click="OnKeepEditing" AutomationProperties.Name="{Binding KeepEditingText}" />
            <Button x:Name="IssueDiscardButton" Content="{Binding DiscardText}" IsEnabled="{Binding !IsSaving}" Click="OnDiscard" AutomationProperties.Name="{Binding DiscardText}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="IssueError" Classes="card" IsVisible="{Binding HasErrorBanner}" AutomationProperties.Name="{Binding ErrorBanner}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" AutomationProperties.LiveSetting="Polite">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Attention}" Text="{Binding ErrorBanner}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>

      <Border x:Name="IssueConflict" Classes="card" Focusable="True" IsVisible="{Binding HasConflict}" AutomationProperties.Name="{Binding ConflictHeadline}" AutomationProperties.LiveSetting="Polite">
        <StackPanel Spacing="8">
          <TextBlock Classes="body-strong" Text="{Binding ConflictHeadline}" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="{Binding ConflictNote}" TextWrapping="Wrap" />
          <ItemsControl x:Name="IssueConflictRows" ItemsSource="{Binding ConflictRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="lvm:LinearConflictRowViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                  <Border AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" VerticalAlignment="Center">
                    <StackPanel Spacing="2" AutomationProperties.AccessibilityView="Raw">
                      <TextBlock Classes="eyebrow" Text="{Binding Label}" />
                      <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Button Grid.Column="1" Name="IssueUseLinears" Content="{Binding UseLinearsText}" Click="OnUseLinears" AutomationProperties.Name="{Binding UseLinearsName}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="IssueUseLinearsAll" Content="{Binding UseLinearsAllText}" Click="OnUseLinearsAll" AutomationProperties.Name="{Binding UseLinearsAllText}" />
            <Button x:Name="IssueSaveMine" Content="{Binding SaveMineText}" IsEnabled="{Binding !IsLocked}" IsVisible="{Binding CanEdit}" Click="OnSaveMine" AutomationProperties.Name="{Binding SaveMineText}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="IssueRemoved" IsVisible="{Binding RemovedNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              AutomationProperties.Name="{Binding RemovedNote}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Foreground="{DynamicResource Brush.Attention}" Text="{Binding RemovedNote}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>

      <StackPanel x:Name="IssueTitleEdit" Spacing="2" IsVisible="{Binding CanEdit}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="eyebrow" Text="{Binding TitleField.Label}" AutomationProperties.AccessibilityView="Raw" />
          <Ellipse Name="IssueTitleDot" Width="6" Height="6" Fill="{DynamicResource Brush.Attention}" IsVisible="{Binding TitleField.IsChanged}" AutomationProperties.AccessibilityView="Raw" />
        </StackPanel>
        <TextBox x:Name="IssueTitleBox" Text="{Binding TitleField.Text}" IsEnabled="{Binding TitleField.IsEnabled}" TextWrapping="Wrap" AutomationProperties.Name="{Binding TitleField.Name}" />
      </StackPanel>

      <Border x:Name="IssueTitle" IsVisible="{Binding !CanEdit}" AutomationProperties.Name="{Binding Title}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body-strong" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>

      <ItemsControl x:Name="IssueEditFields" ItemsSource="{Binding EditFields}" IsVisible="{Binding CanEdit}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="lvm:LinearEditFieldViewModel">
            <StackPanel Name="IssueEditField" Margin="0,0,12,8" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="eyebrow" Text="{Binding Label}" AutomationProperties.AccessibilityView="Raw" />
                <Ellipse Name="IssueChangedDot" Width="6" Height="6" Fill="{DynamicResource Brush.Attention}" IsVisible="{Binding IsChanged}" AutomationProperties.AccessibilityView="Raw" />
              </StackPanel>
              <ComboBox Name="IssueFieldPicker" IsVisible="{Binding IsChoice}" IsEnabled="{Binding IsEnabled}" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="lvm:LinearChoiceViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ItemsControl Name="IssueFieldTicks" IsVisible="{Binding IsTicks}" IsEnabled="{Binding IsEnabled}" ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="lvm:LinearChoiceViewModel">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsTicked, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Name="IssueFieldFixed" IsVisible="{Binding !IsEditable}" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                <TextBlock Classes="body" Text="{Binding Value}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
              </Border>
              <TextBlock Name="IssueFieldUnavailable" Classes="caption muted" Text="{Binding UnavailableText}" IsVisible="{Binding HasUnavailableText}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl x:Name="IssueFields" ItemsSource="{Binding Fields}" IsVisible="{Binding !CanEdit}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="lvm:LinearIssueFieldViewModel">
            <Border Name="IssueField" Margin="0,0,12,4" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
              <StackPanel Spacing="2" AutomationProperties.AccessibilityView="Raw">
                <TextBlock Classes="eyebrow" Text="{Binding Label}" />
                <TextBlock Classes="body" Text="{Binding Value}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Panel IsVisible="{Binding HasPr}">
        <Button x:Name="IssuePrChip" HorizontalAlignment="Left" Click="OnOpenPr" IsVisible="{Binding CanOpenPr}" AutomationProperties.Name="{Binding PrName}">
          <TextBlock Classes="caption" Text="{Binding PrText}" />
        </Button>
        <Border x:Name="IssuePrText" HorizontalAlignment="Left" IsVisible="{Binding !CanOpenPr}" BorderThickness="1" BorderBrush="{DynamicResource Brush.HairlineStrong}"
                CornerRadius="{StaticResource Radius.XS}" Padding="6,1" AutomationProperties.Name="{Binding PrText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="caption" Text="{Binding PrText}" AutomationProperties.AccessibilityView="Raw" />
        </Border>
      </Panel>

      <StackPanel Spacing="4">
        <TextBlock Classes="eyebrow" Text="{Binding DescriptionHeading}" AutomationProperties.AccessibilityView="Raw" />
        <TextBox x:Name="IssueDescriptionBox" Text="{Binding DescriptionField.Text}" IsVisible="{Binding CanEdit}" IsEnabled="{Binding DescriptionField.IsEnabled}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="96" AutomationProperties.Name="{Binding DescriptionField.Name}" />
        <TextBlock x:Name="IssueNoDescription" Classes="body muted" Text="{Binding NoDescriptionText}" IsVisible="{Binding ShowsNoDescription}" />
        <ItemsControl x:Name="IssueDescription" ItemsSource="{Binding Description}" IsVisible="{Binding !CanEdit}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="lvm:LinearTextLine"><lv:LinearLineView Line="{Binding}" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBox x:Name="IssueCommentBox" Text="{Binding CommentText}" IsEnabled="{Binding CanComment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" PlaceholderText="{Binding CommentPlaceholder}" AutomationProperties.Name="{Binding CommentName}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="IssueCommentPost" Content="{Binding PostText}" IsEnabled="{Binding CanPost}" Click="OnPostComment" AutomationProperties.Name="{Binding PostText}" />
          <Button x:Name="IssueCommentRetry" Content="{Binding RetryText}" IsVisible="{Binding CanRetryComment}" Click="OnRetryComment" AutomationProperties.Name="{Binding RetryText}" />
        </StackPanel>
        <TextBlock x:Name="IssueCommentStatus" Classes="caption" Text="{Binding CommentStatus}" TextWrapping="Wrap" AutomationProperties.Name="{Binding CommentStatus}" AutomationProperties.LiveSetting="Polite" />
        <Border x:Name="IssueCommentError" Classes="card" IsVisible="{Binding HasCommentError}" AutomationProperties.Name="{Binding CommentError}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text" AutomationProperties.LiveSetting="Polite">
          <TextBlock Classes="body" Foreground="{DynamicResource Brush.Attention}" Text="{Binding CommentError}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <TextBlock x:Name="IssueCommentNote" Classes="caption" Text="{Binding CommentNote}" IsVisible="{Binding HasCommentNote}" TextWrapping="Wrap" AutomationProperties.Name="{Binding CommentNote}" />
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding HasComments}">
        <TextBlock Classes="eyebrow" Text="{Binding CommentsHeading}" AutomationProperties.AccessibilityView="Raw" />
        <ItemsControl x:Name="IssueComments" ItemsSource="{Binding Comments}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="lvm:LinearCommentViewModel">
              <Border Name="IssueComment" Classes="card" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border AutomationProperties.Name="{Binding Heading}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                      <TextBlock Classes="caption subtle" Text="{Binding Heading}" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.HairlineStrong}" CornerRadius="{StaticResource Radius.XS}" Padding="6,1" IsVisible="{Binding FromSindri}">
                      <TextBlock Classes="caption subtle" Text="Sindri" />
                    </Border>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="lvm:LinearTextLine"><lv:LinearLineView Line="{Binding}" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <SelectableTextBlock x:Name="IssueLinkLaunchFailed" Classes="caption error" Text="{Binding LinkLaunch.FailedText}" IsVisible="{Binding LinkLaunch.Failed}" TextWrapping="Wrap" AutomationProperties.Name="{Binding LinkLaunch.FailedText}" />
    </StackPanel>
    </StackPanel>
   </ScrollViewer>

   <Border x:Name="IssueFooter" Grid.Row="1" IsVisible="{Binding CanEdit}" BorderBrush="{DynamicResource Brush.HairlineStrong}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
     <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
       <Border x:Name="IssueDirty" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding DirtyLine}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
         <TextBlock Classes="caption subtle" Text="{Binding DirtyLine}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
       </Border>
       <Button x:Name="IssueRetry" Grid.Row="0" Grid.Column="1" Margin="0,0,8,0" Content="{Binding RetryText}" IsVisible="{Binding CanRetry}" Click="OnRetry" AutomationProperties.Name="{Binding RetryText}" />
       <Button x:Name="IssueSave" Grid.Row="0" Grid.Column="2" Classes="accent" Content="{Binding SaveText}" IsEnabled="{Binding CanSave}" Click="OnSave" AutomationProperties.Name="{Binding SaveText}" />
       <TextBlock x:Name="IssueStatus" Grid.Row="1" Grid.ColumnSpan="3" Classes="caption" Text="{Binding StatusLine}" TextWrapping="Wrap" AutomationProperties.Name="{Binding StatusLine}" AutomationProperties.LiveSetting="Polite" />
     </Grid>
   </Border>
  </Grid>
</UserControl>
