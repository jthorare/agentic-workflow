<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:item="using:Aw.Sindri.Ui.ViewModels.Item"
             xmlns:ny="using:Aw.Sindri.Ui.ViewModels.NeedsYou"
             xmlns:vmc="using:Aw.Sindri.Ui.ViewModels.Controls"
             xmlns:controls="using:Aw.Sindri.Ui.Views.Controls"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             x:Class="Aw.Sindri.Ui.Views.Item.ItemSheet"
             x:DataType="item:ItemSheetViewModel">
  <!-- The item detail (UI spec §4.6, item-detail.html), inside the shell's sheet: the header (title, repo, the state as a
       word, version, since), who created it and what it waits on, the item's actions from the catalog (Close item with
       the version shown; Close as cancelled confirms first), and the timeline paged by 'next'. SND-ITEM-404 shows its
       detail; SND-ITEM-409 shows its detail once the re-read item no longer allows the pressed control (§9.1). -->
  <StackPanel Spacing="{StaticResource Space.MD}">
    <StackPanel x:Name="ItemSkeleton" Spacing="10" IsVisible="{Binding IsLoading}">
      <Border Classes="skeleton" Width="300" />
      <Border Classes="skeleton" Width="220" />
      <Border Classes="skeleton" Width="260" />
    </StackPanel>

    <StackPanel x:Name="ProblemLine" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasProblem}">
      <icons:StateIcon Glyph="Down" Classes="error" VerticalAlignment="Top" />
      <TextBlock x:Name="ProblemCodeText" Classes="caption error" Text="{Binding ProblemCode}" AutomationProperties.Name="{Binding ProblemCode}" />
      <TextBlock x:Name="ProblemDetailText" Classes="caption" Text="{Binding ProblemDetail}" TextWrapping="Wrap" MaxWidth="440"
                 AutomationProperties.Name="{Binding ProblemDetail}" />
    </StackPanel>

    <!-- SND-ITEM-404 (§4.6): Back closes the sheet like Esc. Where the sheet covers the page its header's Back does the same, so this one hides. -->
    <Button x:Name="NotFoundBack" Classes="not-found-back" Classes.shown="{Binding IsNotFound}" Content="{Binding Text.Back}" Click="OnBack"
            HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text.Back}" />

    <StackPanel x:Name="ItemBody" Spacing="{StaticResource Space.MD}" IsVisible="{Binding HasItem}">
      <StackPanel Spacing="4">
        <TextBlock x:Name="ItemTitle" Classes="detail-title" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Title}" />
        <!-- F3 (owner example): the sheet leads with the title and one status sentence ("Running for 2h 56m"), then the repo,
             what it waits for, the body and the tracker link: what decides what to do with the item. Who made it, its
             version and the run's address are bookkeeping, so they wait behind Details, closed until asked for. -->
        <WrapPanel x:Name="ItemMeta" Orientation="Horizontal">
          <TextBlock x:Name="ItemStatusLine" Classes="caption body-strong" Text="{Binding StatusLine}" Margin="0,0,12,0" AutomationProperties.Name="{Binding StatusLine}" />
          <TextBlock Classes="caption subtle" Text="{Binding Repo}" Margin="0,0,12,0" AutomationProperties.Name="{Binding Repo}" />
          <StackPanel x:Name="ItemStale" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsStale}">
            <icons:StateIcon Glyph="Stale" VerticalAlignment="Center" />
            <TextBlock Classes="caption subtle" Text="{Binding Text.Stale}" VerticalAlignment="Center" />
          </StackPanel>
        </WrapPanel>
        <Grid Classes="row" ColumnDefinitions="110,*" IsVisible="{Binding HasWaitingOn}">
          <TextBlock Classes="caption subtle row-label" Text="{Binding Text.WaitingOn}" />
          <TextBlock x:Name="ItemWaitingOn" Grid.Column="1" Classes="mono" Text="{Binding WaitingOn}" AutomationProperties.Name="{Binding WaitingOn}" />
        </Grid>
        <!-- §4.6 (owner, 2026-10-12): the body as served (scrubbed, plain text) and the tracker link. -->
        <TextBlock x:Name="ItemBodyText" Classes="body" Text="{Binding Body}" TextWrapping="Wrap" IsVisible="{Binding HasBody}"
                   Margin="0,6,0,6" AutomationProperties.Name="{Binding Body}" />
        <Grid Classes="row" ColumnDefinitions="110,*" IsVisible="{Binding HasLink}">
          <TextBlock Classes="caption subtle row-label" Text="{Binding Text.Link}" />
          <TextBlock x:Name="ItemLinkText" Grid.Column="1" Classes="mono" Text="{Binding Link}" AutomationProperties.Name="{Binding Link}" />
        </Grid>
      </StackPanel>

      <StackPanel x:Name="ItemActions" Spacing="6" IsVisible="{Binding HasActions}">
        <TextBlock Classes="eyebrow" Text="{Binding Text.Actions}" />
        <ItemsControl x:Name="ItemActionList" ItemsSource="{Binding Actions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vmc:ControlViewModel">
              <controls:CommandControl />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Border x:Name="ItemDecisionsCallout" Classes.callout="{Binding HasOpenDecision}">
      <StackPanel x:Name="ItemDecisions" Spacing="6">
        <TextBlock Classes="eyebrow" Text="{Binding Text.Decisions}" />
        <TextBlock x:Name="ItemDecisionsEmpty" Classes="body muted" Text="{Binding Needs.DecisionsEmpty}" TextWrapping="Wrap"
                   IsVisible="{Binding Needs.DecisionsEmpty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ItemsControl x:Name="ItemDecisionList" ItemsSource="{Binding Needs.Decisions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="item:ItemDecisionRow">
              <StackPanel Spacing="4" Margin="0,0,0,8" AutomationProperties.Name="{Binding Id}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
                <TextBlock Classes="body" Text="{Binding Question}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Options}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ny:DecisionOption">
                      <Button Classes="command-control decision-option" Classes.primary="{Binding IsRecommended}" Content="{Binding Label}" IsEnabled="{Binding IsEnabled}"
                              Click="OnDecisionOption" Margin="0,0,8,8" ToolTip.Tip="{Binding Reason}" ToolTip.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding Reason}" AutomationProperties.Name="{Binding Name}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Orientation="Horizontal" IsVisible="{Binding DecideLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <Border Classes="pending-line" Focusable="True" AutomationProperties.Name="{Binding LineName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                    <TextBlock Classes="caption subtle" TextWrapping="Wrap" Margin="0,0,6,0" Text="{Binding DecideLine}" AutomationProperties.AccessibilityView="Raw" />
                  </Border>
                  <Button Classes="copy" Click="OnCopyDecide" IsVisible="{Binding CanCopy}" AutomationProperties.Name="{Binding CopyName}">
                    <TextBlock Classes="caption" Text="{Binding CopyLabel}" />
                  </Button>
                </WrapPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="ItemOpenNeedsYou" Content="{Binding Text.OpenNeedsYou}" Click="OnOpenNeedsYou" HorizontalAlignment="Left" IsVisible="{Binding HasOpenDecision}"
                AutomationProperties.Name="{Binding Text.OpenNeedsYou}" />
        <TextBlock x:Name="ItemDecisionRefusal" Classes="caption" Text="{Binding Needs.Refusal}" TextWrapping="Wrap"
                   IsVisible="{Binding Needs.Refusal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      </Border>

      <StackPanel x:Name="ItemRequests" Spacing="6">
        <TextBlock Classes="eyebrow" Text="{Binding Text.Requests}" />
        <TextBlock x:Name="ItemRequestsEmpty" Classes="body muted" Text="{Binding Needs.RequestsEmpty}" TextWrapping="Wrap"
                   IsVisible="{Binding Needs.RequestsEmpty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ItemsControl x:Name="ItemRequestList" ItemsSource="{Binding Needs.Requests}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="item:ItemRequestRow">
              <StackPanel Spacing="2" Margin="0,0,0,6" AutomationProperties.Name="{Binding Id}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="mono" Text="{Binding Kind}" />
                  <TextBlock Classes="caption subtle" Text="{Binding State}" />
                  <TextBlock Classes="caption subtle" Text="{Binding Actor}" />
                </StackPanel>
                <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Expander x:Name="ItemDetailsExpander" Header="{Binding Text.Details}" IsExpanded="{Binding DetailsOpen, Mode=TwoWay}" AutomationProperties.Name="{Binding Text.Details}">
        <StackPanel x:Name="ItemDetails" Spacing="4">
          <Grid Classes="row" ColumnDefinitions="110,*,Auto">
            <TextBlock Classes="caption subtle row-label" Text="{Binding Text.ItemIdLabel}" />
            <TextBlock x:Name="ItemIdText" Grid.Column="1" Classes="mono" Text="{Binding ItemId}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding ItemId}" />
            <Button x:Name="ItemCopyId" Grid.Column="2" Classes="copy" Click="OnCopyId" AutomationProperties.Name="{Binding Text.CopyItemId}">
              <TextBlock Classes="caption" Text="{Binding Text.CopyItemId}" />
            </Button>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="110,*">
            <TextBlock Classes="caption subtle row-label" Text="{Binding Text.CreatedBy}" />
            <TextBlock x:Name="ItemCreatedBy" Grid.Column="1" Classes="mono" Text="{Binding CreatedBy}" AutomationProperties.Name="{Binding CreatedBy}" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="110,*">
            <TextBlock Classes="caption subtle row-label" Text="{Binding Text.VersionLabel}" />
            <TextBlock x:Name="ItemVersion" Grid.Column="1" Classes="mono" Text="{Binding VersionText}" AutomationProperties.Name="{Binding VersionText}" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="110,*" IsVisible="{Binding HasInstance}">
            <TextBlock Classes="caption subtle row-label" Text="{Binding Text.InstanceLabel}" />
            <TextBlock x:Name="ItemInstance" Grid.Column="1" Classes="mono" Text="{Binding Instance}" AutomationProperties.Name="{Binding Instance}" />
          </Grid>
        </StackPanel>
      </Expander>

      <StackPanel x:Name="ItemTimeline" Spacing="6">
        <TextBlock Classes="eyebrow" Text="{Binding Text.Timeline}" />
        <ItemsControl x:Name="TimelineList" ItemsSource="{Binding Timeline}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="item:TimelineRow">
              <Border Classes="timeline-row" Focusable="True" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
                <Grid ColumnDefinitions="70,*">
                  <TextBlock Classes="mono subtle" Text="{Binding Time}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="mono" Text="{Binding Type}" />
                      <TextBlock Classes="caption subtle" Text="{Binding Actor}" />
                    </StackPanel>
                    <TextBlock Classes="body" Text="{Binding Line}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="LoadMoreButton" Classes="copy" Click="OnLoadMore" IsVisible="{Binding HasMore}"
                AutomationProperties.Name="{Binding LoadMoreName}">
          <TextBlock Classes="caption" Text="{Binding Text.LoadMore}" />
        </Button>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
