<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rows="using:Aw.Sindri.Ui.Views.Queue">
  <!-- The queue's and the item sheet's looks (UI spec §4.5, §4.6, §14; queue.html, item-detail.html): rows on a hairline,
       the selected row with a 2 px Primary bar (a shape, never colour alone: it also reads "selected" by focus), group
       headers as quiet toggles, timeline entries on a hairline. Tokens only. -->
  <Style Selector="Border.item-row">
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.item-row.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="BorderThickness" Value="2,1,0,0" />
    <Setter Property="Padding" Value="14,0,16,0" />
  </Style>
  <!-- Proof B2/B7: a row and the controls in it draw their focus ring inside their own template, not in the window's adorner
       layer, which is above the sheet: the page runs full width under the sheet, the sheet covers the ring and the page's
       ScrollViewer clips it. The ring is the same 2 px PrimaryHover as everywhere (Theme/FluentOverrides.axaml); the padding
       gives up what the border takes so the row's content does not move. -->
  <Style Selector="Border.item-row">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Border.item-row:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryHover}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="14,0,14,0" />
  </Style>
  <Style Selector="Border.item-row.selected:focus-visible">
    <Setter Property="Padding" Value="14,0,14,0" />
  </Style>
  <Style Selector="Border.item-row Button">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <!-- N9: focusing changes only the colour. A title button's presenter always has the 2 px border (transparent), inside
       the button so the button's clip keeps the whole ring (B9); the button's -2 margin gives the size back. A command
       control's 1 px border grows to 2 px while its padding gives 1 px up. -->
  <Style Selector="Border.item-row Button.row-title">
    <Setter Property="Margin" Value="-2" />
  </Style>
  <Style Selector="Border.item-row Button.row-title /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
  </Style>
  <Style Selector="Border.item-row Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryHover}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
  </Style>
  <Style Selector="Border.item-row Button.command-control:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Padding" Value="9,3" />
  </Style>
  <!-- A primary button's fill is Primary, so a PrimaryHover rim reads 1.6:1 against it: its ring in a row is Ink (4.42:1 on the fill, 17:1 on the row). -->
  <Style Selector="Border.item-row Button.command-control.primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.row-title">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.group-head">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="ToggleButton.group-head:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.timeline-row">
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.XS}" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="Button.held-pill">
    <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.LG}" />
    <Setter Property="Padding" Value="10,2" />
  </Style>
  <Style Selector="Button.command-control.destructive">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
  </Style>
  <!-- A stage the app has no plain name for shows as served, grey. -->
  <Style Selector="Border.item-row TextBlock.raw">
    <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
  </Style>
  <!-- The All / Running segments. -->
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="Button.segment.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
  </Style>
  <!-- An open decision on the item sheet: an amber callout. -->
  <Style Selector="Border.callout">
    <Setter Property="Background" Value="{DynamicResource Brush.AttentionSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Attention}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
    <Setter Property="Padding" Value="12" />
  </Style>
</Styles>
