<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:queue="using:Aw.Sindri.Ui.ViewModels.Queue"
             x:Class="Aw.Sindri.Ui.Views.Queue.CompactItemRow"
             x:DataType="queue:ItemRowViewModel">
  <!-- An item row in Home's half-width panels (home.html): title (the id is its tooltip), the state as a word, and the age. A title click
       opens the sheet, as on the Queue page. -->
  <Border x:Name="RowFrame" Classes="item-row clickable" Classes.selected="{Binding IsSelected}" Focusable="True"
          AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
    <Grid x:Name="CompactRow" ColumnDefinitions="*,Auto,50" VerticalAlignment="Center">
      <Button x:Name="CompactTitle" Classes="row-title" Click="OnOpen" AutomationProperties.Name="{Binding OpenName}" ToolTip.Tip="{Binding Id}">
        <TextBlock Classes="body-strong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding Title}" />
      </Button>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
        <TextBlock Classes="caption subtle" Text="{Binding StateWord}" VerticalAlignment="Center" AutomationProperties.Name="{Binding StateWord}" />
        <Border Classes="badge" IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
          <TextBlock Classes="caption" Text="{Binding Badge}" AutomationProperties.Name="{Binding Badge}" />
        </Border>
      </StackPanel>
      <TextBlock Grid.Column="2" Classes="caption subtle" Text="{Binding Age}" VerticalAlignment="Center" TextAlignment="Right" AutomationProperties.Name="{Binding Age}" />
    </Grid>
  </Border>
</UserControl>
