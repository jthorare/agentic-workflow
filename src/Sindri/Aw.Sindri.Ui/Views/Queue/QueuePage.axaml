<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Aw.Sindri.Ui.ViewModels.Shell"
             xmlns:queue="using:Aw.Sindri.Ui.ViewModels.Queue"
             xmlns:rows="using:Aw.Sindri.Ui.Views.Queue"
             xmlns:controls="using:Aw.Sindri.Ui.Views.Controls"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             x:Class="Aw.Sindri.Ui.Views.Queue.QueuePage"
             x:DataType="shell:ShellViewModel">
  <!-- The Queue page (UI spec §4.5, queue.html): the API's groups in its order, each a collapsible section with its
       count; empty groups hidden (a filtered one shows its own sentence, E-18); the view's own sentence when every group
       is empty; skeleton rows on the first load only (§4.1). Create item (C) sits at the right of the title. -->
  <StackPanel Spacing="{StaticResource Size.PanelGap}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Classes="page-title" Text="{Binding Text.Work}" AutomationProperties.Name="{Binding Text.Work}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="CreateButton" Classes="command-control" Click="OnCreate" AutomationProperties.Name="{Binding Text.Items.CreateItem}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="button" Text="{Binding Text.Items.CreateItem}" VerticalAlignment="Center" />
            <Border Classes="kbd" VerticalAlignment="Center"><TextBlock Classes="kbd" Text="C" /></Border>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- F3 spec work §2: the toolbar: All and Running with counts, the repo chip, then the text filter below. -->
    <StackPanel x:Name="QueueToolbar" Orientation="Horizontal" Spacing="8">
      <Button x:Name="SegmentAll" Classes="segment" Classes.selected="{Binding !Queue.IsRunningSegment}" Content="{Binding Queue.AllSegment}" Click="OnSegmentAll" AutomationProperties.Name="{Binding Queue.AllSegment}" />
      <Button x:Name="SegmentRunning" Classes="segment" Classes.selected="{Binding Queue.IsRunningSegment}" Content="{Binding Queue.RunningSegment}" Click="OnSegmentRunning" AutomationProperties.Name="{Binding Queue.RunningSegment}" />
      <ComboBox x:Name="QueueRepo" ItemsSource="{Binding Queue.RepoChoices}" SelectedIndex="0" SelectionChanged="OnRepoChosen" MinWidth="140" Height="28" AutomationProperties.Name="{Binding Text.Items.RepoChip}" />
    </StackPanel>

    <!-- §4.1: a first read that failed says what the API said (the skeleton ends); a later failure marks the rows shown stale. -->
    <StackPanel x:Name="QueueProblem" Orientation="Horizontal" Spacing="6" IsVisible="{Binding Queue.HasProblem}">
      <icons:StateIcon Glyph="Down" Classes="error" VerticalAlignment="Top" />
      <TextBlock x:Name="QueueProblemCode" Classes="caption error" Text="{Binding Queue.ProblemCode}" AutomationProperties.Name="{Binding Queue.ProblemCode}" />
      <TextBlock x:Name="QueueProblemDetail" Classes="caption" Text="{Binding Queue.ProblemDetail}" TextWrapping="Wrap" MaxWidth="560"
                 AutomationProperties.Name="{Binding Queue.ProblemDetail}" />
    </StackPanel>
    <StackPanel x:Name="QueueStale" Orientation="Horizontal" Spacing="4" IsVisible="{Binding Queue.IsStale}">
      <icons:StateIcon Glyph="Stale" VerticalAlignment="Center" />
      <TextBlock Classes="caption subtle" Text="{Binding Text.Stale}" VerticalAlignment="Center" />
    </StackPanel>

    <!-- §8 `/`: the filter field (id, title, repo); Esc clears and closes it. -->
    <TextBox x:Name="QueueFilter" Text="{Binding Queue.FilterText}" IsVisible="{Binding Queue.IsFiltering}"
             PlaceholderText="{Binding Text.Items.Filter}" AutomationProperties.Name="{Binding Text.Items.Filter}" />

    <!-- §8: while the pointer is over the panel, new rows wait behind this pill instead of shifting the rows. -->
    <Button x:Name="QueueHeldPill" Classes="held-pill" Click="OnShowHeld" IsVisible="{Binding Queue.HasHeld}" HorizontalAlignment="Center"
            AutomationProperties.Name="{Binding Queue.HeldText}">
      <TextBlock Classes="caption" Text="{Binding Queue.HeldText}" />
    </Button>

    <Border x:Name="QueuePanel" Classes="panel" AutomationProperties.Name="{Binding Text.Work}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group"
            PointerEntered="OnPanelEntered" PointerExited="OnPanelExited">
      <StackPanel>
        <Border Classes="phead">
          <Grid x:Name="QueueHeader">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" />
        <ColumnDefinition Width="110" /><ColumnDefinition Width="70" /><ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>
            <TextBlock Classes="eyebrow" Text="{Binding Text.Items.ColumnTitle}" />
            <TextBlock Grid.Column="1" Classes="eyebrow" Text="{Binding Text.Items.ColumnRepo}" />
            <TextBlock Grid.Column="2" Classes="eyebrow" Text="{Binding Text.Items.ColumnState}" />
            <TextBlock Grid.Column="3" Classes="eyebrow" Text="{Binding Text.Items.ColumnStep}" />
            <TextBlock Grid.Column="4" Classes="eyebrow" Text="{Binding Text.Items.ColumnSince}" />
          </Grid>
        </Border>

        <StackPanel x:Name="QueueSkeleton" IsVisible="{Binding Queue.IsLoading}">
          <Grid Classes="skrow" ColumnDefinitions="*,60"><Border Classes="skeleton" Width="360" /><Border Grid.Column="1" Classes="skeleton" Width="40" /></Grid>
          <Grid Classes="skrow" ColumnDefinitions="*,60"><Border Classes="skeleton" Width="280" /><Border Grid.Column="1" Classes="skeleton" Width="40" /></Grid>
          <Grid Classes="skrow" ColumnDefinitions="*,60"><Border Classes="skeleton" Width="420" /><Border Grid.Column="1" Classes="skeleton" Width="40" /></Grid>
        </StackPanel>

        <StackPanel x:Name="QueueNothing" IsVisible="{Binding Queue.ShowsNothing}" Spacing="4" Margin="16,12">
          <TextBlock Classes="body-strong" Text="{Binding Queue.NothingTitle}" AutomationProperties.Name="{Binding Queue.NothingTitle}" />
          <TextBlock x:Name="QueueEmpty" Classes="caption quiet" Text="{Binding Queue.EmptyText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Queue.EmptyText}" />
        </StackPanel>
        <StackPanel x:Name="QueueNoMatch" IsVisible="{Binding Queue.ShowsNoMatch}" Spacing="8" Margin="16,12">
          <TextBlock Classes="body-strong" Text="{Binding Queue.NoMatchTitle}" AutomationProperties.Name="{Binding Queue.NoMatchTitle}" />
          <Button x:Name="QueueClearFilter" Content="{Binding Queue.ClearFilterText}" Click="OnClearFilter" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Queue.ClearFilterText}" />
        </StackPanel>

        <ItemsControl x:Name="QueueGroups" ItemsSource="{Binding Queue.Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="queue:QueueGroupViewModel">
              <StackPanel IsVisible="{Binding IsVisible}">
                <ToggleButton Classes="group-head" IsChecked="{Binding IsExpanded}" AutomationProperties.Name="{Binding Header}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="caption subtle" Text="▾" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Classes="body-strong" Text="{Binding Label}" />
                    <TextBlock Classes="caption subtle" Text="{Binding Count}" />
                  </StackPanel>
                </ToggleButton>
                <TextBlock Classes="caption quiet" Text="{Binding Empty}" IsVisible="{Binding ShowsEmpty}" AutomationProperties.Name="{Binding Empty}" />
                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="queue:ItemRowViewModel">
                      <rows:ItemRow />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <StackPanel x:Name="QueueClosed">
      <ToggleButton x:Name="QueueClosedToggle" Classes="group-head" IsChecked="{Binding Queue.IsClosedOpen, Mode=OneWay}" Click="OnClosedToggle" AutomationProperties.Name="{Binding Queue.ClosedHeader}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="caption subtle" Text="▸" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Classes="body-strong" Text="{Binding Queue.ClosedHeader}" />
        </StackPanel>
      </ToggleButton>
      <ItemsControl x:Name="QueueClosedRows" ItemsSource="{Binding Queue.ClosedRows}" IsVisible="{Binding Queue.IsClosedOpen}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="queue:ItemRowViewModel">
            <rows:ItemRow />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <TextBlock x:Name="QueueFooter" Classes="caption subtle" Text="{Binding Queue.FooterText}" AutomationProperties.Name="{Binding Queue.FooterText}" />
  </StackPanel>
</UserControl>
