<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="using:Aw.Sindri.Ui.ViewModels.Approvals"
             x:Class="Aw.Sindri.Ui.Views.Approvals.ApproveAllDialog"
             x:DataType="ap:ApproveAllViewModel">
  <!-- Approve all workflows (setup-once spec §4, §5.3): a modal over a scrim. The plan in words (one row for each workflow: its name, why it is
       there, what it can do; ids and hashes wait in Details), then one Approve button. Esc or Close shuts it with
       nothing sent. The lines that change are one static wrapper each, named by a view-model string, with the text inside left raw (a TextBlock's
       peer ignores a Name). -->
  <UserControl.Styles>
    <Style Selector="Border.scrim">
      <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.LG}" />
      <Setter Property="Padding" Value="{StaticResource Space.LG.Thickness}" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <Border Classes="scrim" PointerPressed="OnScrim" />
    <Border x:Name="ApproveAllCard" Classes="dialog" Width="600" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0"
            KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.ControlTypeOverride="Window" AutomationProperties.AccessibilityView="Control"
            AutomationProperties.Name="{Binding Title}">
      <ScrollViewer MaxHeight="720" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="0,0,12,0">
          <TextBlock Classes="detail-title" Text="{Binding Title}" />
          <Border x:Name="ApproveReading" IsVisible="{Binding IsReading}" AutomationProperties.Name="{Binding ReadingText}"
                  AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="caption subtle" Text="{Binding ReadingText}" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <Border x:Name="ApproveEmpty" IsVisible="{Binding IsEmpty}" AutomationProperties.Name="{Binding EmptyText}"
                  AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="body" Text="{Binding EmptyText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>

          <StackPanel x:Name="ApprovePlan" Spacing="8" IsVisible="{Binding ShowsPlan}">
            <TextBlock Classes="body-strong" Text="{Binding Heading}" />
            <TextBlock Classes="caption subtle" Text="{Binding Why}" TextWrapping="Wrap" />
            <ItemsControl x:Name="ApproveRows" ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ap:PlanRowViewModel">
                  <Border Margin="0,0,0,8" Focusable="True" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="body-strong" Text="{Binding Name}" AutomationProperties.AccessibilityView="Raw" />
                      <TextBlock Classes="caption" Text="{Binding Reason}" AutomationProperties.AccessibilityView="Raw" />
                      <ItemsControl ItemsSource="{Binding Capabilities}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Classes="caption subtle" Text="{Binding}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel x:Name="ApproveOwn" Spacing="4" IsVisible="{Binding HasOwnApproval}">
            <TextBlock Classes="body-strong" Text="{Binding OwnHeading}" />
            <TextBlock Classes="caption subtle" Text="{Binding OwnHint}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding OwnApproval}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ap:ApproveAllLine">
                  <Border Margin="0,0,0,6" Focusable="True" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="body-strong" Text="{Binding Name}" AutomationProperties.AccessibilityView="Raw" />
                      <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                      <TextBlock Classes="caption subtle" Text="{Binding Extra}" IsVisible="{Binding HasExtra}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border x:Name="ApproveError" Focusable="True" IsVisible="{Binding HasError}" AutomationProperties.Name="{Binding Error}"
                  AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <StackPanel Spacing="2" AutomationProperties.AccessibilityView="Raw">
              <TextBlock Classes="caption error" Text="{Binding Error}" TextWrapping="Wrap" />
              <TextBlock Classes="caption subtle mono" Text="{Binding ErrorCode}" />
            </StackPanel>
          </Border>
          <Border x:Name="ApproveNotice" IsVisible="{Binding HasNotice}" AutomationProperties.Name="{Binding Notice}"
                  AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="caption" Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>

          <Button x:Name="ApproveButton" Classes="command-control" IsVisible="{Binding CanApprove}" Click="OnApprove" HorizontalAlignment="Left" AutomationProperties.Name="{Binding ApproveLabel}">
            <TextBlock Classes="button" Text="{Binding ApproveLabel}" AutomationProperties.AccessibilityView="Raw" />
          </Button>

          <Border x:Name="ApproveRunning" IsVisible="{Binding IsApplying}" AutomationProperties.Name="{Binding Progress}"
                  AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock Classes="body" Text="{Binding Progress}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>

          <StackPanel x:Name="ApproveResult" Spacing="6" IsVisible="{Binding IsDone}">
            <Border x:Name="ApproveOutcome" Focusable="True" AutomationProperties.Name="{Binding Outcome}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
              <TextBlock Classes="body-strong" Text="{Binding Outcome}" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <StackPanel Spacing="4" IsVisible="{Binding HasRefused}">
              <TextBlock Classes="body-strong" Text="{Binding NotApprovedHeading}" />
              <ItemsControl ItemsSource="{Binding Refused}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="ap:ApproveAllLine">
                    <StackPanel Spacing="2" Margin="0,0,0,6">
                      <Border Focusable="True" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
                        <StackPanel AutomationProperties.AccessibilityView="Raw">
                          <TextBlock Classes="body-strong" Text="{Binding Name}" />
                          <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasCli}">
                        <TextBlock Classes="caption subtle mono" Text="{Binding Cli}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Classes="copy" Click="OnCopy" AutomationProperties.Name="{Binding CopyName}">
                          <TextBlock Classes="caption" Text="{Binding CopyLabel}" />
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding HasSkipped}">
              <TextBlock Classes="body-strong" Text="{Binding WaitingHeading}" />
              <ItemsControl ItemsSource="{Binding Skipped}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="ap:ApproveAllLine">
                    <Border Margin="0,0,0,4" Focusable="True" AutomationProperties.Name="{Binding Text}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
                      <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <Expander x:Name="ApproveDetails" Header="{Binding DetailsHeading}" IsExpanded="False" IsVisible="{Binding ShowsPlan}" AutomationProperties.Name="{Binding DetailsHeading}">
            <ItemsControl ItemsSource="{Binding DetailLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="caption subtle mono" Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <!-- The one polite live region, on StartDialog's pattern: always in the tree, live only while it speaks, resting text while dark. -->
          <TextBlock x:Name="ApproveLive" Classes="caption live-region" Classes.live="{Binding Live.IsAnnouncing}" Text="{Binding Live.Announcement}" Width="0" Opacity="0"
                     IsHitTestVisible="False" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ApproveClose" Classes="command-control" Click="OnClose" AutomationProperties.Name="{Binding CloseLabel}">
              <TextBlock Classes="button" Text="{Binding CloseLabel}" AutomationProperties.AccessibilityView="Raw" />
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Panel>
</UserControl>
