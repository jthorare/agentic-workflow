<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels.Context"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             x:Class="Aw.Sindri.Ui.Views.Context.Map.MapNodeView"
             x:DataType="vm:MapNodeViewModel"
             Width="{Binding Width}" Height="{Binding Height}"
             Focusable="True" Opacity="{Binding Opacity}"
             AutomationProperties.Name="{Binding Name}">
  <!-- One node of the context map (F3 spec 1 §2): a chip or a card on Surface1 with a 1 px hairline, or, for a suggestion nobody
       confirmed, no fill and a dashed Wire outline. The anchor wears a 2 px RingAnchor ring with a 2 px gap and a "Starts here" pill. -->
  <Grid>
    <Border Classes="node-frame" IsVisible="{Binding IsSolid}"
            Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" CornerRadius="{StaticResource Radius.LG}" />
    <Rectangle IsVisible="{Binding IsSuggested}" RadiusX="12" RadiusY="12" Stroke="{DynamicResource Brush.Wire}" StrokeThickness="1" StrokeDashArray="8,4" />
    <Border IsVisible="{Binding IsAnchor}" Margin="-4" BorderThickness="2" BorderBrush="{DynamicResource Brush.RingAnchor}" CornerRadius="16" IsHitTestVisible="False" />
    <Border IsVisible="{Binding IsSelected}" Margin="-6" BorderThickness="4" BorderBrush="{DynamicResource Brush.PrimaryHover}" CornerRadius="18" IsHitTestVisible="False" />

    <Grid IsVisible="{Binding IsChip}" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="10,0" VerticalAlignment="Center">
      <Border Width="24" Height="24" Background="{DynamicResource Brush.Surface3}" CornerRadius="{StaticResource Radius.SM}" VerticalAlignment="Top" Margin="0,2,0,0">
        <icons:StateIcon Icon="{Binding KindIcon}" Foreground="{DynamicResource Brush.InkMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding Label}" Classes.mono="{Binding IsMono}" FontSize="12" LineHeight="15" FontWeight="Medium" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Ink}" />
        <TextBlock Text="{Binding Caption}" FontSize="11" LineHeight="14" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.InkSubtle}" />
      </StackPanel>
    </Grid>

    <Grid IsVisible="{Binding IsCard}" RowDefinitions="*,Auto">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="14,14,14,8">
        <Border Width="28" Height="28" Background="{DynamicResource Brush.Surface3}" CornerRadius="{StaticResource Radius.SM}" VerticalAlignment="Top">
          <icons:StateIcon Icon="{Binding KindIcon}" Foreground="{DynamicResource Brush.InkMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{Binding Label}" FontSize="14" LineHeight="19" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Ink}" />
          <TextBlock Text="{Binding Caption}" FontSize="12" LineHeight="16" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.InkSubtle}" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Height="36" IsVisible="{Binding HasFoot}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Hairline}" Padding="14,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
          <icons:StateIcon IsVisible="{Binding FootIsOk}" Icon="Ok" Foreground="{DynamicResource Brush.Success}" />
          <icons:StateIcon IsVisible="{Binding FootIsWarn}" Icon="Kind.Warn" Foreground="{DynamicResource Brush.Attention}" />
          <TextBlock Grid.Column="1" Text="{Binding FootWord}" FontSize="12" LineHeight="16" FontWeight="Medium" Foreground="{DynamicResource Brush.Ink}" />
          <TextBlock Grid.Column="3" Text="{Binding FootRight}" FontSize="12" LineHeight="16" Foreground="{DynamicResource Brush.InkSubtle}" />
        </Grid>
      </Border>
    </Grid>

    <Border IsVisible="{Binding IsAnchor}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,-12,0,0" Padding="7,1"
            Background="{DynamicResource Brush.Surface3}" BorderBrush="{DynamicResource Brush.RingAnchor}" BorderThickness="1" CornerRadius="{StaticResource Radius.Pill}">
      <TextBlock Text="{Binding StartsHere}" FontSize="11" LineHeight="14" FontWeight="Medium" Foreground="{DynamicResource Brush.Ink}" />
    </Border>
  </Grid>
</UserControl>
