<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels.Context"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             xmlns:map="using:Aw.Sindri.Ui.Views.Context.Map"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             x:Class="Aw.Sindri.Ui.Views.Context.Map.ContextMapView"
             x:DataType="vm:ContextMapViewModel"
             ClipToBounds="True">
  <!-- The context map's stage (F3 spec 1 §2): the pannable canvas with its world, and over it the
       legend and the zoom pill (bottom right). The inspector and the Files view are the next stages'. -->
  <Grid x:Name="ContextStage">
    <ctl:ZoomBorder x:Name="ContextCanvas">
      <map:ContextMapWorld x:Name="ContextWorld" />
    </ctl:ZoomBorder>

    <Border x:Name="ContextLegend" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,150,14" Height="28" Padding="12,0"
            Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Width="22" Height="2" Background="{DynamicResource Brush.Wire}" VerticalAlignment="Center" />
          <TextBlock x:Name="LegendConfirmed" Classes="caption" Foreground="{DynamicResource Brush.InkMuted}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Line StartPoint="0,1" EndPoint="22,1" Stroke="{DynamicResource Brush.Wire}" StrokeThickness="2" StrokeDashArray="4,2" VerticalAlignment="Center" />
          <TextBlock x:Name="LegendSuggested" Classes="caption" Foreground="{DynamicResource Brush.InkMuted}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border x:Name="ContextZoom" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,14" Height="28"
            Background="{DynamicResource Brush.Surface3}" CornerRadius="{StaticResource Radius.SM}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
        <Button x:Name="ZoomOutButton" Click="OnZoomOut" Padding="6,4" Background="Transparent" BorderThickness="0"><icons:StateIcon Icon="Kind.Minus" Foreground="{DynamicResource Brush.InkMuted}" /></Button>
        <TextBlock x:Name="ZoomValue" Classes="caption" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink}" />
        <Button x:Name="ZoomInButton" Click="OnZoomIn" Padding="6,4" Background="Transparent" BorderThickness="0"><icons:StateIcon Icon="Kind.Plus" Foreground="{DynamicResource Brush.InkMuted}" /></Button>
        <Button x:Name="ZoomFitButton" Click="OnZoomFit" Padding="6,4" Background="Transparent" BorderThickness="0"><icons:StateIcon Icon="Kind.Fit" Foreground="{DynamicResource Brush.InkMuted}" /></Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
