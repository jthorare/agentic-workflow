<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels.Context.Concepts"
             x:Class="Aw.Sindri.Ui.Views.Context.Concepts.ConceptLayerView"
             x:DataType="vm:ConceptLayerViewModel">
  <UserControl.Styles>
    <Style Selector="Border.needs-you">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Attention}" />
    </Style>
    <Style Selector="Border.concept-row StackPanel.pin-slot">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.concept-row:pointerover StackPanel.pin-slot, Border.concept-row:focus-within StackPanel.pin-slot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>
  <!-- The concept band: the first layer of the context map. One card per concept with its name, its summary and its size; a click opens the bands scoped to it. -->
  <Panel>
    <Border x:Name="ConceptsLoading" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="14,8"
            Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}">
      <TextBlock Classes="body subtle" Text="{Binding LoadingText}" />
    </Border>
    <ScrollViewer IsVisible="{Binding !IsLoading}">
      <StackPanel>
      <TextBlock x:Name="ConceptsTermsNote" Classes="caption subtle" Text="{Binding TermsNote}" IsVisible="{Binding HasTermsNote}" Margin="0,0,0,8" />
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8" IsVisible="{Binding ShowNewPin}">
        <TextBlock x:Name="PinHead" Classes="body" Text="{Binding PinHeadText}" IsVisible="{Binding HasPinHead}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button x:Name="NewPinButton" Grid.Column="1" Content="{Binding NewPinText}" Click="OnNewPin" Margin="12,0,0,0" AutomationProperties.AutomationId="NewPin" />
        <Button x:Name="AddSeveralButton" Grid.Column="2" Content="{Binding AddSeveralText}" Click="OnAddSeveral" IsVisible="{Binding ShowAddSeveral}" Margin="8,0,0,0" AutomationProperties.AutomationId="AddSeveral" />
      </Grid>
      <!-- The layer's one status line: a polite live region, so a screen reader hears "Rebuilding the map" and "The map is ready" (pattern: CommandControl's announcer). -->
      <TextBlock x:Name="RebuildLine" Classes="caption" Text="{Binding RebuildText}" IsVisible="{Binding HasRebuildText}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
      <!-- One line per concept (#3677): the name, its file count and when it last changed. Pin shows under the pointer or the keyboard focus; the p key does the same. The summary and terms are the row's tooltip. -->
      <ItemsControl x:Name="ConceptList" ItemsSource="{Binding Tiles}" AutomationProperties.Name="{Binding ListName}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConceptTileViewModel">
            <Border Classes="concept-row" Margin="0,0,0,4" AutomationProperties.AutomationId="{Binding AutomationId}"
                    Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}"
                    Classes.needs-you="{Binding NeedsYou}" ClipToBounds="True">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <Button Click="OnOpen" Padding="14,8" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0"
                          ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="16">
                      <TextBlock Classes="body-strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="caption subtle" Text="{Binding MarkText}" IsVisible="{Binding HasMark}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding NewSuggestedText}" IsVisible="{Binding HasNewSuggested}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Classes="caption subtle" Text="{Binding FilesText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Classes="caption subtle" Text="{Binding ChangedText}" IsVisible="{Binding HasChanged}" MinWidth="88" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <!-- The pin buttons: out of sight until the pointer or the keyboard is on the row. -->
                  <StackPanel Grid.Column="1" Classes="pin-slot" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button Content="{Binding PinThisText}" IsVisible="{Binding ShowPinThis}" Click="OnPinThis" AutomationProperties.AutomationId="PinThis" />
                    <Button Content="{Binding EditPinText}" IsVisible="{Binding ShowEditPin}" Click="OnEditPin" AutomationProperties.AutomationId="EditPin" />
                  </StackPanel>
                </Grid>
                <Border IsVisible="{Binding HasFooter}" Padding="14,8" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0">
                  <StackPanel Spacing="4">
                    <ItemsControl ItemsSource="{Binding Lines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding ActionText}" IsVisible="{Binding HasAction}" Click="OnAction" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
