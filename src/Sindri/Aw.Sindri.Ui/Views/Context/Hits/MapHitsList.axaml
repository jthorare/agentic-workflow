<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels.Context.Hits"
             x:Class="Aw.Sindri.Ui.Views.Context.Hits.MapHitsList"
             x:DataType="vm:MapHitsViewModel">
  <!-- The hits of a search, best first: label and kind, where it matched, the snippet as plain text. A click, Enter or an arrow key on a row focuses its node on the map. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="6">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock x:Name="HitsTitle" Classes="body-strong" Text="{Binding Title}" AutomationProperties.Name="{Binding Title}" />
      <TextBlock x:Name="HitsCount" Classes="caption subtle" Text="{Binding CountText}" IsVisible="{Binding HasCount}" VerticalAlignment="Center" AutomationProperties.Name="{Binding CountText}" />
    </StackPanel>
    <ListBox x:Name="HitsRows" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" KeyDown="OnKey" AutomationProperties.Name="{Binding Title}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:MapHitRow">
          <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MapHitRow">
          <StackPanel Spacing="2" Tapped="OnTapped">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="body-strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="caption subtle" Text="{Binding Kind}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="caption subtle" Text="{Binding MatchedText}" IsVisible="{Binding HasMatched}" />
            <TextBlock Classes="caption" Text="{Binding Snippet}" IsVisible="{Binding HasSnippet}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
