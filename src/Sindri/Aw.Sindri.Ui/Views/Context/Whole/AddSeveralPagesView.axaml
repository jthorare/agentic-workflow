<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels.Context.Whole"
             x:Class="Aw.Sindri.Ui.Views.Context.Whole.AddSeveralPagesView"
             x:DataType="vm:AddSeveralPagesViewModel">
  <!-- The Add several pages sheet (pages spec §3.6): one column inside the shell sheet, which supplies the title and the close button. The paste box and Read the list, then one row per block with its tick,
       and the buttons. A discard asks inline; Esc answers the question that shows, else asks or closes. -->
  <StackPanel Spacing="8">
    <StackPanel Spacing="2" IsVisible="{Binding HasPasteBox}">
      <TextBlock Classes="caption subtle" Text="{Binding BoxLabel}" AutomationProperties.AccessibilityView="Raw" />
      <TextBox x:Name="AddSeveralText" Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="260"
               AutomationProperties.Name="{Binding BoxLabel}" AutomationProperties.HelpText="{Binding BoxHelp}" />
      <TextBlock Classes="caption subtle" Text="{Binding BoxHelp}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="AddSeveralTextNote" Classes="caption" Foreground="{DynamicResource Brush.Error}" Text="{Binding TextNote}" IsVisible="{Binding HasTextNote}" TextWrapping="Wrap"
                 AutomationProperties.Name="{Binding TextNote}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <Button x:Name="AddSeveralRead" Content="{Binding ReadText}" IsEnabled="{Binding !IsReading}" Click="OnRead" HorizontalAlignment="Left" IsVisible="{Binding HasPasteBox}" AutomationProperties.Name="{Binding ReadText}" />
    <ItemsControl x:Name="AddSeveralRows" ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AddSeveralPagesRowViewModel">
          <Border Classes="card" Margin="0,0,0,6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <CheckBox x:Name="AddSeveralTick" IsChecked="{Binding Ticked, Mode=TwoWay}" IsEnabled="{Binding CanTick}" AutomationProperties.Name="{Binding TickName}" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="body-strong" Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="caption subtle" Text="{Binding MatchText}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding ReplacesText}" IsVisible="{Binding HasReplaces}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding SameAsText}" IsVisible="{Binding HasSameAs}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding ActionLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String"><TextBlock Classes="caption subtle" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Unknowns}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UnknownConceptViewModel">
                      <WrapPanel Margin="0,2,0,0">
                        <TextBlock Classes="caption" Foreground="{DynamicResource Brush.Error}" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="AddSeveralPick" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}" MinWidth="220"
                                  AutomationProperties.Name="{Binding PickName}" AutomationProperties.HelpText="{Binding Text}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConceptChoice"><TextBlock Text="{Binding Name}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </WrapPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel IsVisible="{Binding HasPicker}"><ComboBox x:Name="AddSeveralConceptPick" DataContext="{Binding Picker}" x:DataType="vm:UnknownConceptViewModel" ItemsSource="{Binding Choices}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}" MinWidth="220" HorizontalAlignment="Left"
                          AutomationProperties.Name="{Binding PickName}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConceptChoice"><TextBlock Text="{Binding Name}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox></StackPanel>
                <ToggleButton x:Name="AddSeveralOpen" Content="{Binding OpenText}" IsChecked="{Binding IsOpen, Mode=TwoWay}" IsVisible="{Binding HasFields}" HorizontalAlignment="Left"
                              AutomationProperties.Name="{Binding OpenName}" />
                <StackPanel x:Name="AddSeveralFields" Spacing="6" IsVisible="{Binding IsOpen}">
                  <TextBlock Classes="caption subtle" Text="{Binding NameLabel}" AutomationProperties.AccessibilityView="Raw" />
                  <TextBox x:Name="AddSeveralName" Text="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="{Binding NameLabel}" />
                  <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AddSeveralPagesActionViewModel">
                        <StackPanel Spacing="2" Margin="0,2,0,2">
                          <TextBlock Classes="body-strong" Text="{Binding Name}" TextWrapping="Wrap" />
                          <ItemsControl ItemsSource="{Binding Ticks}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ConceptTickViewModel">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsTicked, Mode=TwoWay}" Margin="0,0,12,0" AutomationProperties.Name="{Binding AccessibleName}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock x:Name="AddSeveralReason" Classes="caption" Focusable="True" Foreground="{DynamicResource Brush.Error}" Text="{Binding Reason}" IsVisible="{Binding HasReason}" TextWrapping="Wrap"
                           AutomationProperties.Name="{Binding Reason}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="AddSeveralMore" Classes="caption subtle" Text="{Binding MoreText}" IsVisible="{Binding HasMore}" TextWrapping="Wrap" AutomationProperties.Name="{Binding MoreText}" />
    <TextBlock x:Name="AddSeveralNote" Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Note}" />
    <Border x:Name="AddSeveralDiscardAsk" Classes="card" IsVisible="{Binding IsConfirmingDiscard}">
      <StackPanel Spacing="8">
        <TextBlock Classes="body" Text="{Binding DiscardQuestion}" TextWrapping="Wrap" AutomationProperties.Name="{Binding DiscardQuestion}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="AddSeveralDiscard" Content="{Binding DiscardText}" Click="OnDiscard" AutomationProperties.Name="{Binding DiscardText}" />
          <Button x:Name="AddSeveralKeepEditing" Content="{Binding KeepEditingText}" Click="OnKeepEditing" AutomationProperties.Name="{Binding KeepEditingText}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <Button x:Name="AddSeveralSaveAll" Grid.Column="1" Classes="accent" Content="{Binding SaveText}" IsEnabled="{Binding CanSave}" Click="OnSaveAll" AutomationProperties.Name="{Binding SaveText}" />
      <Button x:Name="AddSeveralCancel" Grid.Column="2" Content="{Binding EscText}" Click="OnClose" AutomationProperties.Name="{Binding CloseName}" />
    </Grid>
  </StackPanel>
</UserControl>
