<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels.Context.Whole"
             x:Class="Aw.Sindri.Ui.Views.Context.Whole.PageSheetView"
             x:DataType="vm:PageSheetViewModel">
  <!-- The page sheet (pages spec §3.6, mockup sheet A): one column inside the shell sheet, which supplies the title and the close button. Name, then each action as a name box with Remove and its concept ticks under it,
       Add an action, and the buttons. Remove page and a discard ask inline; Esc answers the question that shows, else asks or closes. -->
  <StackPanel Spacing="8">
    <TextBlock x:Name="PageSheetLoading" Classes="caption subtle" Text="{Binding LoadingText}" IsVisible="{Binding IsLoading}" AutomationProperties.Name="{Binding LoadingText}" AutomationProperties.LiveSetting="Polite" />
    <TextBlock x:Name="PageSheetUnreadable" Classes="body" Text="{Binding UnreadableText}" IsVisible="{Binding IsUnreadable}" TextWrapping="Wrap" AutomationProperties.Name="{Binding UnreadableText}" />
      <StackPanel x:Name="PageSheetBody" Spacing="8" IsVisible="{Binding IsReady}">
        <StackPanel Spacing="2">
          <TextBlock Classes="caption subtle" Text="{Binding NameLabel}" AutomationProperties.AccessibilityView="Raw" />
          <TextBox x:Name="PageSheetName" Text="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="{Binding NameLabel}" />
          <TextBlock x:Name="PageSheetSameName" Classes="caption" Text="{Binding SameNameText}" IsVisible="{Binding HasSameName}" TextWrapping="Wrap" AutomationProperties.Name="{Binding SameNameText}" />
          <TextBlock x:Name="PageSheetNameError" Classes="caption" Foreground="{DynamicResource Brush.Error}" Text="{Binding NameError}" IsVisible="{Binding HasNameError}" TextWrapping="Wrap" AutomationProperties.Name="{Binding NameError}" />
          <TextBlock x:Name="PageSheetFromMap" Classes="caption subtle" Text="{Binding FromMap}" IsVisible="{Binding HasFromMap}" AutomationProperties.Name="{Binding FromMap}" />
        </StackPanel>
        <TextBlock Classes="caption subtle" Text="{Binding ActionsHeading}" Margin="0,4,0,0" AutomationProperties.AccessibilityView="Raw" />
        <ItemsControl x:Name="PageSheetActions" ItemsSource="{Binding Actions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PageSheetActionViewModel">
              <StackPanel Spacing="4" Margin="0,0,0,8" AutomationProperties.Name="{Binding RowName}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox x:Name="PageSheetActionName" Text="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="{Binding NameLabel}" />
                  <Button x:Name="PageSheetActionRemove" Grid.Column="1" Content="{Binding RemoveText}" Click="OnRemoveAction" AutomationProperties.Name="{Binding RemoveText}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Ticks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConceptTickViewModel">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsTicked, Mode=TwoWay}" Margin="0,0,12,0" AutomationProperties.Name="{Binding AccessibleName}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="caption subtle" Text="{Binding FromMap}" />
                <TextBlock Classes="caption" Foreground="{DynamicResource Brush.Error}" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Error}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel>
          <Button x:Name="PageSheetAddAction" Content="{Binding AddActionText}" Click="OnAddAction" Margin="0,0,8,0" AutomationProperties.Name="{Binding AddActionText}" />
          <ComboBox x:Name="PageSheetRelate" ItemsSource="{Binding RelateChoices}" SelectedItem="{Binding SelectedRelate, Mode=TwoWay}" IsVisible="{Binding HasRelateChoices}"
                    PlaceholderText="{Binding RelateLabel}" MinWidth="220" AutomationProperties.Name="{Binding RelateLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConceptChoice"><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </WrapPanel>
      </StackPanel>
    <StackPanel Spacing="8" IsVisible="{Binding IsReady}">
      <TextBlock x:Name="PageSheetNote" Classes="body" Foreground="{DynamicResource Brush.Error}" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Note}" />
      <Border x:Name="PageSheetRemoveAsk" Classes="card" IsVisible="{Binding IsConfirmingRemove}">
        <StackPanel Spacing="8">
          <TextBlock Classes="body" Text="{Binding RemoveQuestion}" TextWrapping="Wrap" AutomationProperties.Name="{Binding RemoveQuestion}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PageSheetRemoveConfirm" Content="{Binding RemoveConfirmText}" Click="OnRemoveConfirm" AutomationProperties.Name="{Binding RemoveConfirmText}" />
            <Button x:Name="PageSheetRemoveCancel" Content="{Binding RemoveCancelText}" Click="OnRemoveCancel" AutomationProperties.Name="{Binding RemoveCancelText}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border x:Name="PageSheetDiscardAsk" Classes="card" IsVisible="{Binding IsConfirmingDiscard}">
        <StackPanel Spacing="8">
          <TextBlock Classes="body" Text="{Binding DiscardQuestion}" TextWrapping="Wrap" AutomationProperties.Name="{Binding DiscardQuestion}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PageSheetDiscard" Content="{Binding DiscardText}" Click="OnDiscard" AutomationProperties.Name="{Binding DiscardText}" />
            <Button x:Name="PageSheetKeepEditing" Content="{Binding KeepEditingText}" Click="OnKeepEditing" AutomationProperties.Name="{Binding KeepEditingText}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button x:Name="PageSheetRemovePage" Content="{Binding RemovePageText}" IsVisible="{Binding ShowRemovePage}" IsEnabled="{Binding !IsSaving}" Click="OnAskRemove" AutomationProperties.Name="{Binding RemovePageText}" />
        <Button x:Name="PageSheetSave" Grid.Column="2" Classes="accent" Content="{Binding SaveText}" IsEnabled="{Binding CanSave}" Click="OnSave" AutomationProperties.Name="{Binding SaveText}" />
        <Button x:Name="PageSheetCancel" Grid.Column="3" Content="{Binding EscText}" Click="OnClose" AutomationProperties.Name="{Binding CloseName}" />
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
