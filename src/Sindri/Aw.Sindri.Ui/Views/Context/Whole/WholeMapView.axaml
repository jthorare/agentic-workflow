<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels.Context.Whole"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             xmlns:wv="using:Aw.Sindri.Ui.Views.Context.Whole"
             x:Class="Aw.Sindri.Ui.Views.Context.Whole.WholeMapView"
             x:DataType="vm:WholeMapViewModel"
             ClipToBounds="True">
  <UserControl.Styles>
    <!-- The drill's two modes: a Surface2 track, the chosen segment on Surface3 (as Health's tabs). -->
    <Style Selector="RadioButton.segment">
      <Setter Property="FontSize" Value="{DynamicResource Type.Body.Size}" />
      <Setter Property="Height" Value="{StaticResource Size.Control}" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
    </Style>
  </UserControl.Styles>
  <!-- The whole map (whole-map spec §3): the size line and, when a feature is cut, a note; the pannable canvas with the mini-map and the zoom pill over it. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="8">
    <StackPanel Spacing="2">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="WholeBack" IsVisible="{Binding HasConcept}" Content="{Binding BackText}" Click="OnBack" VerticalAlignment="Center" AutomationProperties.Name="{Binding BackText}" />
        <ctl:CrumbTrail x:Name="WholeCrumbs" Crumbs="{Binding Crumbs}" IsVisible="{Binding ShowCrumbs}" Navigated="OnCrumb" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{Binding CrumbsName}" />
      </StackPanel>
      <ItemsControl x:Name="WholeBandButtons" ItemsSource="{Binding BandButtons}" IsVisible="{Binding ShowBandButtons}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BandButton">
            <Button Content="{Binding Title}" Click="OnBandButton" AutomationProperties.Name="{Binding Name}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border x:Name="WholeDrillModes" IsVisible="{Binding IsDrilled}" Background="{DynamicResource Brush.Surface2}" CornerRadius="{StaticResource Radius.MD}" Padding="2" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="WholeDrillCross" GroupName="WholeDrillMode" Classes="segment" IsChecked="{Binding ShowCross, Mode=TwoWay}" Content="{Binding CrossText}" AutomationProperties.Name="{Binding CrossText}" />
          <RadioButton x:Name="WholeDrillOwn" GroupName="WholeDrillMode" Classes="segment" IsChecked="{Binding ShowOwn, Mode=TwoWay}" Content="{Binding OwnText}" AutomationProperties.Name="{Binding OwnText}" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="WholeDrillEmpty" Classes="body" Text="{Binding DrillEmptyText}" IsVisible="{Binding ShowDrillEmpty}" TextWrapping="Wrap" AutomationProperties.Name="{Binding DrillEmptyText}" />
      <TextBlock x:Name="WholeSize" Classes="caption subtle" Text="{Binding SizeText}" AutomationProperties.Name="{Binding SizeText}" />
      <TextBlock x:Name="WholeNote" Classes="body" Text="{Binding ByAreaNote}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" AutomationProperties.Name="{Binding ByAreaNote}" />
      <TextBlock x:Name="WholeMoreTouched" Classes="caption" Text="{Binding MoreTouchedText}" IsVisible="{Binding HasMoreTouched}" AutomationProperties.Name="{Binding MoreTouchedText}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <Grid>
      <ctl:ZoomBorder x:Name="WholeCanvas" AutomationProperties.Name="{Binding CanvasName}">
        <wv:WholeMapCanvas x:Name="WholeWorld" />
      </ctl:ZoomBorder>

      <!-- The node's side panel (owner answer q101): on the right, above the zoom pill, clear of the mini-map strip at the bottom left. -->
      <Border x:Name="WholeNodePanel" DataContext="{Binding Panel}" x:DataType="vm:NodePanelViewModel" IsVisible="{Binding IsOpen}"
              HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="14,14,14,56" Width="320" Padding="12,10"
              Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" CornerRadius="{StaticResource Radius.LG}"
              AutomationProperties.Name="{Binding PanelName}">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock x:Name="WholeNodeKind" Classes="caption subtle" Text="{Binding Kind}" AutomationProperties.Name="{Binding Kind}" />
              <TextBlock x:Name="WholeNodeTitle" Classes="body-strong" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Title}" />
            </StackPanel>
            <Button x:Name="WholeNodeClose" Grid.Column="1" Content="×" Click="OnNodePanelClose" Padding="8,2" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" AutomationProperties.Name="{Binding CloseText}" ToolTip.Tip="{Binding CloseText}" />
          </Grid>
          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="8">
              <TextBlock x:Name="WholeNodeLoading" Classes="caption subtle" Text="{Binding LoadingText}" IsVisible="{Binding IsLoading}" />
              <TextBlock x:Name="WholeNodeFailed" Classes="caption" Text="{Binding FailedText}" IsVisible="{Binding IsFailed}" />
              <StackPanel Spacing="2" IsVisible="{Binding HasSource}">
                <TextBlock x:Name="WholeNodeSource" Classes="body" Text="{Binding SourceText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding SourceText}" />
                <Button x:Name="WholeNodeOpenSource" Content="{Binding OpenSourceText}" IsVisible="{Binding HasLink}" Click="OnNodePanelOpenSource" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding OpenSourceText}" />
              </StackPanel>
              <TextBlock x:Name="WholeNodeDescription" Classes="body" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Description}" />
              <ItemsControl x:Name="WholeNodeGroups" ItemsSource="{Binding Groups}" IsVisible="{Binding HasGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NodeEdgeGroupViewModel">
                    <StackPanel Spacing="2" Margin="0,0,0,8">
                      <TextBlock Classes="caption subtle" Text="{Binding Title}" />
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NodeEdgeRowViewModel">
                            <Button Click="OnNodePanelEdge" Padding="4,2" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding Text}">
                              <StackPanel>
                                <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" />
                                <TextBlock Classes="caption subtle" Text="{Binding KindText}" IsVisible="{Binding HasKind}" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border x:Name="WholeMiniMapHost" Focusable="True" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Width="180" Height="112"
              Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}"
              KeyDown="OnMiniMapKey" AutomationProperties.Name="Mini-map: arrow keys move the view">
        <ctl:MiniMapControl x:Name="WholeMiniMap" />
      </Border>

      <wv:WholeMapLegend x:Name="WholeLegend" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,150,14" />

      <Border x:Name="WholeZoom" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,14" Height="28"
              Background="{DynamicResource Brush.Surface3}" CornerRadius="{StaticResource Radius.SM}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
          <Button x:Name="WholeZoomOut" Click="OnZoomOut" Padding="6,4" Background="Transparent" BorderThickness="0"><icons:StateIcon Icon="Kind.Minus" Foreground="{DynamicResource Brush.InkMuted}" /></Button>
          <TextBlock x:Name="WholeZoomValue" Classes="caption" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink}" />
          <Button x:Name="WholeZoomIn" Click="OnZoomIn" Padding="6,4" Background="Transparent" BorderThickness="0"><icons:StateIcon Icon="Kind.Plus" Foreground="{DynamicResource Brush.InkMuted}" /></Button>
          <Button x:Name="WholeZoomFit" Click="OnZoomFit" Padding="6,4" Background="Transparent" BorderThickness="0"><icons:StateIcon Icon="Kind.Fit" Foreground="{DynamicResource Brush.InkMuted}" /></Button>
        </StackPanel>
      </Border>
    </Grid>

      <!-- The accessible map (UX pass C-3): the canvas is drawn, not made of controls, so the items it draws are listed here for the keyboard and a screen reader. Arrow keys move; Enter does what a click on the map does. -->
      <Grid Grid.Column="1" Width="200" RowDefinitions="Auto,*" RowSpacing="4">
        <TextBlock Classes="eyebrow" Text="{Binding ItemsName}" AutomationProperties.AccessibilityView="Raw" />
        <ListBox x:Name="WholeItems" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=OneWay}" AutomationProperties.Name="{Binding ItemsName}"
                 ContainerPrepared="OnItemPrepared" KeyDown="OnItemsKey" Tapped="OnItemsTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MapItemViewModel">
              <TextBlock Classes="body" Text="{Binding Label}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Grid>
</UserControl>