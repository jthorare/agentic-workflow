<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctx="using:Aw.Sindri.Ui.ViewModels.Context"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             x:Class="Aw.Sindri.Ui.Views.Context.FileMap.FileMapTree"
             x:DataType="ctx:FileMapViewModel">
  <UserControl.Resources>
    <!-- A suggested row is hatched, so it is told apart by more than colour; its words say "Suggested" and how sure the tool is. -->
    <LinearGradientBrush x:Key="Brush.FileHatch" StartPoint="0,0" EndPoint="8,8" SpreadMethod="Repeat">
      <GradientStop Offset="0" Color="{StaticResource Color.AttentionSoft}" />
      <GradientStop Offset="0.5" Color="{StaticResource Color.AttentionSoft}" />
      <GradientStop Offset="0.5" Color="Transparent" />
      <GradientStop Offset="1" Color="Transparent" />
    </LinearGradientBrush>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.file-row">
      <Setter Property="Height" Value="{StaticResource Row.Height.Compact}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.file-row.suggested">
      <Setter Property="Background" Value="{StaticResource Brush.FileHatch}" />
    </Style>
    <Style Selector="Button.file-open">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <!-- The Files view (F3 spec 1 §2): one folder at a time, 36 px rows, a suggested row hatched. A folder opens; a file is a row. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto">
      <!-- The path as a breadcrumb: "~" is the top of the repo; every level but the last is a link, the last is where you are. -->
      <ctl:CrumbTrail x:Name="FilesCrumbs" Crumbs="{Binding Crumbs}" Navigated="OnCrumb" VerticalAlignment="Center" AutomationProperties.Name="{Binding CrumbsName}" />
      <TextBlock x:Name="FilesTotals" Grid.Column="1" Classes="caption subtle" Text="{Binding ShownTotalsText}" VerticalAlignment="Center" />
    </Grid>

    <TextBox x:Name="FilesFilter" Grid.Row="1" Text="{Binding FilterText, Mode=TwoWay}" PlaceholderText="{Binding FilterHint}" AutomationProperties.Name="{Binding FilterHint}" />

    <Grid Grid.Row="2" ColumnDefinitions="2*,3*,2*,2*" Margin="8,0" AutomationProperties.AccessibilityView="Raw">
      <TextBlock Classes="eyebrow" Text="{Binding ColFile}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Classes="eyebrow" Text="{Binding ColFor}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="2" Classes="eyebrow" Text="{Binding ColIntent}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="3" Classes="eyebrow" Text="{Binding SymbolsHeading}" TextTrimming="CharacterEllipsis" />
    </Grid>

    <!-- The note line follows the last row (#3862): the dock panel takes only the height its rows and note need, from the top of the
         star row. The note is measured first, so a long list gets what is left and scrolls, with the note still in view under it. -->
    <DockPanel Grid.Row="3" VerticalAlignment="Top">
    <TextBlock x:Name="FilesNote" DockPanel.Dock="Bottom" Classes="caption subtle" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" Margin="8,8,8,0" />
    <Panel>
      <!-- Rows are 36 px and built as they scroll into view; a plain StackPanel would build every row of a big folder. -->
      <ScrollViewer x:Name="FileScroll" IsVisible="{Binding HasRows}" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="FileRows" ctl:ResultListKeys.Arrows="True" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ctx:FileRowViewModel">
            <Border Classes="file-row" Classes.suggested="{Binding IsSuggested}" AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.AccessibilityView="Control">
              <Grid ColumnDefinitions="2*,3*,2*,2*" Margin="8,0">
                <!-- Name and file count keep their size; the status takes what is left of the column and trims, so it never draws over the next column. -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="file-open result-open" IsVisible="{Binding IsDirectory}" Click="OnOpen" AutomationProperties.Name="{Binding Name}">
                      <TextBlock Classes="body-strong" Text="{Binding Name}" />
                    </Button>
                    <Button Classes="file-open result-open" IsVisible="{Binding IsFile}" Click="OnOpen" AutomationProperties.Name="{Binding Name}">
                      <TextBlock Classes="body" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <TextBlock Classes="caption subtle" Text="{Binding FilesText}" IsVisible="{Binding IsDirectory}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="caption subtle" Text="{Binding StatusWord}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <TextBlock Grid.Column="1" Classes="body" Text="{Binding ForText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Grid.Column="2" Classes="body" Text="{Binding IntentText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="FileSymbols" Grid.Column="3" Classes="body" Text="{Binding SymbolsText}" ToolTip.Tip="{Binding SymbolsTip}" Opacity="{Binding SymbolsOpacity}" IsVisible="{Binding IsFile}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="FilesLoading" Classes="body subtle" Text="{Binding LoadingWord}" IsVisible="{Binding IsLoading}" Margin="8,0" />
      <TextBlock x:Name="FilesEmpty" Classes="body subtle" Text="{Binding EmptyWord}" IsVisible="{Binding IsEmptyFolder}" Margin="8,0" />
      <TextBlock x:Name="FilesNoMatch" Classes="body subtle" Text="{Binding NoMatchWord}" IsVisible="{Binding IsNoMatch}" Margin="8,0" />
      <Border x:Name="FilesProblem" IsVisible="{Binding HasProblem}" BorderBrush="{DynamicResource Brush.Attention}" BorderThickness="1" CornerRadius="{StaticResource Radius.MD}" Padding="12,8" VerticalAlignment="Top"
              AutomationProperties.Name="{Binding Problem}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="body" Text="{Binding Problem}" TextWrapping="Wrap" />
      </Border>
    </Panel>
    </DockPanel>
  </Grid>
</UserControl>
