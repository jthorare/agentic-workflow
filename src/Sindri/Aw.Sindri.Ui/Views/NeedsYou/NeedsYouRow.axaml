<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ny="using:Aw.Sindri.Ui.ViewModels.NeedsYou"
             xmlns:wf="using:Aw.Sindri.Ui.Views.Workflows"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             x:Class="Aw.Sindri.Ui.Views.NeedsYou.NeedsYouRow"
             x:DataType="ny:NeedsYouRowViewModel">
  <!-- One Needs-you row (UI spec §5, screens spec §4.1): the chip, the id, the title (a button: it opens the row's sheet), the
       age, then the reason and repo, then the row's controls. The tint is the urgency (R8-13): an unseen pulse row pulses (a
       steady outline and the word "new" under reduced motion), a failure keeps a steady tint, a calm row a subtle one. The row
       draws its own focus border (item-row), not the adorner. -->
  <Border x:Name="RowFrame" Classes="item-row needs-you-row" Classes.selected="{Binding IsSelected}" Classes.pulsing="{Binding IsPulsing}" Classes.steady="{Binding IsSteady}" Classes.subtle="{Binding IsSubtle}" Classes.slides-in="{Binding SlidesIn}"
          Classes.outlined="{Binding HasOutline}" Classes.stale="{Binding IsStale}" Focusable="True"
          AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
    <StackPanel Spacing="2">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
        <ctl:StateChipView x:Name="NeedsYouChip" Chip="{Binding Chip}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Grid.Column="1" Classes="mono subtle" Text="{Binding ShownId}" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.AccessibilityView="Raw" />
        <Button x:Name="NeedsYouTitle" Grid.Column="2" Classes="row-title" Click="OnOpen" AutomationProperties.Name="{Binding OpenName}">
          <TextBlock Classes="body-strong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
        </Button>
        <TextBlock x:Name="NewWord" Grid.Column="3" Classes="caption" Text="{Binding NewWord}" IsVisible="{Binding HasNewWord}" AutomationProperties.AccessibilityView="Raw" Margin="8,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Classes="caption subtle" Text="{Binding Age}" VerticalAlignment="Center" TextAlignment="Right" AutomationProperties.AccessibilityView="Raw" />
      </Grid>
      <DockPanel LastChildFill="True">
        <wf:ChildAnswerButton x:Name="NeedsYouChildAnswer" DockPanel.Dock="Right" Margin="12,0,0,0" DataContext="{Binding ChildAnswer}"
                               IsVisible="{Binding $parent[UserControl].((ny:NeedsYouRowViewModel)DataContext).ChildAnswer, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ItemsControl x:Name="NeedsYouControls" DockPanel.Dock="Right" Margin="12,0,0,0" ItemsSource="{Binding Controls}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ny:NeedsYouActionControl">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                <Button Classes="command-control" Classes.primary="{Binding IsPrimary}" IsEnabled="{Binding IsEnabled}" Content="{Binding Action.Label}"
                        Click="OnAction" ToolTip.Tip="{Binding Tooltip}" ToolTip.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding Tooltip}" AutomationProperties.Name="{Binding Name}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="caption subtle" Text="{Binding Label}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding Label}" />
          <TextBlock Classes="caption subtle mono" Text="{Binding Repo}" IsVisible="{Binding Repo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="{Binding Repo}" />
          <TextBlock x:Name="NeedsYouNotice" Classes="caption" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Notice}" AutomationProperties.Name="{Binding Notice}" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>
