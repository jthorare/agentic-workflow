<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ny="using:Aw.Sindri.Ui.ViewModels.NeedsYou"
             x:Class="Aw.Sindri.Ui.Views.NeedsYou.DecisionSheet"
             x:DataType="ny:DecisionSheetViewModel">
  <!-- The decision sheet (screens spec §4.1): the question, the notice when it is only recorded now, one button per option as
       served (the first is recommended, A while the sheet is open), a note, and what Decide answered. A refusal shows as
       served, inline, under the buttons; a cleared decision disables the form and keeps its text. -->
  <StackPanel x:Name="DecisionForm" Spacing="10">
    <TextBlock x:Name="DecisionFiled" Classes="caption subtle" Text="{Binding FiledLine}" IsVisible="{Binding FiledLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               TextWrapping="Wrap" AutomationProperties.Name="{Binding FiledLine}" />
    <TextBlock x:Name="DecisionQuestion" Classes="body-strong" Text="{Binding Question}" IsVisible="{Binding IsAsking}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Question}" />
    <TextBlock Classes="caption subtle" Text="{Binding Notice}" IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               TextWrapping="Wrap" AutomationProperties.Name="{Binding Notice}" />
    <TextBlock x:Name="DecisionNoteCaption" Classes="caption subtle" Text="{Binding NoteLabel}" AutomationProperties.AccessibilityView="Raw" />
    <TextBox x:Name="DecisionNote" Text="{Binding Note}" AcceptsReturn="False" IsEnabled="{Binding !IsCleared}" AutomationProperties.Name="{Binding NoteLabel}" />
    <ItemsControl x:Name="DecisionOptions" ItemsSource="{Binding Options}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="ny:DecisionOption">
          <Button Classes="command-control decision-option" Classes.primary="{Binding IsRecommended}" Content="{Binding Label}" IsEnabled="{Binding IsEnabled}"
                  Click="OnOption" Margin="0,0,8,8" ToolTip.Tip="{Binding Reason}" ToolTip.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding Reason}" AutomationProperties.Name="{Binding Name}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <WrapPanel Orientation="Horizontal" IsVisible="{Binding DecideLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Border x:Name="DecisionDecideLine" Classes="pending-line" Focusable="True" AutomationProperties.Name="{Binding DecideLineName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="caption subtle" TextWrapping="Wrap" Margin="0,0,6,0" Text="{Binding DecideLine}" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Button x:Name="DecisionDecideCopy" Classes="copy" Click="OnCopyDecide" IsVisible="{Binding CanCopy}" AutomationProperties.Name="{Binding CopyName}">
        <TextBlock Classes="caption" Text="{Binding CopyLabel}" />
      </Button>
    </WrapPanel>
    <TextBlock x:Name="DecisionRefusal" Classes="caption" Text="{Binding Refusal}" IsVisible="{Binding Refusal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               TextWrapping="Wrap" AutomationProperties.Name="{Binding Refusal}" />
    <TextBlock x:Name="DecisionOutcome" Classes="caption" Text="{Binding DecidedLine}" IsVisible="{Binding DecidedLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               TextWrapping="Wrap" AutomationProperties.Name="{Binding DecidedLine}" />
    <TextBlock x:Name="DecisionCleared" Classes="caption subtle" Text="{Binding ClearedLine}" IsVisible="{Binding ClearedLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               AutomationProperties.Name="{Binding ClearedLine}" />
  </StackPanel>
</UserControl>
