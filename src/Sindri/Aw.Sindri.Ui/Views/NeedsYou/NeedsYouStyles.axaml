<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The Needs-you rows' tint (screens spec R8-13): the urgency, not a side bar. Tokens only. A pulse row that is unseen keeps
       the attention tint and pulses its tint between two tokens (the text is never faded: contrast); under reduced motion it keeps a steady outline instead (HasOutline). -->
  <!-- An attention tint (pulsing, steady, outlined) lifts within its own amber under the pointer and a press (Brush.AttentionSoft.Hover and
       .Pressed), so the urgency stays; the pulse runs only at rest (a running animation would beat any style setter). Those rules live in Theme/ClickableStyles.axaml,
       which loads last, so they beat its grey hover. A calm row (subtle, stale) steps aside to that shared clickable hover and pressed background. -->
  <Style Selector="Border.needs-you-row.pulsing:not(:pointerover):not(:pressed)">
    <Setter Property="Background" Value="{DynamicResource Brush.AttentionSoft}" />
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="Infinite" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Background" Value="{StaticResource Brush.AttentionSoft}" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Background" Value="{StaticResource Brush.Surface1}" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Background" Value="{StaticResource Brush.AttentionSoft}" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- The unseen pulse above keeps its amber (#2780, #2749): it is the one "you have not seen this" status cue, so it stays a status colour under the one-accent rule.
       A failure and an outlined row rest like any clickable row (Brush.Clickable.Rest, the card shows through), a calm row on Surface2 (R8-13), no motion. -->
  <Style Selector="Border.needs-you-row.steady:not(:pointerover):not(:pressed)">
    <Setter Property="Background" Value="{DynamicResource Brush.Clickable.Rest}" />
  </Style>
  <Style Selector="Border.needs-you-row.subtle:not(:pointerover):not(:pressed)">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
  <!-- A row that arrives after the first list slides in over Motion.Base (180 ms); never under reduced motion (SlidesIn is false then).
       The slide animates RenderTransform itself and sets no transform of its own, so once it ends the clickable press scale
       (Theme/ClickableStyles.axaml) applies to a row that slid in like any other. -->
  <Style Selector="Border.needs-you-row.slides-in">
    <Style.Animations>
      <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
        <KeyFrame Cue="0%"><Setter Property="RenderTransform" Value="translateY(-12px)" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RenderTransform" Value="translateY(0px)" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- The outline's shape (border and padding) holds under the pointer and a press, so the row never changes height; only its colours step aside. -->
  <Style Selector="Border.needs-you-row.outlined">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="22,7,22,6" />
  </Style>
  <Style Selector="Border.needs-you-row.outlined:not(:pointerover):not(:pressed)">
    <Setter Property="Background" Value="{DynamicResource Brush.Clickable.Rest}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.InkSubtle}" />
  </Style>
  <!-- Avalonia picks between matching styles by the order they are declared, and this file is included after the queue's: the focus
       ring and the selection bar are restated after the outline so they win over it. A selected row keeps the selection's shape, a thicker
       Primary left edge (the padding makes up the difference, so the content stays put); the focus ring is the same width all round. -->
  <Style Selector="Border.needs-you-row.outlined.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="BorderThickness" Value="4,2,2,2" />
    <Setter Property="Padding" Value="20,7,22,6" />
  </Style>
  <Style Selector="Border.needs-you-row.outlined:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryHover}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="22,7,22,6" />
  </Style>
  <Style Selector="Border.needs-you-row.stale:not(:pointerover):not(:pressed)">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
  <!-- Two lines a row (the fold, screens spec §4.1): the row's buttons are as tall as their text plus a hairline, so a row stays near
       64 px. Specificity beats the generic command-control look in the queue styles. -->
  <Style Selector="Border.needs-you-row Button.command-control">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,2" />
  </Style>
  <Style Selector="Border.needs-you-row Button.command-control:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Padding" Value="9,1" />
  </Style>

  <!-- The inbox page (needs-you spec §2, slice 1). Tokens only; no side stripe, no shadow, no new colour. The row's urgency tint is
       the Home row's (the needs-you-row classes above); the selected row adds a one-pixel ring in HairlineStrong over Surface2. -->
  <Style Selector="TextBlock.attention">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Attention}" />
  </Style>
  <Style Selector="Border.crumb">
    <Setter Property="Height" Value="{StaticResource Size.TopBar}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.inbox-column">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.hairline">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Hairline}" />
  </Style>
  <Style Selector="Border.group-header">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,1" />
  </Style>
  <Style Selector="Border.inbox-row">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.inbox-row.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Clickable.PressedBorder}" />
  </Style>
  <Style Selector="Border.inbox-row:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryHover}" />
  </Style>
  <Style Selector="Border.kind-tile">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
    <Setter Property="Background" Value="{DynamicResource Brush.AttentionSoft}" />
  </Style>
  <Style Selector="Border.kind-tile.large">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="Grid.detail-canvas">
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
  </Style>
  <Style Selector="Border.request-card">
    <Setter Property="MaxWidth" Value="760" />
    <Setter Property="Margin" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.LG}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.card-section">
    <Setter Property="Padding" Value="20,12" />
  </Style>
  <Style Selector="Border.card-section.tinted">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
  <Style Selector="Border.card-footer">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Background" Value="{DynamicResource Brush.AttentionSoft}" />
  </Style>
  <!-- The action bar (needs-you spec §2, slice 2): a strip under the card on Surface1 with a Hairline on top; buttons 32 px high, Radius.SM; the primary is Primary on OnPrimary,
       "Approve?" is AttentionSoft with an Attention border and text, the terminal button is Surface2 with HairlineStrong in mono. The dashed chip is a Rectangle stroke. -->
  <Style Selector="Border.action-bar">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="24,10,24,12" />
  </Style>
  <Style Selector="Button.bar-button">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <!-- A verb that asks first (the merge): the Destructive style, an error-coloured border like the command controls'. -->
  <Style Selector="Button.bar-button.destructive">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
  </Style>
  <Style Selector="Button.bar-button.primary">
    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
  </Style>
  <Style Selector="Button.bar-button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.PrimaryHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
  </Style>
  <Style Selector="Button.bar-button.asking, Button.bar-button.primary.asking">
    <Setter Property="Background" Value="{DynamicResource Brush.AttentionSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Attention}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Attention}" />
  </Style>
  <Style Selector="Button.bar-button.asking:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.bar-button.primary.asking:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AttentionSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Attention}" />
  </Style>
  <Style Selector="Button.bar-button.terminal">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
  </Style>
  <Style Selector="Button.bar-button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryHover}" />
  </Style>
  <Style Selector="Rectangle.chip-dash">
    <Setter Property="Stroke" Value="{DynamicResource Brush.HairlineStrong}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="3,3" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
  </Style>
  <!-- The sticky header over a scrolled group list sits above the rows, and takes no pointer of its own. -->
  <Style Selector="ContentControl.sticky-header">
    <Setter Property="ZIndex" Value="1" />
  </Style>
</Styles>
