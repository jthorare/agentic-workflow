<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ny="using:Aw.Sindri.Ui.ViewModels.NeedsYou"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             x:Class="Aw.Sindri.Ui.Views.NeedsYou.NeedsYouSheet"
             x:DataType="ny:NeedsYouRowViewModel">
  <!-- The sheet of a Needs-you row that is not a decision (a failure, a profile change, a parked item): what the API served
       about it. Its controls are the row's; this sheet shows the command to copy (Y on the row copies it too). -->
  <StackPanel Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <ctl:StateChipView Chip="{Binding Chip}" VerticalAlignment="Center" />
      <TextBlock Classes="mono subtle" Text="{Binding ShownId}" VerticalAlignment="Center" AutomationProperties.Name="{Binding ShownId}" />
    </StackPanel>
    <TextBlock x:Name="SheetRowTitle" Classes="body-strong" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Title}" />
    <TextBlock Classes="body muted" Text="{Binding Label}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Label}" />
    <TextBlock x:Name="SheetRowReason" Classes="body" Text="{Binding Reason}" IsVisible="{Binding HasReasonLine}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Reason}" />
    <TextBlock Classes="caption subtle" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Notice}" />
    <ItemsControl x:Name="SheetRowDetails" ItemsSource="{Binding PrimaryDetails}" IsVisible="{Binding PrimaryDetails.Count}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="ny:SheetDetail">
          <StackPanel Spacing="2" Margin="0,0,0,6">
            <TextBlock Classes="caption subtle" Text="{Binding Label}" />
            <TextBlock Classes="mono" Text="{Binding Value}" TextWrapping="Wrap" />
            <TextBlock Classes="caption subtle" Text="{Binding Hint}" IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="SheetRowCli" Classes="mono" Text="{Binding Cli}" IsVisible="{Binding ShowsCliUpFront}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Cli}" />
    <!-- Review 456-4: a hash and the approve command are bookkeeping; they wait behind Details, closed until asked for. -->
    <Expander x:Name="SheetRowMoreDetails" Header="{Binding MoreHeading}" IsExpanded="{Binding DetailsOpen, Mode=TwoWay}" IsVisible="{Binding HasMoreDetails}" AutomationProperties.Name="{Binding MoreHeading}">
      <ItemsControl ItemsSource="{Binding MoreDetails}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ny:SheetDetail">
            <StackPanel Spacing="2" Margin="0,0,0,6">
              <TextBlock Classes="caption subtle" Text="{Binding Label}" />
              <TextBlock Classes="mono" Text="{Binding Value}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>
  </StackPanel>
</UserControl>
