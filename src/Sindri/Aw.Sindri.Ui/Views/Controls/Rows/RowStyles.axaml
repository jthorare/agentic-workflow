<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rows="using:Aw.Sindri.Ui.Views.Controls.Rows"
        xmlns:vm="using:Aw.Sindri.Ui.ViewModels.Rows">
  <!-- Row (#2978, grammar v2): [glyph 16][id + title, flex, min 200][facts][age 44][waits on 112], 12 px gaps, 24 px inset. Rest is transparent,
       hover Surface2, the keyboard cursor a 2 px PrimaryHover ring inset, the selected row PrimarySoft with a 2 px Primary bar. No borders between rows. -->
  <Style Selector="rows|Row">
    <Setter Property="Height" Value="{DynamicResource Row.Height.Default}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Fill" Background="{TemplateBinding Background}" />
          <Grid Margin="{DynamicResource Row.Inset.Thickness}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" MinWidth="{StaticResource Row.Col.TitleMin}" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <rows:RowGlyphView Name="PART_Glyph" VerticalAlignment="Center" />
            <rows:TitleLine Grid.Column="1" Margin="12,0,0,0" ClipToBounds="True">
              <TextBlock Name="PART_Id" Classes="row-id" />
              <TextBlock Name="PART_Title" Classes="row-title" />
              <TextBlock Name="PART_Sub" Classes="row-sub" IsVisible="False" />
            </rows:TitleLine>
            <StackPanel Name="PART_Facts" Grid.Column="2" Orientation="Horizontal" />
            <TextBlock Name="PART_Age" Grid.Column="3" Classes="row-age" Width="{DynamicResource Row.Col.Age}" Margin="12,0,0,0" />
            <TextBlock Name="PART_Wait" Grid.Column="4" Classes="row-wait" Width="{DynamicResource Row.Col.Wait}" Margin="12,0,0,0" />
          </Grid>
          <StackPanel Name="PART_Actions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0" IsVisible="False" />
          <Border Name="PART_Ring" IsHitTestVisible="False" IsVisible="False" BorderThickness="2" BorderBrush="{DynamicResource Brush.PrimaryHover}" />
          <Border Name="PART_SelBar" Width="2" HorizontalAlignment="Left" IsVisible="False" IsHitTestVisible="False" Background="{DynamicResource Brush.Primary}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=".comfortable rows|Row">
    <Setter Property="Height" Value="{DynamicResource Row.Height.Comfortable}" />
  </Style>
  <Style Selector="rows|Row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
  <Style Selector="rows|Row.sel">
    <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
  </Style>
  <Style Selector="rows|Row.sel /template/ Border#PART_SelBar">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="rows|Row.cursor /template/ Border#PART_Ring">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <!-- Row buttons take the right end (over age and waits on) on hover and under the cursor. -->
  <Style Selector="rows|Row:pointerover /template/ StackPanel#PART_Actions, rows|Row.cursor /template/ StackPanel#PART_Actions">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="rows|Row /template/ TextBlock.row-id">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Type.Mono.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="rows|Row /template/ TextBlock.row-title">
    <Setter Property="FontSize" Value="{DynamicResource Type.Body.Size}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="rows|Row /template/ TextBlock.row-sub">
    <Setter Property="FontSize" Value="{DynamicResource Type.Caption.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="rows|Row /template/ TextBlock.row-age">
    <Setter Property="FontSize" Value="{DynamicResource Type.Caption.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="rows|Row /template/ TextBlock.row-wait">
    <Setter Property="FontSize" Value="{DynamicResource Type.Caption.Size}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- RowList: one scroll viewer over a virtualizing panel of header and row entries; the sticky header is an overlay that the scroll moves. -->
  <Style Selector="rows|RowList">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="True">
          <ScrollViewer Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </ScrollViewer>
          <rows:RowGroupHeader Name="PART_Sticky" VerticalAlignment="Top" IsVisible="False" AutomationProperties.AccessibilityView="Raw" Background="{DynamicResource Brush.Canvas}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="rows|RowGroupHeader">
    <Setter Property="Height" Value="{DynamicResource Row.GroupHeader}" />
    <Setter Property="Padding" Value="{DynamicResource Row.Inset.Thickness}" />
  </Style>
  <!-- PeekPane: 440 px, Surface1, a left hairline. Header 48; fields in 2 columns of 28 px rows (label InkSubtle, value InkMuted); body scrolls; actions at the bottom. -->
  <Style Selector="rows|PeekPane">
    <Setter Property="Width" Value="{DynamicResource Peek.Width}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1,0,0,0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Height="{StaticResource Peek.Header}" Margin="24,0,12,0" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
              <TextBlock Name="PART_Title" Text="{TemplateBinding Title}" Classes="peek-title" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
              <TextBlock Name="PART_Id" Grid.Column="1" Text="{TemplateBinding ItemId}" Classes="peek-id" Margin="8,0,0,0" VerticalAlignment="Center" />
              <Button Name="PART_OpenFull" Grid.Column="3" Content="⤢" Command="{TemplateBinding OpenFullCommand}" Classes="peek-icon" ToolTip.Tip="Open full" AutomationProperties.Name="Open full" />
              <Button Name="PART_Close" Grid.Column="4" Content="×" Command="{TemplateBinding CloseCommand}" Classes="peek-icon" ToolTip.Tip="Close" AutomationProperties.Name="Close" />
            </Grid>
            <ContentPresenter Name="PART_Actions" DockPanel.Dock="Bottom" Content="{TemplateBinding Actions}" Margin="24,12,24,16" />
            <ItemsControl Name="PART_Fields" DockPanel.Dock="Top" ItemsSource="{TemplateBinding Fields}" Margin="24,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PeekField">
                  <Grid Height="{StaticResource Peek.FieldRow}" ColumnDefinitions="80,*">
                    <TextBlock Text="{Binding Label}" Classes="peek-label" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="peek-value" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ContentPresenter Name="PART_Body" Content="{TemplateBinding Body}" Margin="24,12" />
            </ScrollViewer>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="rows|PeekPane /template/ TextBlock.peek-title">
    <Setter Property="FontSize" Value="{DynamicResource Type.SectionTitle.Size}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="rows|PeekPane /template/ TextBlock.peek-id">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Type.Mono.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
  </Style>
  <Style Selector="rows|PeekPane /template/ TextBlock.peek-label">
    <Setter Property="FontSize" Value="{DynamicResource Type.Caption.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
  </Style>
  <Style Selector="rows|PeekPane /template/ TextBlock.peek-value">
    <Setter Property="FontSize" Value="{DynamicResource Type.Caption.Size}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.InkMuted}" />
  </Style>
  <Style Selector="rows|PeekPane /template/ Button.peek-icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
</Styles>
