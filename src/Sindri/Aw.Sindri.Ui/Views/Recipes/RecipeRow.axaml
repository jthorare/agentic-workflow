<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Aw.Sindri.Ui.ViewModels.Recipes"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             x:Class="Aw.Sindri.Ui.Views.Recipes.RecipeRow"
             x:DataType="rec:RecipeRowViewModel">
  <!-- One workflow on the Recipes page (recipes spec §2): the plain name (a button: it opens the sheet) with the id in grey mono, the version, the standing as a chip
       with a second grey word when it is out of date, the size, what it needs and produces, the fingerprint, and the run figures (runs, finished, typical time). The columns are the page header's. The row draws its own
       focus border (item-row), not the adorner. Every named line is a Border wrapper (a TextBlock's peer ignores AutomationProperties.Name). -->
  <Border x:Name="RecipeRowFrame" Classes="item-row" Classes.selected="{Binding IsSelected}" Focusable="True"
          AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
    <Grid ColumnDefinitions="2*,70,170,80,90,100,60,90,90" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
        <Button x:Name="RecipeRowOpen" Classes="row-title" Click="OnOpen" AutomationProperties.Name="{Binding AccessibleName}">
          <TextBlock Classes="body-strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
        </Button>
        <TextBlock x:Name="RecipeRowId" Classes="caption mono subtle" Text="{Binding ShortId}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Grid.Column="1" x:Name="RecipeRowVersion" Classes="caption mono subtle" Text="{Binding VersionText}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ctl:StateChipView x:Name="RecipeRowStanding" Chip="{Binding StandingChip}" />
        <TextBlock x:Name="RecipeRowOutOfDate" Classes="caption subtle" Text="{Binding OutOfDateText}" IsVisible="{Binding IsOutOfDate}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Column="3" x:Name="RecipeRowSteps" Classes="caption subtle" Text="{Binding StepsText}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="4" x:Name="RecipeRowFlow" Classes="caption subtle" Text="{Binding FlowText}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="5" x:Name="RecipeRowFingerprint" Classes="caption mono subtle" Text="{Binding Fingerprint}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="6" x:Name="RecipeRowRuns" Classes="caption subtle" Text="{Binding RunsText}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="7" x:Name="RecipeRowFinished" Classes="caption subtle" Text="{Binding FinishedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="8" x:Name="RecipeRowTypical" Classes="caption subtle" Text="{Binding TypicalText}" VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
