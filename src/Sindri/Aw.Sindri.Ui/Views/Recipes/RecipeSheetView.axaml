<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Aw.Sindri.Ui.ViewModels.Recipes"
             xmlns:rv="using:Aw.Sindri.Ui.Views.Recipes"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             x:Class="Aw.Sindri.Ui.Views.Recipes.RecipeSheetView"
             x:DataType="rec:RecipeSheetViewModel">
  <!-- The recipe sheet (screens spec §4.3, U10a), read-only, inside the shell's sheet: the header (id@hash, version, urgency, the name template),
       the states band, then what the recipe declares as inputs and outputs. A refusal or an unreadable answer shows its sentence with Back. -->
  <StackPanel x:Name="RecipeSheet" Spacing="{StaticResource Space.MD}">
    <TextBlock x:Name="RecipeLoading" Classes="body muted" Text="{Binding LoadingText}" IsVisible="{Binding IsLoading}" AutomationProperties.Name="{Binding LoadingText}" />
    <TextBlock x:Name="RecipeProblem" Classes="body" Text="{Binding ProblemText}" IsVisible="{Binding IsProblem}" TextWrapping="Wrap" AutomationProperties.Name="{Binding ProblemText}" />
    <Button x:Name="RecipeBack" Classes="not-found-back" Classes.shown="{Binding IsProblem}" Content="{Binding BackText}" Click="OnBack"
            HorizontalAlignment="Left" AutomationProperties.Name="{Binding BackText}" />

    <StackPanel x:Name="RecipeBody" Spacing="{StaticResource Space.MD}" IsVisible="{Binding IsShown}">
      <StackPanel Spacing="4">
        <TextBlock x:Name="RecipeTitle" Classes="detail-title" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Title}" />
        <TextBlock x:Name="RecipeNote" Classes="body-strong" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Note}" />
        <TextBlock x:Name="RecipeDescription" Classes="body muted" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Description}" />
        <ctl:StateChipView x:Name="RecipeStanding" Chip="{Binding StandingChip}" HorizontalAlignment="Left" />
      </StackPanel>
      <!-- Where the workflow stands (recipes spec §2): a callout for Not approved, Revoked or Out of date, why it is out of date, and the terminal command that approves it
           (the app approves nothing here: it copies the command). Shown only once the list has answered. -->
      <Border x:Name="RecipeCallout" Classes="frame-panel" IsVisible="{Binding HasCallout}">
        <StackPanel Spacing="6">
          <TextBlock x:Name="RecipeCalloutText" Classes="body-strong" Text="{Binding CalloutText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding CalloutText}" />
          <ItemsControl x:Name="RecipeStaleReasons" ItemsSource="{Binding StaleReasons}" IsVisible="{Binding HasStaleReasons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel x:Name="RecipeApprove" Spacing="4" IsVisible="{Binding NeedsApproval}">
            <TextBlock Classes="caption subtle" Text="{Binding ApproveHint}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="RecipeApproveCommand" Classes="caption mono" Text="{Binding ApproveCommand}" VerticalAlignment="Center" AutomationProperties.Name="{Binding ApproveCommand}" />
              <Button x:Name="RecipeApproveCopy" Classes="copy" Content="{Binding CopyLabel}" Click="OnCopyApprove" AutomationProperties.Name="{Binding CopyLabel}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <Panel IsVisible="{Binding States, Converter={x:Static ObjectConverters.IsNotNull}}">
        <rv:RecipeStatesBand x:Name="RecipeStates" DataContext="{Binding States}" />
      </Panel>
      <Panel IsVisible="{Binding Facts, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border x:Name="RecipeFacts" Classes="frame-panel" DataContext="{Binding Facts}" x:DataType="rec:RecipeFactsViewModel">
          <StackPanel Spacing="8">
            <TextBlock Classes="eyebrow" Text="{Binding InputsHeading}" />
            <ItemsControl x:Name="RecipeInputs" ItemsSource="{Binding Inputs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rec:RecipeFactRowViewModel">
                  <Border Margin="0,0,0,8" AutomationProperties.Name="{Binding Label}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                    <StackPanel Spacing="2" AutomationProperties.AccessibilityView="Raw">
                      <TextBlock Name="RecipeInputLabel" Classes="body-strong" Text="{Binding Label}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="eyebrow" Text="{Binding OutputsHeading}" />
            <TextBlock x:Name="RecipeNoOutputs" Classes="body muted" Text="{Binding NoOutputsText}" IsVisible="{Binding !HasOutputs}" TextWrapping="Wrap" AutomationProperties.Name="{Binding NoOutputsText}" />
            <ItemsControl x:Name="RecipeOutputs" ItemsSource="{Binding Outputs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="rec:RecipeFactRowViewModel">
                  <Border Margin="0,0,0,8" AutomationProperties.Name="{Binding Label}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                    <StackPanel Spacing="2" AutomationProperties.AccessibilityView="Raw">
                      <TextBlock Name="RecipeOutputLabel" Classes="body-strong" Text="{Binding Label}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Panel>
      <!-- Everything a person does not need to read the workflow: the id, hash, version, urgency, name template, and each input's key and type. Closed until opened. -->
      <Expander x:Name="RecipeDetails" Header="{Binding DetailsText}" IsExpanded="{Binding IsDetailsOpen, Mode=TwoWay}" AutomationProperties.Name="{Binding DetailsText}">
        <StackPanel Spacing="4">
          <TextBlock x:Name="RecipeIdentity" Classes="caption mono" Text="{Binding Identity}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Identity}" />
          <TextBlock x:Name="RecipeNameTemplate" Classes="caption mono" Text="{Binding NameLine}" IsVisible="{Binding HasName}" TextWrapping="Wrap" AutomationProperties.Name="{Binding NameLine}" />
          <ItemsControl x:Name="RecipeFactDetails" ItemsSource="{Binding Facts.Details}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="caption mono subtle" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
  </StackPanel>
</UserControl>
