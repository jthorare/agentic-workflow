<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Sindri.Ui.Desktop: the thin desktop head of the Sindri app (readiness spec §4a "UI"): Main, composition and one
       adapter per Aw.Sindri.Ui port. It holds no views or view models. NativeAOT entry point 'sindri-ui' (spec §4b.6
       AOT scope); bare 'sindri' starts it when it sits next to the sindri binary. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AwAotEntryPoint>true</AwAotEntryPoint>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <AssemblyName>sindri-ui</AssemblyName>
    <RootNamespace>Aw.Sindri.Ui.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The reduce-motion readers' [LibraryImport]s (MacMotion's UTF-8 class and selector names) generate unsafe
         marshalling code; the head's own code has no unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Sindri.Ui/Aw.Sindri.Ui.csproj" />
    <ProjectReference Include="../../Aw.Kernel.Telemetry/Aw.Kernel.Telemetry.csproj" />
    <ProjectReference Include="../../UiDriver/Aw.UiDriver.Avalonia/Aw.UiDriver.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Sindri.Ui.Tests" />
    <InternalsVisibleTo Include="Aw.Sindri.Ui.Rendering.Tests" />
  </ItemGroup>
</Project>
