<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.UiDriver.Core: the wire protocol of the UI driver (selectors, verbs, node facts, errors) and the pure rules over it:
       how a selector matches a node, when a wait holds, how a key chord reads. No I/O, clock or random ids (BannedSymbols.txt,
       spec §4b.1). The driver drives any Avalonia app; nothing here knows Avalonia or an app. Its types are internal: the
       adapter (Aw.UiDriver.Avalonia) and the client and CLI (Aw.UiDriver.Cli) of this package see them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.UiDriver.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.UiDriver.Avalonia" />
    <InternalsVisibleTo Include="Aw.UiDriver.Cli" />
    <InternalsVisibleTo Include="aw-ui-driver" />
    <InternalsVisibleTo Include="Aw.UiDriver.Tests" />
    <InternalsVisibleTo Include="Aw.UiDriver.Avalonia.Tests" />
  </ItemGroup>
</Project>
