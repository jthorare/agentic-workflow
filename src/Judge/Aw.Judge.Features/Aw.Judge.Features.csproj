<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Judge.Features (scaffolded by /new-package): one folder per use case (slice): request and response
       records, the service and its validator (spec §4b.2). Another package only through its Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Judge.Features</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Judge.Core/Aw.Judge.Core.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Judge.Tests" />
    <InternalsVisibleTo Include="Aw.Judge.Testing" />
  </ItemGroup>
</Project>
