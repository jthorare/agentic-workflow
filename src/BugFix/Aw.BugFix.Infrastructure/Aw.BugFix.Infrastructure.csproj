<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.BugFix.Infrastructure (scaffolded by /new-package): the adapters behind Core's ports (SQL repositories,
       processes, HTTP, files) and this package's settings, read from the environment Composition passes (spec §4b.1,
       .agents/rules/csharp.md Seams). Its row and DTO types stay internal (ARCH-INFRA-001). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.BugFix.Infrastructure</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.BugFix.Core/Aw.BugFix.Core.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.BugFix.Tests" />
    <InternalsVisibleTo Include="Aw.BugFix.Testing" />
  </ItemGroup>
</Project>
