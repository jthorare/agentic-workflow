<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Meta.Infrastructure (scaffolded by /new-package): the adapters behind Core's ports (SQL repositories,
       processes, HTTP, files) and this package's settings, read from the environment Composition passes (spec §4b.1,
       .agents/rules/csharp.md Seams). Its row and DTO types stay internal (ARCH-INFRA-001). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Meta.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Meta.Core/Aw.Meta.Core.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../Aw.Kernel.Data/Aw.Kernel.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schema migrations, loaded by Aw.Kernel.Data's EmbeddedMigrations under MetaDatabase.ResourcePrefix. -->
    <EmbeddedResource Include="Sqlite/Migrations/*.sql" LogicalName="Aw.Meta.Infrastructure.Sqlite.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(AwBuildTime)' != ''">
    <!-- scripts/install-meta.sh publishes with -p:AwBuildTime=<UTC ISO 8601> -p:SourceRevisionId=<commit>; `aw-meta version` reads both back (AssemblyBuildInfo). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AwBuildTime</_Parameter1>
      <_Parameter2>$(AwBuildTime)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Meta.Tests" />
    <InternalsVisibleTo Include="Aw.Meta.Testing" />
  </ItemGroup>
</Project>
