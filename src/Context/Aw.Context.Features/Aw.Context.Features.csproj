<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Context.Features (scaffolded by /new-package): one folder per use case (slice): request and response
       records, the service and its validator (spec §4b.2). Another package only through its Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Context.Features</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Context.Core/Aw.Context.Core.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Context.Tests" />
    <InternalsVisibleTo Include="Aw.Context.Testing" />
  </ItemGroup>
</Project>
