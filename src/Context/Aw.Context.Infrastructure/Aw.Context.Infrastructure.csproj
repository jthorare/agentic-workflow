<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Context.Infrastructure (scaffolded by /new-package): the adapters behind Core's ports (SQL repositories,
       processes, HTTP, files) and this package's settings, read from the environment Composition passes (spec §4b.1,
       .agents/rules/csharp.md Seams). Its row and DTO types stay internal (ARCH-INFRA-001). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Context.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- ILogger and [LoggerMessage] for the Linear adapter; the host's Aw.Kernel.Telemetry brings the implementation. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Map files (stage S-3a): the parser and representation model only, no reflection serializer (AOT-safe). -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Context.Core/Aw.Context.Core.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../Aw.Kernel.Data/Aw.Kernel.Data.csproj" />
    <ProjectReference Include="../../Redaction/Aw.Redaction/Aw.Redaction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Store/Migrations/*.sql" />
    <!-- The native Linear adapter's GraphQL operations (D18), read by name: linear.<Operation>.graphql. -->
    <EmbeddedResource Include="Linear/Operations/*.graphql" LogicalName="linear.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Context.Tests" />
    <InternalsVisibleTo Include="Aw.Context.Testing" />
  </ItemGroup>
</Project>
