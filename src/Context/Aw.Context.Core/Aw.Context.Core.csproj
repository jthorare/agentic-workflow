<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Context.Core (scaffolded by /new-package): domain types, typed ids, value objects, pure logic, port
       interfaces and errors. No I/O, clock or random ids (BannedSymbols.txt, spec §4b.1). context retrieval engine: product graph, source adapters, query planner (context spec §4); the package lands in stage S-1A -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Context.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Vogen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Context.Tests" />
    <InternalsVisibleTo Include="Aw.Context.Testing" />
    <InternalsVisibleTo Include="Aw.Context.Features" />
    <InternalsVisibleTo Include="Aw.Context.Infrastructure" />
  </ItemGroup>
</Project>
