<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Transcripts.Core (scaffolded by /new-package): domain types, typed ids, value objects, pure logic, port
       interfaces and errors. No I/O, clock or random ids (BannedSymbols.txt, spec §4b.1). the local agent transcript corpus: Claude Code, Codex and Cursor session files read as one provider-neutral list of sessions and human/assistant turns, with opaque refs and scrubbed text; no model calls (issue 3787) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Transcripts.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Vogen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Transcripts.Tests" />
    <InternalsVisibleTo Include="Aw.Transcripts.Testing" />
  </ItemGroup>
</Project>
