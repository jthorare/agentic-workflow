{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/line/design.json",
  "title": "The design (fact:design)",
  "description": "Line spec A.1 and 4.2-4.4: sections, coverage, decisions, signals and contracts; A.2 adds resolutions; A.1 Done-when adds unresolved[]. Spec text is silent on the element shapes beyond 4.2's decision example, so the rest follows DSN-COV-001, DSN-ACC-001, DSN-CITE-001, DSN-XSPEC-001..003 and DSN-LENS-003.",
  "type": "object",
  "properties": {
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assumes": {
            "type": "string",
            "description": "The open decision option this section was written under, e.g. D3.a (DSN-DEC-001)."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "array",
      "description": "DSN-COV-001: the surface table.",
      "items": {
        "type": "object",
        "properties": {
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "excluded": {
            "type": "string",
            "description": "The one-line reason the surface is excluded."
          }
        },
        "required": [
          "surface"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "description": "Spec 4.2: two or three options, exactly one recommended (DSN-DEC-001).",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "answer": {
                  "type": "string",
                  "minLength": 1
                },
                "tradeoffs": {
                  "type": "string"
                },
                "recommended": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "answer"
              ],
              "additionalProperties": false
            }
          },
          "status": {
            "enum": [
              "open",
              "answered",
              "deferred"
            ]
          }
        },
        "required": [
          "id",
          "question",
          "affects",
          "options",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "signals": {
      "type": "array",
      "description": "DSN-ACC-001: item to proof signals.",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "runs": {
                  "enum": [
                    "head",
                    "base+head"
                  ]
                },
                "script": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A signal that runs at base+head names the file that fails at the base and passes at the head: a relative path inside the workspace, no '..'. DSN-ACC-001 refuses one that is rooted or has '..'."
                }
              },
              "required": [
                "kind",
                "statement",
                "runs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "item",
          "signals"
        ],
        "additionalProperties": false
      }
    },
    "contracts": {
      "type": "array",
      "description": "DSN-XSPEC-001..003: edits to other specs.",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "edit": {
            "type": "string"
          },
          "row": {
            "type": "integer",
            "minimum": 1
          },
          "lane": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "heading",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "resolutions": {
      "type": "array",
      "description": "DSN-LENS-003: the written resolution of each MEDIUM and LOW finding.",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "finding",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "description": "A.1 Done when: each finding left after two fix attempts, with why.",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "finding",
          "why"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sections"
  ],
  "additionalProperties": false
}
