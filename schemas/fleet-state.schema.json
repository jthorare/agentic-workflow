{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workflow.local/schemas/fleet-state.schema.json",
  "title": "fleet state file",
  "description": "One session's state, written by the aw:fleet hook at $AW_FLEET_DIR/<provider>/<sessionId>.json (spec 2026-10-16-sindri-session-collector-design.md section 5.1). The provider field and the directory name are the catalog's AgentId (claude-code, never claude); the hook maps AW_HOOK_PROVIDER (unset or claude -> claude-code). Validate with Ajv2020.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "sessionId", "event", "state", "at", "cwd", "transcript", "agentPid", "agentStartTicks", "env"],
  "properties": {
    "schema": { "const": 1 },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "not": { "const": "claude" },
      "description": "An AgentId (launcher.schema.json $defs.agentId). Claude Code is claude-code: the hook maps AW_HOOK_PROVIDER claude or unset to it, so claude itself never appears."
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "Checked against the generic id pattern before the write."
    },
    "event": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "description": "The event as the canonical hook sees it (the adapters' Claude-shaped name)."
    },
    "state": { "enum": ["running", "asking", "idle", "ended"] },
    "reason": { "enum": ["approval", "input", "auth"], "description": "asking only." },
    "tool": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "The tool name, never tool_input. In asking approval: the tool the prompt is for. In running: the session's last tool (PreToolUse or PostToolUse), with toolAt. Not in idle or ended."
    },
    "toolAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "description": "When the hook saw that tool event. Present exactly when state is running and tool is; an approval ask has no toolAt."
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "cwd": { "type": "string", "minLength": 1 },
    "transcript": { "type": ["string", "null"], "minLength": 1 },
    "agentPid": { "type": ["integer", "null"], "minimum": 1 },
    "agentStartTicks": { "type": ["integer", "null"], "minimum": 0 },
    "env": {
      "type": "object",
      "description": "macOS only (spec 4.4): the allowlisted names; {} on Linux.",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "asking" } }, "required": ["state"] },
      "then": { "required": ["reason"] },
      "else": { "not": { "required": ["reason"] } }
    },
    {
      "if": { "required": ["tool"] },
      "then": {
        "properties": { "state": { "enum": ["asking", "running"] } },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "asking" } }, "required": ["state"] },
            "then": { "properties": { "reason": { "const": "approval" } }, "not": { "required": ["toolAt"] } }
          },
          {
            "if": { "properties": { "state": { "const": "running" } }, "required": ["state"] },
            "then": { "required": ["toolAt"] }
          }
        ]
      },
      "else": { "not": { "required": ["toolAt"] } }
    },
    {
      "if": { "properties": { "agentPid": { "type": "integer" } }, "required": ["agentPid"] },
      "then": { "properties": { "agentStartTicks": { "type": "integer" } } },
      "else": { "properties": { "agentStartTicks": { "type": "null" } } }
    }
  ]
}
