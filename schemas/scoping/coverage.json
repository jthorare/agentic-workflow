{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/scoping/coverage.json",
  "title": "Lens coverage (fact:coverage and coverage.json)",
  "description": "Spec 8.3 coverage.json: \"One row per lens: state, searched (anchors, sources and states, map version, depth, hops), recorded limits, map coverage, found count and ids\". Row shape as in the line gold (tests/fixtures/line/gold/scope/expiry/coverage.json) and aw-packets lenses.json. SCP-COV-001: one row per lens; SCP-COV-002: found, nothing-found or not-searched; a lens the profile marks none is not-applicable.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Packet-file envelope: present in the file written to the scope packet (aw-packets: every JSON file carries schemaVersion 1), absent in the fact."
    },
    "lenses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lens": {
            "enum": [
              "code",
              "product",
              "related",
              "history"
            ]
          },
          "state": {
            "enum": [
              "found",
              "nothing-found",
              "not-searched",
              "not-applicable"
            ]
          },
          "searched": {
            "type": "object",
            "properties": {
              "anchors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "state": {
                          "enum": [
                            "ok",
                            "degraded",
                            "unavailable",
                            "not-configured"
                          ]
                        },
                        "reason": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        },
                        "catchingUp": {
                          "type": "object",
                          "description": "A code index that trails the map along main (the recorded limit catching-up, state ok): the commit it describes, the map's commit, and the files changed between them, whose rows may be out of date.",
                          "properties": {
                            "indexCommit": {
                              "type": "string",
                              "minLength": 1
                            },
                            "mapCommit": {
                              "type": "string",
                              "minLength": 1
                            },
                            "pending": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          },
                          "required": [
                            "indexCommit",
                            "mapCommit",
                            "pending"
                          ],
                          "additionalProperties": false
                        },
                        "sync": {
                          "type": "object",
                          "description": "A never-synced source's sync pair (scoping spec 8.2, Recorded limits): ScopeFixLines words the stop row by it.",
                          "properties": {
                            "state": {
                              "enum": [
                                "queued",
                                "running",
                                "finished",
                                "failed"
                              ]
                            },
                            "code": {
                              "type": "string"
                            },
                            "failures": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "retryAt": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "state"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "id",
                        "state"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "mapVersion": {
                "type": "string",
                "minLength": 1
              },
              "depth": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "hops": {
                "type": "array",
                "items": {
                  "enum": [
                    "state",
                    "flow",
                    "dependency",
                    "component"
                  ]
                }
              }
            },
            "required": [
              "anchors",
              "sources",
              "mapVersion",
              "depth",
              "hops"
            ],
            "additionalProperties": false
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "not": {
                  "type": "string",
                  "minLength": 1
                },
                "why": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A recorded limit: index-not-built, history-unlinked, commit-not-held, not-synced, catching-up, not-configured, or anchor-missing (an asked anchor the view couldn't find; 'not' names the anchor) (SCP-COV-002)."
                }
              },
              "required": [
                "not",
                "why"
              ],
              "additionalProperties": false
            }
          },
          "mapCoverage": {
            "type": "object",
            "properties": {
              "mapped": {
                "type": "integer",
                "minimum": 0
              },
              "new": {
                "type": "integer",
                "minimum": 0
              },
              "unmapped": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "mapped",
              "new",
              "unmapped"
            ],
            "additionalProperties": false
          },
          "found": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^L-(code|product|related|history)-[1-9][0-9]*$"
                }
              }
            },
            "required": [
              "count",
              "ids"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "lens",
          "state",
          "searched",
          "limits",
          "mapCoverage",
          "found"
        ],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 4,
      "allOf": [
        {
          "contains": {
            "properties": {
              "lens": {
                "const": "code"
              }
            },
            "required": [
              "lens"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "lens": {
                "const": "product"
              }
            },
            "required": [
              "lens"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "lens": {
                "const": "related"
              }
            },
            "required": [
              "lens"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "lens": {
                "const": "history"
              }
            },
            "required": [
              "lens"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "lenses"
  ],
  "additionalProperties": false
}
