{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/scoping/questions.json",
  "title": "Interview questions (fact:questions)",
  "description": "Spec 7.3: each question carries two to four options plus \"other\" and \"skip\"; every option cites; at most one option is recommended here; SCP-QST-001 requires exactly one, and two to four options, on the facts, so it can name the question; at most five per round (7.2).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^Q([0-9]+|-revise)$"
      },
      "surfaces": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$",
          "description": "A surface id in the scope map."
        }
      },
      "dimension": {
        "type": "string"
      },
      "impact": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      },
      "blocks": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^AC-[1-9][0-9]*$",
          "description": "An acceptance item id (spec 7.3: blocks [\"AC-4\"]). The answer-log id is A<n>."
        }
      },
      "trust": {
        "enum": [
          "untrusted",
          "owner"
        ],
        "description": "Stamped by code (SCP-TRUST-001). The spec 7.3 example carries it on a question; a draft-stage model-written value is a finding, so it is optional here."
      },
      "question": {
        "type": "string",
        "minLength": 1
      },
      "options": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^Q([0-9]+|-revise)\\.[a-z]$"
            },
            "answer": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string"
            },
            "cites": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(R[1-9][0-9]*|A[1-9][0-9]*|L-(code|product|related|history)-[1-9][0-9]*)$"
              },
              "description": "Ids that resolve (SCP-CITE-001): a lens item L-<lens>-<n>, a source ref R<n> in fact:brief.refs, or an answer A<n> in the answer log.",
              "minItems": 1
            },
            "recommended": {
              "type": "boolean"
            },
            "yields": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "answer",
            "cites"
          ],
          "additionalProperties": false
        },
        "minItems": 2,
        "maxItems": 4,
        "contains": {
          "properties": {
            "recommended": {
              "const": true
            }
          },
          "required": [
            "recommended"
          ]
        },
        "minContains": 0,
        "maxContains": 1
      },
      "other": {
        "type": "boolean"
      },
      "skip": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "question",
      "options",
      "other",
      "skip"
    ],
    "additionalProperties": false
  },
  "maxItems": 5
}
