{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/deps.schema.json",
  "title": "deps.yaml — the declared package graph (spec §4b.1a)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "limits",
    "packages",
    "edges",
    "exceptions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageFanOut",
        "projectFanOut",
        "thirdPartyFanOut",
        "exceptionMaxDays"
      ],
      "properties": {
        "packageFanOut": {
          "type": "integer",
          "minimum": 1,
          "description": "Max packages one package declares project edges to (test packages exempt). The declared-graph view of fan-out; DEPS-FANOUT-001."
        },
        "projectFanOut": {
          "type": "integer",
          "minimum": 1,
          "description": "Max in-repo projects one C# project references (§4b.1a; *.Host and *.Tests exempt). DEPS-FANOUT-002."
        },
        "thirdPartyFanOut": {
          "type": "integer",
          "minimum": 1,
          "description": "Max third-party packages one C# project references, analyzers (PrivateAssets=all) excluded (§4b.1a; *.Host and *.Tests exempt). DEPS-FANOUT-003."
        },
        "exceptionMaxDays": {
          "type": "integer",
          "minimum": 1,
          "description": "Longest allowed span from an exception's recorded date to its expiry."
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/~$][^\\s]*$"
    },
    "relPaths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relPath"
      },
      "uniqueItems": true
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ts",
        "src",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "package",
            "shell",
            "mod"
          ],
          "description": "package = ported to C# under src/; shell = bash that stays; mod = Claude Code mod that stays TS."
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "sublevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9,
          "description": "Orders packages inside tier 0 (the kernel family). Only allowed on tier 0."
        },
        "test": {
          "type": "boolean",
          "description": "A test-support package: exempt from the fan-out limit, and only test projects may reference it without a declared edge."
        },
        "analyzer": {
          "type": "boolean",
          "description": "A Roslyn analyzer package: referenced only with OutputItemType=\"Analyzer\" (build-time), never at runtime, and needs no declared edge."
        },
        "ts": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the TypeScript lives today, or null."
        },
        "src": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the C# package lives after its port, or null for shell and mod nodes."
        },
        "projectPrefix": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9.]*$",
          "description": "C# project names that belong to this package start with this prefix."
        },
        "scan": {
          "$ref": "#/$defs/relPaths",
          "description": "Source dirs scanned for cli/db/file edges."
        },
        "bins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "binPaths": {
          "$ref": "#/$defs/relPaths",
          "description": "Repo-relative entry points launched by path (no installed bin)."
        },
        "db": {
          "$ref": "#/$defs/relPaths",
          "description": "SQLite files this package owns, relative to the state root."
        },
        "files": {
          "$ref": "#/$defs/relPaths",
          "description": "State files or dirs this package owns, relative to the state root."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "State-root directory this package owns; any other node using a path under it needs a file (or db) edge."
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package"
              }
            }
          },
          "then": {
            "required": [
              "tier",
              "projectPrefix"
            ]
          }
        },
        {
          "if": {
            "required": [
              "sublevel"
            ]
          },
          "then": {
            "properties": {
              "tier": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "shell",
                  "mod"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "tier"
                  ]
                },
                {
                  "required": [
                    "sublevel"
                  ]
                },
                {
                  "required": [
                    "test"
                  ]
                },
                {
                  "required": [
                    "analyzer"
                  ]
                },
                {
                  "required": [
                    "projectPrefix"
                  ]
                },
                {
                  "required": [
                    "bins"
                  ]
                },
                {
                  "required": [
                    "binPaths"
                  ]
                },
                {
                  "required": [
                    "db"
                  ]
                },
                {
                  "required": [
                    "files"
                  ]
                },
                {
                  "required": [
                    "namespace"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind",
        "status",
        "note"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "project",
            "cli",
            "db",
            "file",
            "compose"
          ],
          "description": "project = a C# ProjectReference to the other package's Core (or a tier-0 package's library projects); compose = a Host's ProjectReference to a lower-tier, non-tier-0 package's Features and Infrastructure, for their public Add…() registration methods only (DEPS-COMPOSE-001, ARCH-COMPOSE-001; needs a project edge beside it, which only a Core reference makes current); cli, db, file as described in deps.yaml."
        },
        "status": {
          "enum": [
            "current",
            "planned"
          ],
          "description": "current = the scan must find it today; planned = allowed, not yet built."
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "subject",
        "reason",
        "recorded",
        "expires"
      ],
      "properties": {
        "rule": {
          "enum": [
            "DEPS-FANOUT-001",
            "DEPS-FANOUT-002",
            "DEPS-FANOUT-003"
          ],
          "description": "Only the fan-out rules take exceptions."
        },
        "subject": {
          "$ref": "#/$defs/id",
          "description": "The package the exception covers (for DEPS-FANOUT-002/003: every project of that package)."
        },
        "edge": {
          "$ref": "#/$defs/id",
          "description": "DEPS-FANOUT-001 only: the package of the declared project edge (subject -> edge) this exception is attached to. It then covers that one edge: the fan-out without it must be within the limit. DEPS-EXC-004 when no such edge is declared or it points into a test-support package (fan-out never counts those)."
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "recorded": {
          "$ref": "#/$defs/date"
        },
        "expires": {
          "$ref": "#/$defs/date"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "edge"
            ]
          },
          "then": {
            "properties": {
              "rule": {
                "const": "DEPS-FANOUT-001"
              }
            }
          }
        }
      ]
    }
  }
}
