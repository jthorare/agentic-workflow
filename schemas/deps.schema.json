{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/deps.schema.json",
  "title": "deps.yaml — the declared package graph (spec §4b.1a)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "limits",
    "packages",
    "edges",
    "exceptions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectFanOut",
        "thirdPartyFanOut",
        "exceptionMaxDays"
      ],
      "properties": {
        "projectFanOut": {
          "type": "integer",
          "minimum": 1,
          "description": "Max in-repo projects one C# project references (§4b.1a; *.Host and *.Tests exempt). DEPS-FANOUT-002."
        },
        "thirdPartyFanOut": {
          "type": "integer",
          "minimum": 1,
          "description": "Max third-party packages one C# project references, analyzers (PrivateAssets=all) excluded (§4b.1a; *.Host and *.Tests exempt). DEPS-FANOUT-003."
        },
        "exceptionMaxDays": {
          "type": "integer",
          "minimum": 1,
          "description": "Longest allowed span from an exception's recorded date to its expiry."
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/~$][^\\s]*$"
    },
    "relPaths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relPath"
      },
      "uniqueItems": true
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "src",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "package",
            "shell"
          ],
          "description": "package = a C# package under src/; shell = bash that stays and only consumes."
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "sublevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9,
          "description": "Orders packages inside tier 0 (the kernel family). Only allowed on tier 0."
        },
        "test": {
          "type": "boolean",
          "description": "A test-support package: exempt from the fan-out limit, and only test projects may reference it without a declared edge."
        },
        "analyzer": {
          "type": "boolean",
          "description": "A Roslyn analyzer package: referenced only with OutputItemType=\"Analyzer\" (build-time), never at runtime, and needs no declared edge."
        },
        "src": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the C# package lives, or null for shell nodes."
        },
        "projectPrefix": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9.]*$",
          "description": "C# project names that belong to this package start with this prefix."
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9.]*$"
          },
          "uniqueItems": true,
          "description": "Project names of this package, besides its Core, that other packages may reference (DEPS-PROJ-007 carve-out): a reviewed exception, e.g. the in-app half of a library an app links."
        },
        "scan": {
          "$ref": "#/$defs/relPaths",
          "description": "Source dirs scanned for cli/db/file edges."
        },
        "bins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "binPaths": {
          "$ref": "#/$defs/relPaths",
          "description": "Repo-relative entry points launched by path (no installed bin)."
        },
        "db": {
          "$ref": "#/$defs/relPaths",
          "description": "SQLite files this package owns, relative to the state root."
        },
        "files": {
          "$ref": "#/$defs/relPaths",
          "description": "State files or dirs this package owns, relative to the state root."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "State-root directory this package owns; any other node using a path under it needs a file (or db) edge."
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/[a-z0-9][a-z0-9/-]*/$"
          },
          "uniqueItems": true,
          "minItems": 1,
          "description": "HTTP route prefixes this package serves (e.g. /sindri/); another package's C# string literal starting with one is an http edge."
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package"
              }
            }
          },
          "then": {
            "required": [
              "tier",
              "projectPrefix"
            ]
          }
        },
        {
          "if": {
            "required": [
              "sublevel"
            ]
          },
          "then": {
            "properties": {
              "tier": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "shell"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "tier"
                  ]
                },
                {
                  "required": [
                    "sublevel"
                  ]
                },
                {
                  "required": [
                    "test"
                  ]
                },
                {
                  "required": [
                    "analyzer"
                  ]
                },
                {
                  "required": [
                    "projectPrefix"
                  ]
                },
                {
                  "required": [
                    "bins"
                  ]
                },
                {
                  "required": [
                    "binPaths"
                  ]
                },
                {
                  "required": [
                    "db"
                  ]
                },
                {
                  "required": [
                    "files"
                  ]
                },
                {
                  "required": [
                    "namespace"
                  ]
                },
                {
                  "required": [
                    "routes"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind",
        "status",
        "note"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "project",
            "cli",
            "db",
            "file",
            "http",
            "compose"
          ],
          "description": "project = a C# ProjectReference to the other package's Core (or a tier-0 package's library projects); compose = a Host's ProjectReference to a lower-tier, non-tier-0 package's Features and Infrastructure, for their public Add…() registration methods only (DEPS-COMPOSE-001, ARCH-COMPOSE-001; needs a project edge beside it, which only a Core reference makes current); http = calls the other package's HTTP API, which it declares as routes (DEPS-KIND-004 otherwise); cli, db, file as described in deps.yaml."
        },
        "status": {
          "enum": [
            "current",
            "planned"
          ],
          "description": "current = the scan must find it today; planned = allowed, not yet built."
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "subject",
        "reason",
        "recorded",
        "expires"
      ],
      "properties": {
        "rule": {
          "enum": [
            "DEPS-FANOUT-002",
            "DEPS-FANOUT-003",
            "DEPS-CYCLE-001"
          ],
          "description": "Only the fan-out rules and the cycle rule take exceptions."
        },
        "subject": {
          "$ref": "#/$defs/id",
          "description": "The package the exception covers: every project of that package (DEPS-FANOUT-002/003), or the package its excused edge leaves (DEPS-CYCLE-001)."
        },
        "excuses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "kind"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/id"
            },
            "to": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "enum": [
                "cli",
                "http"
              ]
            }
          },
          "description": "DEPS-CYCLE-001 only (required there): the one declared cli or http edge, leaving the subject, that the exception excuses. It covers the one cycle that edge closes (the cycle that goes away without it); DEPS-EXC-005 when the edge isn't declared or doesn't leave the subject, DEPS-EXC-002 when it closes no cycle or more than one."
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "recorded": {
          "$ref": "#/$defs/date"
        },
        "expires": {
          "$ref": "#/$defs/date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rule": {
                "const": "DEPS-CYCLE-001"
              }
            }
          },
          "then": {
            "required": [
              "excuses"
            ]
          }
        },
        {
          "if": {
            "required": [
              "excuses"
            ]
          },
          "then": {
            "properties": {
              "rule": {
                "const": "DEPS-CYCLE-001"
              }
            }
          }
        }
      ]
    }
  }
}
