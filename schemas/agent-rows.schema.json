{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workflow.local/schemas/agent-rows.schema.json",
  "title": "Agents rows",
  "description": "The Agents list as the wire carries it (Agents page spec 2026-11-12-sindri-agents-page-design.md section 3.1, 3.2 and 8; phase A0): the rows in page order and the sources that could not be read in full. Core types AgentRowList, AgentRow and AgentReason in Aw.Sindri.Core.Sessions; the API goldens at tests/Aw.Sindri.Tests/Golden/Api/agents-rows are examples. Validate with Ajv2020.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows", "degraded"],
  "properties": {
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "degraded": { "type": "array", "items": { "$ref": "#/$defs/degraded" } }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "stateSource": { "enum": ["hook", "record", "transcript", "aw-meta", "engine"] },
    "degraded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "enum": ["lanes-unavailable", "source-stale", "heavy-waits-unreadable", "behind", "unmatched-sender"] },
        "detail": { "type": "string" }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "kind", "word", "text", "since", "source"],
      "properties": {
        "class": { "type": "integer", "minimum": 1, "maximum": 7, "description": "1 asking (Needs you), 2 usage limit (Waiting), 3 lane with no session, 4 at the recycle mark, 5 idle with work owed, 6 slot wait (Waiting), 7 PR ready." },
        "kind": { "enum": ["permission-prompt", "owner-question", "login", "usage-limit", "lane-no-session", "recycle-mark", "idle-owed", "slot-wait", "pr-ready"] },
        "word": { "type": "string", "minLength": 1, "maxLength": 23, "description": "The chip word. The chip is 160 px, so the longest word is 23 characters (spec section 3.2, Fit)." },
        "text": { "type": "string", "minLength": 1, "description": "The words on the row." },
        "since": { "$ref": "#/$defs/timestamp", "description": "When the row first held this reason, from the source and not the poll." },
        "source": { "$ref": "#/$defs/stateSource" }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "repo", "branch", "workRef", "contextTokens", "contextAtMark", "heavySlot"],
      "properties": {
        "lane": { "type": ["string", "null"] },
        "repo": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "workRef": { "type": ["string", "null"], "description": "The PR or issue the session works on, such as PR #3078." },
        "contextTokens": { "type": ["integer", "null"], "minimum": 0 },
        "contextAtMark": { "type": "boolean" },
        "heavySlot": { "type": ["string", "null"], "description": "The heavy slot the row holds or waits for, such as 3 of 3." }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "state", "stateSource", "stateReadAt", "estimated", "title", "facts", "reasons", "parent", "since", "lastActivity", "blocks", "actions", "links"],
      "properties": {
        "id": { "type": "string", "pattern": "^(session:[a-z][a-z0-9-]{1,31}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}|job:[0-9]+|lane:[^/]+/[^/]+)$", "description": "session:<provider>/<id>, job:<pid> or lane:<team>/<lane>. Matches Home's ids." },
        "version": { "type": "integer", "minimum": 1, "description": "Starts at 1 and rises by 1 per change; a steer names the version it read (SND-AGENT-002)." },
        "state": { "enum": ["working", "waiting-on-you", "idle", "limited", "down"] },
        "stateSource": { "$ref": "#/$defs/stateSource" },
        "stateReadAt": { "$ref": "#/$defs/timestamp" },
        "estimated": { "type": "boolean", "description": "True when the state is a guess from the transcript's age." },
        "title": { "type": "string", "minLength": 1 },
        "facts": { "$ref": "#/$defs/facts" },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/reason" }, "description": "Lowest class first; the first is the primary." },
        "parent": { "type": ["string", "null"], "description": "The lead's row id, for a builder." },
        "since": { "$ref": "#/$defs/timestamp" },
        "lastActivity": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "blocks": { "type": ["integer", "null"], "minimum": 0, "description": "Home's blocks N for the row, when Home's rank exists. Display only." },
        "actions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z-]*$" }, "description": "Op ids that apply (spec section 5); the first is the primary." },
        "links": { "type": "array", "items": { "type": "string", "pattern": "^(home|pr|issue|run|node|launch):.+$" } }
      }
    }
  }
}
