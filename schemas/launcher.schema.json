{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workflow.local/schemas/launcher.schema.json",
  "title": "launcher.json",
  "description": "The machine-wide Sindri session launcher file at $AW_STATE_DIR/launcher.json (spec 2026-10-15-sindri-session-launcher-design.md section 4). One contract for the C# reader (AwJson) and the bash reader (aw-meta-launch). Unknown keys are errors. The x-aw-keys block is read by the bash reader for its key lists and placeholder set; it is an unknown keyword to JSON Schema 2020-12, so validate with Ajv2020 and strict: false.",
  "x-aw-keys": {
    "root": [
      "schema",
      "viewer",
      "host",
      "agents",
      "meta",
      "sessions"
    ],
    "viewer": [
      "kind",
      "name",
      "argv"
    ],
    "viewerKinds": [
      "warp",
      "exec-template",
      "print",
      "default-terminal"
    ],
    "host": [
      "kind"
    ],
    "hostKinds": [
      "tmux",
      "none",
      "t3"
    ],
    "agent": [
      "override",
      "label",
      "bin",
      "open",
      "resume",
      "sessionId",
      "sessionIdPattern",
      "reportedId",
      "processName",
      "transcripts",
      "usage",
      "mcp",
      "model",
      "policy"
    ],
    "sessionIdModes": [
      "pre-chosen-uuid",
      "reported",
      "none"
    ],
    "reportedId": [
      "hook",
      "newestFile",
      "capture"
    ],
    "usageReaders": [
      "claude-code",
      "codex",
      "cursor",
      "none"
    ],
    "mcpForms": [
      "claude-config-file",
      "codex-overrides",
      "none"
    ],
    "modelForms": [
      "claude-flag",
      "codex-flag",
      "cursor-flag",
      "none"
    ],
    "policyForms": [
      "claude-settings-file",
      "codex-overrides",
      "cursor-config",
      "none"
    ],
    "meta": [
      "lanesAgent",
      "lanes"
    ],
    "builtinAgents": [
      "claude-code",
      "codex",
      "cursor"
    ],
    "agentIdPattern": "^[a-z][a-z0-9-]{1,31}$",
    "placeholders": [
      "{bin}",
      "{cwd}",
      "{title}",
      "{name}",
      "{seed}",
      "{sessionId}",
      "{mcpConfig}",
      "{cmd...}"
    ],
    "splicePlaceholder": "{cmd...}",
    "sessions": [
      "enabled",
      "pollSeconds",
      "providers",
      "tmuxSockets",
      "scope",
      "claudeSessionsDir"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": 1,
      "description": "The file format version."
    },
    "viewer": {
      "$ref": "#/$defs/viewer"
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "agents": {
      "description": "Entries merged over the built-in claude-code, codex and cursor entries. A built-in id needs \"override\": true; any other id adds an entry, which carries no \"override\": true and names label, bin, open and sessionId.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/agentId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent",
        "properties": {
          "override": {
            "const": false
          }
        }
      },
      "properties": {
        "claude-code": {
          "allOf": [
            {
              "$ref": "#/$defs/builtinOverride"
            },
            {
              "if": {
                "properties": {
                  "sessionId": {
                    "const": "reported"
                  }
                },
                "required": [
                  "sessionId"
                ]
              },
              "then": {
                "required": [
                  "reportedId"
                ],
                "properties": {
                  "reportedId": {
                    "type": "object"
                  }
                }
              }
            }
          ],
          "description": "The built-in has no reportedId, so an override that sets sessionId: reported must bring one."
        },
        "codex": {
          "allOf": [
            {
              "$ref": "#/$defs/builtinOverride"
            },
            {
              "if": {
                "properties": {
                  "reportedId": {
                    "type": "null"
                  }
                },
                "required": [
                  "reportedId"
                ]
              },
              "then": {
                "required": [
                  "sessionId"
                ],
                "properties": {
                  "sessionId": {
                    "enum": [
                      "pre-chosen-uuid",
                      "none"
                    ]
                  }
                }
              }
            }
          ],
          "description": "The built-in is sessionId: reported with a reportedId, so an override that nulls reportedId must move sessionId off reported."
        },
        "cursor": {
          "allOf": [
            {
              "$ref": "#/$defs/builtinOverride"
            },
            {
              "if": {
                "properties": {
                  "reportedId": {
                    "type": "null"
                  }
                },
                "required": [
                  "reportedId"
                ]
              },
              "then": {
                "required": [
                  "sessionId"
                ],
                "properties": {
                  "sessionId": {
                    "enum": [
                      "pre-chosen-uuid",
                      "none"
                    ]
                  }
                }
              }
            }
          ],
          "description": "The built-in is sessionId: reported with a reportedId, so an override that nulls reportedId must move sessionId off reported."
        }
      }
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sessions": {
      "$ref": "#/$defs/sessions"
    }
  },
  "$defs": {
    "agentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "argvElement": {
      "description": "One argument template. Placeholders are a closed set; {cmd...} is spliced as separate arguments, so it is the whole element; every other placeholder may sit inside an argument.",
      "type": "string",
      "anyOf": [
        {
          "const": "{cmd...}"
        },
        {
          "pattern": "^(?:[^{}]|\\{(?:bin|cwd|title|name|seed|sessionId|mcpConfig)\\})*$"
        }
      ]
    },
    "viewer": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "warp",
            "exec-template",
            "print",
            "default-terminal"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "warp"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "print"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "default-terminal"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "exec-template"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "The label the UI shows (\"Sent to kitty\")."
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/argvElement"
              }
            }
          },
          "required": [
            "kind",
            "name",
            "argv"
          ],
          "additionalProperties": false
        }
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "tmux",
            "none",
            "t3"
          ]
        }
      }
    },
    "reportedId": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hook": {
          "type": "boolean"
        },
        "newestFile": {
          "type": [
            "string",
            "null"
          ]
        },
        "capture": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "agent": {
      "description": "An added entry (full) or an override of a built-in one (\"override\": true, only the fields it names).",
      "type": "object",
      "properties": {
        "override": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "bin": {
          "type": "string",
          "minLength": 1
        },
        "open": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/argvElement"
          }
        },
        "resume": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/argvElement"
          },
          "description": "Absent means null (no resume argv; the argvHash default)."
        },
        "sessionId": {
          "enum": [
            "pre-chosen-uuid",
            "reported",
            "none"
          ]
        },
        "sessionIdPattern": {
          "description": "A regular expression the whole session id must match: Sindri anchors it at both ends (\\A(?:pattern)\\z), so 'ses_[a-z0-9]{8}' does not accept 'xses_12345678y'. Run non-backtracking with a 100 ms timeout; a pattern that doesn't compile matches nothing.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reportedId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reportedId"
            }
          ]
        },
        "processName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "transcripts": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "usage": {
          "enum": [
            "claude-code",
            "codex",
            "cursor",
            "none"
          ]
        },
        "mcp": {
          "enum": [
            "claude-config-file",
            "codex-overrides",
            "none"
          ],
          "description": "Absent means \"none\" (the argvHash default)."
        },
        "model": {
          "enum": [
            "claude-flag",
            "codex-flag",
            "cursor-flag",
            "none"
          ],
          "description": "Decided (owner, 2026-10-16). The built-in form that passes a per-run model id (cursor-flag is reserved and parks with SND-LAUNCH-013 until verified) on an unattended Step launch only (scoping-station spec L-17). Absent means \"none\" (the argvHash default). The form name is an argvHash input; the model id is not. The bash reader accepts the key and never applies it."
        },
        "policy": {
          "enum": [
            "claude-settings-file",
            "codex-overrides",
            "cursor-config",
            "none"
          ],
          "description": "Decided (owner, 2026-10-16). The built-in form that passes a per-launch policy (a file for claude-settings-file; typed -c overrides, no file, for codex-overrides; cursor-config is reserved and parks with SND-LAUNCH-013 until verified) on an unattended Step launch only (scoping-station spec L-17). Absent means \"none\" (the argvHash default). The form name is an argvHash input; the policy path is not. The bash reader accepts the key and never applies it."
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "override": {
            "const": true
          }
        },
        "required": [
          "override"
        ]
      },
      "then": {},
      "else": {
        "required": [
          "label",
          "bin",
          "open",
          "sessionId"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "sessionId": {
                  "enum": [
                    "pre-chosen-uuid",
                    "reported"
                  ]
                }
              },
              "required": [
                "sessionId"
              ]
            },
            "then": {
              "required": [
                "sessionIdPattern"
              ],
              "properties": {
                "sessionIdPattern": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "sessionId": {
                  "const": "reported"
                }
              },
              "required": [
                "sessionId"
              ]
            },
            "then": {
              "required": [
                "reportedId"
              ],
              "properties": {
                "reportedId": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    },
    "builtinOverride": {
      "description": "A built-in id is replaced only with \"override\": true (SND-LAUNCH-011 otherwise). Every built-in has a sessionIdPattern, so an override may set it to null only together with \"sessionId\": \"none\" (section 4: the pattern is required unless sessionId is none).",
      "$ref": "#/$defs/agent",
      "required": [
        "override"
      ],
      "properties": {
        "override": {
          "const": true
        }
      },
      "if": {
        "properties": {
          "sessionIdPattern": {
            "type": "null"
          }
        },
        "required": [
          "sessionIdPattern"
        ]
      },
      "then": {
        "required": [
          "sessionId"
        ],
        "properties": {
          "sessionId": {
            "const": "none"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lanesAgent": {
          "$ref": "#/$defs/agentId"
        },
        "lanes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/agentId"
          }
        }
      }
    },
    "sessions": {
      "description": "The session collector's settings (spec 2026-10-16-sindri-session-collector-design.md section 9). Optional and additive; the bash reader accepts and ignores it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Default true; false turns the whole collector off (SND-SESSION-002 disabled)."
        },
        "pollSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "Pass cadence; default 2."
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentId"
          },
          "uniqueItems": true,
          "description": "Which catalog agents to discover; default every catalog entry."
        },
        "tmuxSockets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/.+"
          },
          "uniqueItems": true,
          "description": "Extra absolute tmux socket paths to read besides the ones found from processes; default []."
        },
        "scope": {
          "enum": [
            "all",
            "own"
          ],
          "description": "Which sessions discovery lists: all (default) or own, only sessions on Sindri's own tmux sockets and sessions Sindri launched."
        },
        "claudeSessionsDir": {
          "type": "string",
          "pattern": "^/.+",
          "description": "For a relocated Claude config (CLAUDE_CONFIG_DIR); default ~/.claude/sessions."
        }
      }
    },
    "layout": {
      "description": "The team layout aw-meta-launch builds from the team config and hands to the viewer's adapter (`aw-meta-launch --print-layout` prints it; issue 4517, docs/csharp/sindri-launcher.md \"The team layout\"). Not a key of launcher.json: it is derived, never written by hand. One description for every terminal: the Warp adapter turns it into a launch configuration, the others into one window per lane or attach lines.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "team",
        "socket",
        "cwd",
        "arrangement",
        "lanes"
      ],
      "properties": {
        "schema": {
          "const": 1,
          "description": "The layout format version."
        },
        "team": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "The team's name (team.json team)."
        },
        "socket": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "The team's tmux socket name (`tmux -L <socket>`); today always the team's name."
        },
        "cwd": {
          "type": "string",
          "pattern": "^/",
          "description": "The repo every window or pane starts in (team.json repo)."
        },
        "arrangement": {
          "enum": [
            "first-left-rest-stacked"
          ],
          "description": "first-left-rest-stacked: the first lane on the left, the others stacked on the right. An adapter that can only open windows opens one per lane in lane order."
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "description": "Every lane of the team config in order, the meta lane first, then a --lanes lane the config does not name.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lane",
              "session",
              "open",
              "attach",
              "join",
              "shell"
            ],
            "properties": {
              "lane": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "session": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "description": "The lane's tmux session, <team>-<lane>."
              },
              "open": {
                "type": "boolean",
                "description": "The lane is in this run (all lanes, or the --lanes list): window adapters open only these; the Warp adapter has a pane for every lane."
              },
              "attach": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "Attaches to the running session: tmux -L <socket> attach -t =<session> (print, exec-template's {cmd...})."
              },
              "join": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "Attaches, or creates a plain session: tmux -L <socket> new -A -s <session> (default-terminal)."
              },
              "shell": {
                "type": "string",
                "description": "The shell line a pane runs (Warp): attaches, or creates the session running the lane's agent through scripts/meta-lane.sh, with remain-on-exit on."
              }
            }
          }
        }
      }
    }
  }
}
