#!/usr/bin/env bash
# Canned stand-in for ffprobe (system-design-video evals). Answers from a JSON file, first found of:
# $AW_STUB_FFPROBE_JSON, the nearest ./ffprobe.json upward from the cwd (a case's fixture plants its failure here), evals/stubs/ffprobe.json.
# Refuses a file that does not exist, like the real tool. Exits 1 on a call shape the skill's scripts don't make.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cfg="${AW_STUB_FFPROBE_JSON:-}"
[ -n "$cfg" ] && [ -f "$cfg" ] || { cfg=""; d="$PWD"; while [ "$d" != "/" ]; do [ -f "$d/ffprobe.json" ] && { cfg="$d/ffprobe.json"; break; }; d="$(dirname "$d")"; done; }
[ -n "$cfg" ] && [ -f "$cfg" ] || cfg="$here/../ffprobe.json"
[ -f "$cfg" ] || { echo "ffprobe stub: no answer file" >&2; exit 1; }
val() { sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" "$cfg" | head -1; }
args="$*"
file="${!#}"
[ -f "$file" ] || { echo "$file: No such file or directory" >&2; exit 1; }
case "$args" in
  *"format=duration"*"csv=p=0"*) val duration ;;
  *"stream=codec_name,width,height"*"compact=p=0"*)
    echo "stream|codec_name=$(val codec_name)|width=$(val width)|height=$(val height)|r_frame_rate=$(val r_frame_rate)|color_space=$(val color_space)|color_primaries=$(val color_primaries)|color_transfer=$(val color_transfer)|color_range=$(val color_range)"
    echo "format|duration=$(val duration)" ;;
  *"stream=codec_name,profile,level,has_b_frames,pix_fmt"*)
    printf 'codec_name=%s\nprofile=%s\nlevel=%s\nhas_b_frames=%s\npix_fmt=%s\n' \
      "$(val codec_name)" "$(val profile)" "$(val level)" "$(val has_b_frames)" "$(val pix_fmt)" ;;
  *) echo "ffprobe stub: unknown call: $args" >&2; exit 1 ;;
esac
