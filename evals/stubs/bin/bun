#!/usr/bin/env bash
# Behaviour and shapes: ../README.md, "system-design-video".
av_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; media="$av_here/../media"
. "$av_here/../av-lib.sh"
beat_secs=23
ids_of() { grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' "$1" | sed 's/.*"\([^"]*\)"$/\1/'; }
case "${1:-}" in
  --version) echo "1.2.19"; exit 0 ;;
  -e)
    [ -f layout.json ] || { echo "error: ENOENT: no such file or directory, open '$PWD/layout.json'" >&2; exit 1; }
    i=0
    for id in $(ids_of layout.json); do
      printf '%02d %s %d.70\n' "$i" "$id" "$((i * beat_secs + 18))"; i=$((i + 1))
    done
    exit 0 ;;
  *render.ts) ;;
  *) echo "error: Script not found \"${1:-}\"" >&2; exit 1 ;;
esac
usage="usage: bun render.ts <storyboard.json> <out-dir> --tokens <design-tokens.json> [--fps 30] [--still t1,t2] [--range a..b]"
sb="${2:-}"; out="${3:-}"
[ -n "$sb" ] && [ -n "$out" ] || { echo "$usage" >&2; exit 1; }
shift 3
tokens=""; still=""; fps=30
while [ $# -gt 0 ]; do case "$1" in --tokens) tokens="${2:-}"; shift 2 ;; --still) still="${2:-}"; shift 2 ;; --fps) fps="${2:-30}"; shift 2 ;; --range) shift 2 ;; *) shift ;; esac; done
[ -f "$sb" ] || { echo "error: ENOENT: no such file or directory, open '$sb'" >&2; exit 1; }
[ -n "$tokens" ] || { echo "$usage" >&2; exit 1; }
[ -f "$tokens" ] || { echo "error: ENOENT: no such file or directory, open '$tokens'" >&2; exit 1; }
mkdir -p "$out" || exit 1
mapfile -t hexes < <(grep -o '#[0-9a-fA-F]\{6\}' "$tokens")
mapfile -t ids < <(ids_of "$sb")
n=${#ids[@]}; total=$((n * beat_secs))
printf '{\n  "board": "%s",\n  "chalk": "%s",\n  "primary": "%s"\n}\n' "${hexes[0]:-#0d1117}" "${hexes[1]:-#e6edf3}" "${hexes[2]:-#58a6ff}" > "$out/resolved-inks.json"
{
  printf '{\n  "total": %d,\n  "beats": [\n' "$total"
  for ((i = 0; i < n; i++)); do
    s=$((i * beat_secs))
    printf '    { "id": "%s", "start": %d, "land": %d, "settle": %d.5, "end": %d }%s\n' "${ids[i]}" "$s" "$((s + 18))" "$((s + 18))" "$((s + beat_secs))" "$([ $i -lt $((n - 1)) ] && echo ,)"
  done
  printf '  ]\n}\n'
} > "$out/layout.json"
if [ -n "$still" ]; then
  mkdir -p "$out/stills"
  IFS=',' read -r -a ts <<< "$still"
  for t in "${ts[@]}"; do
    k=$(awk -v t="$t" -v b="$beat_secs" -v n="$n" 'BEGIN { k = int(t / b); if (k >= n) k = n - 1; if (k < 0) k = 0; print k }')
    src="$media/${ids[k]}.png"; [ -f "$src" ] || src="$media/model.png"
    cp "$src" "$out/stills/t$(awk -v t="$t" 'BEGIN { printf "%.1f", t }').png"
  done
  echo "stills in $out/stills; total $total.00s"
  exit 0
fi
av_write_mp4 "$out/footage.mp4" 2400000 "$(av_json "$(av_answers)")"
echo "footage.mp4: $((total * fps)) frames @${fps}fps, $total.00s; beats: $n"
