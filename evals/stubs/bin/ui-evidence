#!/usr/bin/env bash
# Canned stand-in for the Sindri `ui-evidence` binary (not present in an isolated eval run).
# It answers just enough for the skill to proceed, and refuses a non-local --host like the real guard.
# Put its directory first on PATH when launching `claude plugin eval` (PATH is passed through to runs).
cmd="${1:-}"; shift || true
host=""
while [ $# -gt 0 ]; do case "$1" in --host) host="${2:-}"; shift 2;; *) shift;; esac; done
if [ -n "$host" ] && [ "${host#http://localhost:}" = "$host" ]; then
  echo "ui-evidence: host refused: $host is not a configured local host" >&2
  exit 1
fi
case "$cmd" in
  doctor) echo '{"healthy":true,"foreign":false,"host":"http://localhost:3000","slot":null}';;
  provenance) echo '{"provenance":"seeded","reason":"database holds only seeded rows"}';;
  install-browser) echo '{"installed":true}';;
  run|parity|api-run|db-run) echo '{"ok":true,"steps":[{"name":"open settings","status":"passed"}],"visual":{"verdict":"unchanged","how":"pixel-compare"},"screenshots":["settings-1.png"]}';;
  publish-plan) echo '{"plan":"text-only comment"}';;
  *) echo '{}';;
esac
