{
  "name": "@agentic-workflow/sindri",
  "version": "0.1.0",
  "description": "Sindri: always-on local agent-work harness (core package)",
  "type": "module",
  "bin": {
    "sindri": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "gen": "npm run build && node dist/gen.js",
    "test": "vitest run",
    "test:heavy": "SINDRI_HEAVY=1 vitest run tests/heavy",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "typescript": "^7.0.2",
    "yaml": "^2.8.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "sindri": {
    "graphifyPin": "0.9.67",
    "graphifyPinDate": "2026-09-24T00:00:00Z"
  }
}
