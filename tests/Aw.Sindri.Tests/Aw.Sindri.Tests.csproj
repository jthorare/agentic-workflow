<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Sindri.Tests (scaffolded by /new-package): by feature, one Lane trait per test (spec §4b.5). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aw.Sindri.Tests</RootNamespace>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <!-- why: 12,500 short tests never reach the tier PGO's instrumentation pays for; off, the unit lane spends ~9% less CPU (#1546). -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Core/Aw.Sindri.Core.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Features/Aw.Sindri.Features.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Infrastructure/Aw.Sindri.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Host/Aw.Sindri.Host.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Workflows/Aw.Sindri.Workflows.csproj" />
    <!-- Forge/: ForgePullRequests over the forge package's file-backed adapter -->
    <ProjectReference Include="../../src/Forge/Aw.Forge.Core/Aw.Forge.Core.csproj" />
    <ProjectReference Include="../Aw.Sindri.Testing/Aw.Sindri.Testing.csproj" />
    <ProjectReference Include="../Aw.Embeddings.Testing/Aw.Embeddings.Testing.csproj" />
    <ProjectReference Include="../Aw.Context.Testing/Aw.Context.Testing.csproj" />
    <ProjectReference Include="../Aw.Connectors.Testing/Aw.Connectors.Testing.csproj" />
    <ProjectReference Include="../Aw.CodeIndex.Testing/Aw.CodeIndex.Testing.csproj" />
    <ProjectReference Include="../Aw.Kernel.Telemetry.Testing/Aw.Kernel.Telemetry.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build order only: the real-binary tests (BugFix/RealBugFixState, Packets/RealAwPackets, ...) run the built bugfix-state and aw-packets from artifacts/bin, so a scoped build of this project builds them too (#1128). -->
    <ProjectReference Include="../../src/Packets/Aw.Packets.App/Aw.Packets.App.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/BugFix/Aw.BugFix.Host/Aw.BugFix.Host.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.CodeRunner/Aw.Sindri.CodeRunner.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 8 parallel test classes: most of the lane is spent waiting on Temporal servers, not on CPU (the TemporalServerFixture start retries a lost port). -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Helpers the suites moved to Aw.Sindri.Engine.Tests still share with this project, compiled into both. -->
    <Compile Include="../Aw.Sindri.Engine.Tests/Workflows/PinnedTemporal.cs" Link="Shared/Workflows/PinnedTemporal.cs" />
    <Compile Include="../Aw.Sindri.Engine.Tests/Workflows/Spike/ServerGuard.cs" Link="Shared/Workflows/Spike/ServerGuard.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Sandbox/Denials/Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Workflow/ModelCheck/Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden files (Aw.Kernel.Testing Golden) live in this project's source tree (the recipe goldens, and the API goldens of API P1 unit E); AW_GOLDEN_UPDATE=1 rewrites them there. -->
    <AssemblyMetadata Include="AwGoldenSourceRoot" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>
</Project>
