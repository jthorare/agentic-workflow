<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Sindri.Testing (scaffolded by /new-package): builders, in-memory fakes and contract bases for Sindri's
       ports (spec §4b.5). Test support: only *.Tests and *.Testing projects reference it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Sindri.Testing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Core/Aw.Sindri.Core.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Features/Aw.Sindri.Features.csproj" />
    <!-- ToolRunnerContract binds the internal IToolRunner seam (Infrastructure grants this project its internals). -->
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Infrastructure/Aw.Sindri.Infrastructure.csproj" />
    <ProjectReference Include="../Aw.Kernel.Testing/Aw.Kernel.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- ToolRunnerContract's binding hook names the internal IToolRunner, so the bindings in Aw.Sindri.Tests override it. -->
    <InternalsVisibleTo Include="Aw.Sindri.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recipe fixtures (spec §9.1: each rule has an invalid fixture), read by RecipeFixtures without file I/O. -->
    <EmbeddedResource Include="Workflow/Recipes/**/*.yaml" LogicalName="recipes/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Workflow/Histories/*.json" LogicalName="histories/%(Filename)%(Extension)" />
    <!-- The shipped recipes, their evals and the dev profile (spec §12), read by ShippedRecipes without file I/O. -->
    <EmbeddedResource Include="../../recipes/**/*.yaml;../../recipes/**/*.jsonl" LogicalName="shipped/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The scoping station's gold facts (SC-K), read by ScopingFacts without file I/O. -->
    <EmbeddedResource Include="../fixtures/scoping/facts/**/*.json" LogicalName="scoping-facts/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The context engine's view JSON the gather, anchor and propose desk blocks read (SC-K2). -->
    <EmbeddedResource Include="../fixtures/scoping/views/*.json" LogicalName="scoping-views/%(Filename)%(Extension)" />
    <!-- The line fixture's gold scope, design and plan packets, its packs and the one repo file a contract edit quotes (LN-K), read by LineFacts without file I/O. -->
    <EmbeddedResource Include="../fixtures/line/gold/design/expiry/*" LogicalName="line-gold/design/expiry/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../fixtures/line/gold/design/expiry.formal.spec.md" LogicalName="line-gold/design/expiry.formal.spec.md" />
    <EmbeddedResource Include="../fixtures/line/gold/plan/expiry/*" LogicalName="line-gold/plan/expiry/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../fixtures/line/gold/scope/expiry/*" LogicalName="line-gold/scope/expiry/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../fixtures/line/packs/style/**/pack.json" LogicalName="line-packs/style/%(RecursiveDir)pack.json" />
    <EmbeddedResource Include="../fixtures/line/packs/lenses/**/pack.json" LogicalName="line-packs/lenses/%(RecursiveDir)pack.json" />
    <EmbeddedResource Include="../../schemas/line/examples/design.*.json" LogicalName="line-schemas/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../fixtures/scoping/repo/docs/decisions/*.md" LogicalName="line-repo/docs/decisions/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
