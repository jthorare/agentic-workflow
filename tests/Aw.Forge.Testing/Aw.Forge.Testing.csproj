<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Forge.Testing (scaffolded by /new-package): builders, in-memory fakes and contract bases for Forge's
       ports (spec §4b.5). Test support: only *.Tests and *.Testing projects reference it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Forge.Testing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- [Fact] for the contract bases; like Aw.Kernel.Testing they throw ContractViolationException, not Assert. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Forge/Aw.Forge.Core/Aw.Forge.Core.csproj" />
    <ProjectReference Include="../../src/Forge/Aw.Forge.Infrastructure/Aw.Forge.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Redaction/Aw.Redaction/Aw.Redaction.csproj" />
    <ProjectReference Include="../Aw.Kernel.Testing/Aw.Kernel.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FakeForge and FileForgeUnderTest derive from Infrastructure's internal WorldForge. -->
    <InternalsVisibleTo Include="Aw.Forge.Tests" />
  </ItemGroup>
</Project>
