<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Sindri.Toolkit.Tests: the toolkit SDK's tests, by feature, one Lane trait per test (spec §4b.5). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aw.Sindri.Toolkit.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Toolkit/Aw.Sindri.Toolkit/Aw.Sindri.Toolkit.csproj" />
    <ProjectReference Include="../Aw.Kernel.Testing/Aw.Kernel.Testing.csproj" />
    <ProjectReference Include="../Aw.Sindri.Toolkit.Testing/Aw.Sindri.Toolkit.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden files (Aw.Kernel.Testing Golden) live in this project's source tree. -->
    <AssemblyMetadata Include="AwGoldenSourceRoot" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>
</Project>
