<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Context.Testing (stage S-FX): the split-panes fixture app with its recorded Linear source, the
       builder that makes the app a git repo with merged-PR history, the probe file, and fake Linear (GraphQL)
       server that replays the recordings on loopback (spec 2026-10-10 §10). Test support: only *.Tests
       and *.Testing projects reference it. S-1A added Engine/: one fake and one contract base per Context
       port (FakeContextEngine, FakeContextSource, FakeDocIndex, FakeScrubber, FixedSourceCatalog, FakeChangeFeed,
       FakeModelPort; ContextEngineContract, ContextSourceContract, DocIndexContract, ScrubberContract,
       SourceCatalogContract, ChangeFeedContract, ModelPortContract). S-3a adds Map/: the hand-authored product map and the fakes and contract
       bases of the map ports (FakeGraphStore, FakeExportStore, FakeMapFileReader). Everything here is synthetic. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Context.Testing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel for the fake servers (loopback only). A shared framework, not a NuGet package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The map ports' contract bases (Fact, TestContext); they throw ContractViolationException instead of Assert,
         as Aw.Kernel.Testing's do. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../src/Context/Aw.Context.Core/Aw.Context.Core.csproj" />
    <ProjectReference Include="../Aw.Kernel.Testing/Aw.Kernel.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fakes' shared host (LoopbackServer) is internal; its own tests reach it here. -->
    <InternalsVisibleTo Include="Aw.Context.Testing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixture travels inside the assembly, so a test in any project reads it without file paths. -->
    <EmbeddedResource Include="Fixtures/split-panes/**/*" LogicalName="split-panes/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The tabs map (S-4): a conflict, a suggested file link and an orphaned override, read by the lenses and file-map tests and imported at the head of MapTabsRepo. -->
    <EmbeddedResource Include="Fixtures/map-tabs.json" LogicalName="map-tabs.json" />
  </ItemGroup>
</Project>
