<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Judge.Testing (scaffolded by /new-package): builders, in-memory fakes and contract bases for Judge's
       ports (spec §4b.5). Test support: only *.Tests and *.Testing projects reference it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Judge.Testing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- [Fact] for the contract bases; like Aw.Kernel.Testing they throw ContractViolationException, not Assert. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Judge/Aw.Judge.Core/Aw.Judge.Core.csproj" />
    <ProjectReference Include="../../src/Judge/Aw.Judge.Features/Aw.Judge.Features.csproj" />
    <ProjectReference Include="../Aw.Kernel.Testing/Aw.Kernel.Testing.csproj" />
  </ItemGroup>
</Project>
