{
  "openapi": "3.0.0",
  "info": { "title": "Orders API", "version": "2" },
  "paths": {
    "/orders/{id}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "type": "object", "required": ["id", "total", "currency"], "properties": { "id": { "type": "string" }, "total": { "type": "number" }, "currency": { "type": "string" } } }
              }
            }
          }
        }
      }
    }
  }
}
