<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Kernel.Testing: tier 0 (deps.yaml KernelTesting), referenced by test projects only (spec §4b.1, §4b.5).
       Deterministic ids, lane traits, the builder base, generic contract-test bases (ReadRepository, UnitOfWork, Outbox, IdGenerator) with
       the Kernel ports' in-memory fakes, the golden-file check and the CTRF per-test lane cap (LaneCap; CLI: tests/Aw.LaneCap.Testing).
       It lives under tests/, so the test-project analyzer policy (tests/.editorconfig) applies, as for every *.Testing.
       Aw.Kernel plus ONE external dependency: xunit.v3.extensibility.core (Fact, Trait, ITraitAttribute, TestContext),
       the same exact version the xunit.v3 package pins. The contract bases throw ContractViolationException instead
       of using Assert, so xunit.v3.assert stays out: don't add Assert here, it would be a second dependency.
       FakeTimeProvider comes from Microsoft.Extensions.TimeProvider.Testing in the test projects (see KnownInstants). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Kernel.Testing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Kernel.Testing.Tests" />
  </ItemGroup>
</Project>
