  <ItemGroup>
    <!-- The registry test reads the solution file from the source tree. -->
    <AssemblyMetadata Include="AwRepoRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))" />
  </ItemGroup>
</Project>
