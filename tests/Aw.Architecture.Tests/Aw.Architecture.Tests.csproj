<Project Sdk="Microsoft.NET.Sdk">
  <!-- The architecture tests (spec §4b.1, §4b.5): every §4b.1 rule over every Aw.* production assembly registered
       in Packages.cs, plus the typed-id guard (docs/csharp/typed-ids.md). Fixtures that break each rule live in this
       assembly under Fixtures/ (a separate fixtures project would be a leaf nothing may reference, DEPS-PROJ-003).
       No package owns this assembly, so it may reference every package (deps.yaml "C# names"). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aw.Architecture.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="TngTech.ArchUnitNET" />
    <!-- Example ids for the typed-id guard's fixtures (decision R9). -->
    <PackageReference Include="Vogen" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Every production assembly in Packages.cs is referenced here, so it lands in the output and loads by name.
       /new-package adds one ProjectReference per new production project next to its Packages.cs line. -->
  <ItemGroup Label="Registered packages">
    <ProjectReference Include="../../src/Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../src/Aw.Kernel.Data/Aw.Kernel.Data.csproj" />
    <ProjectReference Include="../../src/Aw.Kernel.Telemetry/Aw.Kernel.Telemetry.csproj" />
    <ProjectReference Include="../../src/Packets/Aw.Packets.Core/Aw.Packets.Core.csproj" />
    <ProjectReference Include="../../src/Packets/Aw.Packets.App/Aw.Packets.App.csproj" />
    <ProjectReference Include="../../src/Readiness/Aw.Readiness.Core/Aw.Readiness.Core.csproj" />
    <ProjectReference Include="../../src/Readiness/Aw.Readiness.App/Aw.Readiness.App.csproj" />
    <ProjectReference Include="../../src/Redaction/Aw.Redaction/Aw.Redaction.csproj" />
    <ProjectReference Include="../../src/Judge/Aw.Judge.Core/Aw.Judge.Core.csproj" />
    <ProjectReference Include="../../src/Judge/Aw.Judge.Features/Aw.Judge.Features.csproj" />
    <ProjectReference Include="../../src/Judge/Aw.Judge.Infrastructure/Aw.Judge.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Judge/Aw.Judge.Host/Aw.Judge.Host.csproj" />
    <ProjectReference Include="../../src/Evidence/Aw.Evidence.Core/Aw.Evidence.Core.csproj" />
    <ProjectReference Include="../../src/Evidence/Aw.Evidence.Features/Aw.Evidence.Features.csproj" />
    <ProjectReference Include="../../src/Evidence/Aw.Evidence.Infrastructure/Aw.Evidence.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Evidence/Aw.Evidence.Host/Aw.Evidence.Host.csproj" />
    <ProjectReference Include="../../src/BugFix/Aw.BugFix.Core/Aw.BugFix.Core.csproj" />
    <ProjectReference Include="../../src/BugFix/Aw.BugFix.Features/Aw.BugFix.Features.csproj" />
    <ProjectReference Include="../../src/BugFix/Aw.BugFix.Infrastructure/Aw.BugFix.Infrastructure.csproj" />
    <ProjectReference Include="../../src/BugFix/Aw.BugFix.Host/Aw.BugFix.Host.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Core/Aw.Sindri.Core.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Features/Aw.Sindri.Features.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Infrastructure/Aw.Sindri.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Host/Aw.Sindri.Host.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Ui/Aw.Sindri.Ui.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Ui.Desktop/Aw.Sindri.Ui.Desktop.csproj" />
    <ProjectReference Include="../../src/Context/Aw.Context.Core/Aw.Context.Core.csproj" />
    <ProjectReference Include="../../src/Context/Aw.Context.Features/Aw.Context.Features.csproj" />
    <ProjectReference Include="../../src/Context/Aw.Context.Infrastructure/Aw.Context.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Sindri/Aw.Sindri.Workflows/Aw.Sindri.Workflows.csproj" />
    <ProjectReference Include="../../src/Meta/Aw.Meta.Core/Aw.Meta.Core.csproj" />
    <ProjectReference Include="../../src/Meta/Aw.Meta.Features/Aw.Meta.Features.csproj" />
    <ProjectReference Include="../../src/Meta/Aw.Meta.Infrastructure/Aw.Meta.Infrastructure.csproj" />
